  "recommendationRules": {
    "recommendedCount": 3,
    "primaryMattressRules": [
      {
        "when": { "motionKey": ["half_split", "full_split"] },
        "pickHandle": "12-dual-comfort-hybrid",
        "reasonKey": "split_requires_dual"
      },
      {
        "when": { "firmness": ["firm"] },
        "pickHandle": "14-hybrid",
        "reasonKey": "firmness_prefers_hybrid"
      },
      {
        "when": { "position": ["back", "stomach"] },
        "pickHandle": "14-hybrid",
        "reasonKey": "back_or_stomach_support"
      },
      {
        "when": { "position": ["side"] },
        "pickHandle": "12-all-foam-mattress",
        "reasonKey": "side_pressure_relief"
      },
      {
        "defaultHandle": "14-hybrid",
        "reasonKey": "default_support"
      }
    ],
    "baseRules": [
      {
        "when": { "motionKey": ["standard", "half_split", "full_split"] },
        "pickHandle": "premium-motion-adjustable-base",
        "reasonKey": "motion_requires_adjustable"
      },
      {
        "when": { "baseType": ["adjustable"] },
        "pickHandle": "premium-motion-adjustable-base",
        "reasonKey": "requested_adjustable_base"
      },
      {
        "when": { "baseType": ["storage"] },
        "pickHandle": "storage-base",
        "reasonKey": "requested_storage_base"
      },
      {
        "when": { "baseType": ["platform"] },
        "pickHandle": "platform-base",
        "reasonKey": "requested_platform_base"
      },
      {
        "when": { "baseType": ["none"] },
        "pickHandle": null,
        "reasonKey": "requested_no_base"
      }
    ],
    "podScoreBoosts": [
      {
        "reasonKey": "primary_mattress_exact",
        "points": 100,
        "match": { "mattressHandle": "$primaryMattressHandle" }
      },
      {
        "reasonKey": "primary_mattress_family",
        "points": 55,
        "match": { "mattressFamily": "$primaryMattressFamily" }
      },
      {
        "when": { "motionKey": ["full_split"] },
        "reasonKey": "requested_full_split",
        "points": 70,
        "match": { "motionKey": ["full_split"] }
      },
      {
        "when": { "motionKey": ["half_split"] },
        "reasonKey": "requested_half_split",
        "points": 60,
        "match": { "motionKey": ["half_split"] }
      },
      {
        "when": { "motionKey": ["standard"] },
        "reasonKey": "requested_standard_motion",
        "points": 28,
        "match": { "motionKey": ["standard"], "hasAdjustableBase": true }
      },
      {
        "when": { "motionKey": ["half_split", "full_split"] },
        "reasonKey": "split_requires_dual",
        "points": 35,
        "match": { "tagsAny": ["dual_comfort"] }
      },
      {
        "when": { "hasPartner": [true] },
        "reasonKey": "partner_friendly",
        "points": 18,
        "match": { "tagsAny": ["partner_friendly", "adjustable"] }
      },
      {
        "when": { "position": ["side"] },
        "reasonKey": "side_sleeper_pressure_relief",
        "points": 18,
        "match": { "mattressFamily": ["foam"] }
      },
      {
        "when": { "position": ["back", "stomach"] },
        "reasonKey": "back_or_stomach_support",
        "points": 18,
        "match": { "mattressFamily": ["hybrid"] }
      },
      {
        "when": { "firmness": ["firm"] },
        "reasonKey": "firmness_firm_match",
        "points": 12,
        "match": { "mattressFamily": ["hybrid"] }
      },
      {
        "when": { "firmness": ["soft"] },
        "reasonKey": "firmness_soft_match",
        "points": 12,
        "match": { "mattressFamily": ["foam", "dual"] }
      },
      {
        "reasonKey": "fixture_size_match",
        "points": 10,
        "match": { "displayedSize": "$size" }
      },
      {
        "when": { "motionKey": ["none"], "hasPartner": [false] },
        "reasonKey": "simple_non_motion_option",
        "points": 8,
        "match": { "hasAdjustableBase": false, "mattressFamily": ["foam"] }
      }
    ]
  }
}
