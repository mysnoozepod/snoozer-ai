{
  "name": "omnia-journey",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pod:lab": "vite --host 127.0.0.1",
    "pod:measure": "playwright test -c playwright.pod-layout.config.cjs --project=measure",
    "pod:layout:test": "playwright test -c playwright.pod-layout.config.cjs --project=strict",
    "test:welcome-device": "node tests/runWelcomeDevicePolishTests.mjs",
    "test:welcome-device:layout": "npm run build && playwright test -c playwright.welcome-device.config.cjs",
    "rest:test": "node tests/runRestTestProgramTests.mjs",
    "rest:visual:test": "playwright test -c playwright.rest-test.config.cjs",
    "pod:persistence:test": "node tests/runPersistentPodExperienceTests.mjs && playwright test -c playwright.rest-test.config.cjs -g \"persists across every Pod experience tab\"",
    "test:pod-polish": "node tests/runPodExperiencePolishTests.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.542.0",
    "node-fetch": "^3.3.2",
    "phosphor-react": "^1.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/code-frame": "^7.27.1",
    "@babel/core": "^7.27.1",
    "@babel/preset-react": "^7.27.1",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.19",
    "dotenv": "^17.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.20",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
