<fieldset class="snoozepod-tools__fieldset">
  <legend class="snoozepod-tools__legend">Mattress configuration</legend>
  <div class="snoozepod-tools__field"><label for="compat-mattress-size">Mattress size</label><select id="compat-mattress-size" name="mattress_size" required><option value="">Choose a size</option><option>Twin XL</option><option>Full</option><option>Queen</option><option>King</option><option>California King</option><option>Split King</option></select></div>
  <div class="snoozepod-tools__field"><label for="compat-mattress-geometry">Mattress geometry</label><select id="compat-mattress-geometry" name="mattress_geometry" required><option value="standard">Standard</option><option value="split-head">Split Head</option><option value="full-split">Full Split</option><option value="half-split">Half Split</option></select></div>
</fieldset>
<fieldset class="snoozepod-tools__fieldset">
  <legend class="snoozepod-tools__legend">Product being paired</legend>
  <div class="snoozepod-tools__field"><label for="compat-other-size">Base, protector, or sheet size</label><select id="compat-other-size" name="other_size" required><option value="">Choose a size</option><option>Twin XL</option><option>Full</option><option>Queen</option><option>King</option><option>California King</option><option>Split King</option></select></div>
  <div class="snoozepod-tools__field"><label for="compat-other-geometry">Its geometry</label><select id="compat-other-geometry" name="other_geometry" required><option value="standard">Standard</option><option value="split-head">Split Head</option><option value="full-split">Full Split</option><option value="half-split">Half Split</option><option value="unknown">Not shown</option></select></div>
  <div class="snoozepod-tools__field"><label for="compat-kind">Component</label><select id="compat-kind" name="component"><option value="base">Adjustable Base</option><option value="protector">Mattress Protector</option><option value="sheets">Sheets</option><option value="platform">Platform Base</option></select></div>
</fieldset>

