<dialog id="WebsiteAskSnoozer" class="website-snoozer" aria-labelledby="WebsiteAskSnoozerTitle" data-page-type="{{ request.page_type | escape }}" data-product-handle="{{ product.handle | escape }}">
  <header class="website-snoozer__header">
    <button type="button" class="website-snoozer__close" data-website-snoozer-close aria-label="Close Ask Snoozer" autofocus>
      <svg class="website-snoozer__back-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="22" height="22"><path d="M19 12H5m7-7-7 7 7 7"/></svg>
      <svg class="website-snoozer__close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" width="22" height="22"><path d="m6 6 12 12M18 6 6 18"/></svg>
    </button>
    <h2 id="WebsiteAskSnoozerTitle">{% render 'website-ask-snoozer-icon' %} Ask Snoozer</h2>
  </header>

  <div class="website-snoozer__scroll" data-website-snoozer-scroll>
    <div class="website-snoozer__welcome" data-website-snoozer-welcome>
      <p>How can I help you today?</p>
      <div class="website-snoozer__starters">
        <a href="/pages/book-a-snooze-session">Book a Snooze Session <span aria-hidden="true">→</span></a>
        <button type="button" data-website-snoozer-starter="assessment">Find my sleep setup <span aria-hidden="true">→</span></button>
        <button type="button" data-website-snoozer-starter="product">Ask a product question <span aria-hidden="true">→</span></button>
      </div>
    </div>
    <div class="website-snoozer__conversation" role="log" aria-label="Ask Snoozer conversation" data-website-snoozer-conversation></div>
  </div>

  <div class="website-snoozer__compose">
    <p class="website-snoozer__status" role="status" data-website-snoozer-status></p>
    <form class="website-snoozer__form" data-website-snoozer-form>
      <label for="WebsiteAskSnoozerMessage">Message for Snoozer</label>
      <textarea id="WebsiteAskSnoozerMessage" rows="1" maxlength="1000" placeholder="Ask a question" data-website-snoozer-input required></textarea>
      <button type="submit" data-website-snoozer-send>Send</button>
    </form>
  </div>
</dialog>
