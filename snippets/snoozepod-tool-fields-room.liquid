<fieldset class="snoozepod-tools__fieldset">
  <legend class="snoozepod-tools__legend">Planning dimensions</legend>
  <p class="snoozepod-tools__help">These are planning estimates. Confirm exact product and packaged-delivery dimensions before ordering.</p>
  <div class="snoozepod-tools__field"><label for="room-size">Mattress size</label><select id="room-size" name="size" required><option value="">Choose a size</option><option>Twin XL</option><option>Full</option><option>Queen</option><option>King</option><option>California King</option></select></div>
  <div class="snoozepod-tools__field"><label for="room-width">Room width in inches</label><input id="room-width" name="room_width" type="number" min="1" inputmode="decimal" required></div>
  <div class="snoozepod-tools__field"><label for="room-length">Room length in inches</label><input id="room-length" name="room_length" type="number" min="1" inputmode="decimal" required></div>
  <div class="snoozepod-tools__field"><label for="door-width">Narrowest doorway width in inches</label><input id="door-width" name="door_width" type="number" min="1" inputmode="decimal"></div>
</fieldset>

