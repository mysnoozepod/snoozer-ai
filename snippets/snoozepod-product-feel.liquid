{% comment %}
  Verified product-feel indicator.

  Expected metafields (product or selected variant):
  - custom.feel_label: single-line text
  - custom.feel_position: integer from 0 through 100

  Variant values take precedence. The indicator fails closed when either value
  is absent or the position is outside the approved range.

  Accepts:
  - feel_product: Product object
  - compact: Boolean
  - show_editor_placeholder: Boolean
{% endcomment %}

{%- liquid
  assign feel_variant = feel_product.selected_or_first_available_variant
  assign feel_label = feel_variant.metafields.custom.feel_label.value | default: feel_product.metafields.custom.feel_label.value | strip
  assign feel_position_raw = feel_variant.metafields.custom.feel_position.value
  if feel_position_raw == blank
    assign feel_position_raw = feel_product.metafields.custom.feel_position.value
  endif

  assign feel_is_verified = false
  if feel_label != blank and feel_position_raw != blank
    assign feel_position = feel_position_raw | plus: 0
    if feel_position >= 0 and feel_position <= 100
      assign feel_is_verified = true
    endif
  endif
-%}

{%- if feel_is_verified -%}
  <div class="snoozepod-feel{% if compact %} snoozepod-feel--compact{% endif %}">
    <div class="snoozepod-feel__heading">
      <span class="snoozepod-feel__title">Product Feel</span>
      <span class="snoozepod-feel__label">{{ feel_label | escape }}</span>
    </div>
    <div
      class="snoozepod-feel__track"
      role="progressbar"
      aria-label="Product feel: {{ feel_label | escape }}"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ feel_position }}"
      aria-valuetext="{{ feel_label | escape }}"
    >
      <span class="snoozepod-feel__fill" style="--snoozepod-feel-position: {{ feel_position }}%;"></span>
    </div>
    <div class="snoozepod-feel__scale" aria-hidden="true">
      <span>Soft</span>
      <span>Firm</span>
    </div>
  </div>
{%- elsif request.design_mode and show_editor_placeholder -%}
  <div class="snoozepod-data-placeholder" role="note">
    Theme editor preview only: Product Feel is hidden until a verified label and 0–100 position are supplied.
  </div>
{%- endif -%}
