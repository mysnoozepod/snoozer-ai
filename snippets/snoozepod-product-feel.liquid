{% comment %}
  Verified product-feel indicator.

  Expected product metafield:
  - custom.feel_label: constrained single-line text

  Approved values are Plush, Medium Plush, Medium Firm, and Firm. The visual
  position is derived from that controlled value so merchants do not maintain
  a second, potentially contradictory field.

  Accepts:
  - feel_product: Product object
  - compact: Boolean
  - show_editor_placeholder: Boolean
{% endcomment %}

{%- liquid
  assign feel_label = feel_product.metafields.custom.feel_label.value | default: feel_product.metafields.custom.feel_label | strip
  assign feel_is_verified = false
  case feel_label
    when 'Plush'
      assign feel_position = 15
      assign feel_is_verified = true
    when 'Medium Plush'
      assign feel_position = 38
      assign feel_is_verified = true
    when 'Medium Firm'
      assign feel_position = 65
      assign feel_is_verified = true
    when 'Firm'
      assign feel_position = 90
      assign feel_is_verified = true
  endcase
-%}

{%- if feel_is_verified -%}
  <div class="snoozepod-feel{% if compact %} snoozepod-feel--compact{% endif %}">
    <div class="snoozepod-feel__heading">
      <span class="snoozepod-feel__title">Product Feel</span>
      <span class="snoozepod-feel__label">{{ feel_label | escape }}</span>
    </div>
    <div
      class="snoozepod-feel__track"
      role="progressbar"
      aria-label="Product feel: {{ feel_label | escape }}"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ feel_position }}"
      aria-valuetext="{{ feel_label | escape }}"
    >
      <span class="snoozepod-feel__fill" style="--snoozepod-feel-position: {{ feel_position }}%;"></span>
    </div>
    <div class="snoozepod-feel__scale" aria-hidden="true">
      <span>Plush</span>
      <span>Firm</span>
    </div>
  </div>
{%- elsif request.design_mode and show_editor_placeholder -%}
  <div class="snoozepod-data-placeholder" role="note">
    Theme editor preview only: Product Feel is hidden until one of the four approved classifications is supplied.
  </div>
{%- endif -%}
