{%- liquid
  assign support_handles = 'faqs,shipping-policy,90-day-sleep-trial,privacy-policy,terms-of-service,contact-us,about-us' | split: ','
  assign page_handle_value = page_handle | default: page.handle | handleize
  assign page_title_handle = page.title | handleize
  assign page_key = page_handle_value
  if support_handles contains page_title_handle
    assign page_key = page_title_handle
  elsif page_key == blank
    assign page_key = page_title_handle
  endif

  case page_key
    when 'faqs'
      echo 'Find quick answers about the showroom, Snooze Sessions, support, shipping basics, and sleep trial guidance.'
    when 'shipping-policy'
      echo 'Review order processing, delivery timing, large-item guidance, tracking communication, and how to reach support if something needs attention.'
    when '90-day-sleep-trial'
      echo 'Understand how the sleep trial works, who it applies to, and how to request help if the fit is not right.'
    when 'privacy-policy'
      echo 'Review how MySnoozePod handles personal information, site activity, and related privacy practices.'
    when 'terms-of-service'
      echo 'Review the terms that govern use of MySnoozePod, purchases, and related services.'
    when 'contact-us'
      echo 'Reach out for booking help, product questions, order updates, shipping support, or showroom guidance.'
    when 'about-us'
      echo 'Learn how MySnoozePod combines a private showroom, Snoozer guidance, and a calmer way to shop for sleep.'
  endcase
-%}
