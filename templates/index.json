    "light-product-preview": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{{ 'component-card.css' | asset_url | stylesheet_tag }}\n{{ 'template-collection.css' | asset_url | stylesheet_tag }}\n{{ 'quick-add.css' | asset_url | stylesheet_tag }}\n<script src='{{ \"product-form.js\" | asset_url }}' defer='defer'></script>\n<script src='{{ \"quick-add.js\" | asset_url }}' defer='defer'></script>\n<div class='homepage-shelf homepage-shelf--preview'>\n  <div class='homepage-shelf__header page-width'>\n    <div class='homepage-shelf__copy'>\n      <h2 class='homepage-shelf__title title inline-richtext h2'>Top Picks Based on Real Sleep Profiles</h2>\n      <div class='homepage-shelf__description collection__description body rte'>\n        <p>Start here. These are common matches for shoppers looking for better sleep.</p>\n      </div>\n    </div>\n    <a class='homepage-shelf__link link underlined-link' href='/search?q=mattress&amp;options%5Bprefix%5D=last&amp;type=product'>View All Mattresses &rarr;</a>\n  </div>\n  <div class='page-width'>\n    <ul class='grid product-grid contains-card contains-card--product contains-card--standard grid--3-col-desktop grid--2-col-tablet-down' role='list'>\n      {% assign preview_handles = '12-all-foam-mattress|12-dual-comfort-hybrid|14-hybrid' | split: '|' %}\n      {% assign skip_card_product_styles = false %}\n      {% for handle in preview_handles %}\n        {% assign preview_product = all_products[handle] %}\n        {% if preview_product != blank %}\n          <li class='grid__item'>\n            {% render 'card-product', card_product: preview_product, media_aspect_ratio: 'square', image_shape: 'default', show_secondary_image: false, show_vendor: false, show_rating: false, skip_styles: skip_card_product_styles, section_id: section.id, quick_add: 'standard' %}\n          </li>\n          {% assign skip_card_product_styles = true %}\n        {% endif %}\n      {% endfor %}\n    </ul>\n  </div>\n</div>",
        "color_scheme": "scheme-2",
        "padding_top": 64,
        "padding_bottom": 64
      }
    },
    "showroom": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class='page-width homepage-showroom'>\n  <div class='homepage-showroom__content'>\n    <h2 class='homepage-showroom__heading h2'>The SnoozePod Unmanned Showroom</h2>\n    <p class='homepage-showroom__copy'>Experience mattresses in a private, pressure-free environment. Explore at your own pace, test what you like, and get guidance on your terms.</p>\n    <a class='button button--primary' href='/pages/book-a-snooze-session'>Book a Snooze Session</a>\n  </div>\n  <div class='homepage-showroom__media'>\n    <img class='homepage-showroom__image' src='{{ \"homepage-showroom-snoozepod.png\" | asset_url }}' alt='Private unmanned SnoozePod showroom with mattress and tablet guidance' width='1536' height='1024' loading='lazy'>\n  </div>\n</div>",
        "color_scheme": "scheme-1",
        "padding_top": 64,
        "padding_bottom": 64
      }
    },
