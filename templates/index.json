    "featured_collection_666q7i": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class='homepage-shelf homepage-shelf--full'>\n  <div class='homepage-shelf__header page-width'>\n    <div class='homepage-shelf__copy'>\n      <h2 class='homepage-shelf__title title inline-richtext h2'>Find What Works For How You Sleep</h2>\n      <div class='homepage-shelf__description collection__description body rte'>\n        <p>Start with the Snooze Assessment. Snoozer guides you to the right mattress.</p>\n      </div>\n    </div>\n  </div>\n  <div class='page-width'>\n    <ul class='homepage-shelf__grid' role='list'>\n      {% assign mattress_handles = '10-all-foam-mattress|12-all-foam-mattress|12-dual-comfort-hybrid|14-hybrid' | split: '|' %}\n      {% for handle in mattress_handles %}\n        {% assign mattress_product = all_products[handle] %}\n        {% if mattress_product != blank %}\n          {% assign benefit_1 = '' %}\n          {% assign benefit_2 = '' %}\n          {% assign benefit_3 = '' %}\n          {% case handle %}\n            {% when '10-all-foam-mattress' %}\n              {% assign benefit_1 = 'Pressure Relief' %}\n              {% assign benefit_2 = 'Motion Isolation' %}\n              {% assign benefit_3 = 'Back Support' %}\n            {% when '12-all-foam-mattress' %}\n              {% assign benefit_1 = 'Plush Comfort' %}\n              {% assign benefit_2 = 'Pressure Relief' %}\n              {% assign benefit_3 = 'Cooling Cover' %}\n            {% when '12-dual-comfort-hybrid' %}\n              {% assign benefit_1 = 'Dual Comfort' %}\n              {% assign benefit_2 = 'Couples' %}\n              {% assign benefit_3 = 'Balanced Support' %}\n            {% when '14-hybrid' %}\n              {% assign benefit_1 = 'Cooling Support' %}\n              {% assign benefit_2 = 'Hybrid Feel' %}\n              {% assign benefit_3 = 'Edge Support' %}\n          {% endcase %}\n          <li class='homepage-shelf__item'>\n            <article class='homepage-shelf-card'>\n              <a class='homepage-shelf-card__media-link' href='{{ mattress_product.url }}'>\n                <div class='homepage-shelf-card__media'>\n                  {% if mattress_product.featured_media %}\n                    {{\n                      mattress_product.featured_media\n                      | image_url: width: 900\n                      | image_tag:\n                        class: 'homepage-shelf-card__image',\n                        widths: '320, 480, 640, 720, 900',\n                        sizes: '(min-width: 990px) calc((1320px - 84px) / 4), (min-width: 750px) calc((100vw - 80px) / 2), calc((100vw - 48px) / 2)',\n                        loading: 'lazy',\n                        alt: mattress_product.featured_media.alt | default: mattress_product.title\n                    }}\n                  {% endif %}\n                </div>\n              </a>\n              <div class='homepage-shelf-card__body'>\n                <h3 class='homepage-shelf-card__title'>\n                  <a class='homepage-shelf-card__title-link' href='{{ mattress_product.url }}'>{{ mattress_product.title | escape }}</a>\n                </h3>\n                <div class='homepage-shelf-card__benefits' aria-label='Product benefits'>\n                  <span class='homepage-shelf-card__benefit'>{{ benefit_1 }}</span>\n                  <span class='homepage-shelf-card__benefit'>{{ benefit_2 }}</span>\n                  <span class='homepage-shelf-card__benefit'>{{ benefit_3 }}</span>\n                </div>\n                <a class='homepage-shelf-card__cta' href='{{ mattress_product.url }}'>View Details &rarr;</a>\n              </div>\n            </article>\n          </li>\n        {% endif %}\n      {% endfor %}\n    </ul>\n  </div>\n</div>",
        "color_scheme": "scheme-2",
        "padding_top": 48,
        "padding_bottom": 56
      }
    },
