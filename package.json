{
  "name": "snoozer-backend",
  "version": "1.0.0",
  "description": "Omnia Snoozer backend for Shopify, Zoho, and OpenAI integrations",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "start": "node index.js",
    "calendly:webhooks:list": "node scripts/calendlyWebhookSetup.js",
    "calendly:webhooks:create": "node scripts/calendlyWebhookSetup.js --create",
    "test:ask-snoozer": "node scripts/runAskSnoozerGoldenTests.js",
    "test:ask-snoozer-continuity": "node tests/runAskSnoozerContinuityGroundingTests.js",
    "test:ask-snoozer-station": "node tests/runAskSnoozerStationTests.js",
    "test:ask-snoozer-advisor": "node tests/runAskSnoozerTrustedAdvisorTests.js",
    "test:ask-snoozer-advisor:live": "node scripts/runAskSnoozerTrustedAdvisorLiveAcceptance.js",
    "test:ask-snoozer-big-pass-2:live": "node scripts/runAskSnoozerBigPass2LiveAcceptance.js",
    "test:ask-snoozer-big-pass-3:live": "node scripts/runAskSnoozerBigPass3LiveAcceptance.js",
    "test:ask-snoozer-visits": "node tests/runAskSnoozerVisitLifecycleTests.js",
    "test:ask-snoozer-composer": "node tests/runAskSnoozerModelComposerTests.js",
    "test:ask-snoozer-commercial-continuity": "node tests/runAskSnoozerCommercialContinuityComposerTests.js",
    "test:ask-snoozer-shopper-feedback": "node tests/runAskSnoozerShopperFeedbackAuthorityTests.js",
    "test:ask-snoozer-adaptive-decision": "node tests/runAskSnoozerAdaptiveDecisionExecutionTests.js",
    "test:active-journey": "node tests/runActiveJourneyTests.js",
    "test:active-journey-routes": "node tests/runActiveJourneyRouteTests.js",
    "test:active-journey-acceptance": "node tests/runActiveJourneyAcceptanceTests.js",
    "test:ask-snoozer-shopper-feedback:live": "node scripts/runAskSnoozerShopperFeedbackLiveAcceptance.js",
    "test:ask-snoozer-adaptive-decision:live": "node scripts/runAskSnoozerPhase2LiveAcceptance.js",
    "test:ask-snoozer-evals": "node tests/runAskSnoozerRealisticEvaluations.js",
    "test:ask-snoozer-recovery": "node tests/runAskSnoozerRecoveryEvaluations.js",
    "test:ask-snoozer-quality-loop": "node tests/runAskSnoozerQualityLoopTests.js",
    "test:ask-snoozer-client-timing": "node omnia-journey/tests/runAskSnoozerPerformanceTests.mjs",
    "test:ask-snoozer-audio-supersession": "node omnia-journey/tests/runVoiceQueueSupersessionTests.mjs",
    "report:ask-snoozer-quality": "node scripts/runAskSnoozerQualityReport.js",
    "accept:ask-snoozer-device-tts": "node scripts/runAskSnoozerDeviceTtsAcceptance.js",
    "test:integration-secrets": "node tests/runIntegrationSecretsTests.js",
    "test:ask-snoozer-copy": "node scripts/runAskSnoozerGoldenTests.js --copy-only",
    "test:snoozer-surface-parity": "node tests/runSnoozerSurfaceParityTests.js",
    "test:shopper-session-continuity": "node tests/runShopperSessionContinuityTests.js",
    "test:shopify-api-versions": "node tests/runShopifyApiVersionTests.js",
    "test:rewards-production": "node tests/runRewardsProductionTests.js",
    "validate:ask-snoozer-knowledge": "node scripts/validateAskSnoozerKnowledgeManifest.js",
    "package:lambda": "tar -a -cf snoozer-backend.zip index.js package.json package-lock.json data handlers routes services utils node_modules faqs.json knowledge_base.json",
    "package:with-deps": "rm -f build.zip && npm ci && zip -r build.zip . -x \".git/*\" -x \"*.log\" -x \"build.zip\"",
    "package:without-deps": "rm -f build.zip && zip -r build.zip . -x \"node_modules/*\" -x \".git/*\" -x \"*.log\" -x \"build.zip\" && echo \"⚠️ Remember: use a Lambda Layer for node_modules if you ship this zip.\""
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.901.0",
    "@aws-sdk/client-dynamodb": "^3.901.0",
    "@aws-sdk/client-iot-data-plane": "^3.1089.0",
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/client-secrets-manager": "^3.901.0",
    "@aws-sdk/client-sqs": "3.901.0",
    "@aws-sdk/lib-dynamodb": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.609.0",
    "@aws-sdk/util-dynamodb": "^3.996.7",
    "axios": "^1.7.7",
    "dotenv": "^17.2.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
