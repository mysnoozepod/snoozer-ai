{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .process-visual-section__inner {
    max-width: 108rem;
    margin: 0 auto;
  }

  .process-visual-section__heading {
    margin: 0 0 2.4rem;
  }

  .process-visual-section__media {
    overflow: hidden;
    border-radius: 1.6rem;
    border: 0.1rem solid rgba(var(--color-text-primary), 0.08);
    background: rgb(var(--color-background));
  }

  .process-visual-section__image {
    display: block;
    width: 100%;
    height: auto;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .process-visual-section__heading {
      margin-bottom: 3.2rem;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="process-visual-section__inner">
      {%- if section.settings.position == 'above' and section.settings.image != blank -%}
        <div class="process-visual-section__media">
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              widths: '480, 720, 960, 1200, 1600, 2000, 2400',
              sizes: 'min(100vw, 1080px)',
              class: 'process-visual-section__image',
              loading: 'lazy',
              alt: section.settings.image.alt | default: section.settings.heading | default: 'Process visual' | escape
          }}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="process-visual-section__heading h2">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.position == 'below' and section.settings.image != blank -%}
        <div class="process-visual-section__media">
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              widths: '480, 720, 960, 1200, 1600, 2000, 2400',
              sizes: 'min(100vw, 1080px)',
              class: 'process-visual-section__image',
              loading: 'lazy',
              alt: section.settings.image.alt | default: section.settings.heading | default: 'Process visual' | escape
          }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Process visual section",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Image position",
      "default": "below",
      "options": [
        {
          "value": "above",
          "label": "Above"
        },
        {
          "value": "below",
          "label": "Below"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Process visual section"
    }
  ]
}
{% endschema %}
