{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign anchor_kind = 'mattress'
  assign anchor_copy = product.description | strip_html | strip_newlines | replace: '  ', ' ' | strip | truncate: 170

  if product.type contains 'Base' or product.type contains 'base' or product.handle contains 'base'
    assign anchor_kind = 'base'
  endif

  case product.handle
    when '12-dual-comfort-hybrid'
      assign anchor_copy = 'Start your SnoozePod with this shared-sleep hybrid, then choose the size, base, motion, protection, pillow, and bedding around it.'
    when '14-hybrid'
      assign anchor_copy = 'Start your SnoozePod with this supportive hybrid, then choose the size, base, motion, protection, pillow, and bedding around it.'
    when '12-all-foam-mattress'
      assign anchor_copy = 'Start your SnoozePod with this contouring foam mattress, then choose the size, base, motion, protection, pillow, and bedding around it.'
    when '10-all-foam-mattress'
      assign anchor_copy = 'Start your SnoozePod with this simpler foam mattress, then choose the size, base, motion, protection, pillow, and bedding around it.'
  endcase

  if anchor_copy == blank
    assign anchor_copy = 'Start your SnoozePod with this product, then choose the size, base, motion, protection, pillow, and bedding around it.'
  endif

  assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
  assign first_3d_model = product.media | where: 'media_type', 'model' | first
-%}

{%- style -%}
  .snoozepod-pod-builder-hero-{{ section.id }} {
    max-width: 1480px;
    margin: 20px 16px 12px;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    align-items: start;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__media-card,
  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__info-card,
  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__fallback {
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(7, 25, 66, 0.10);
    background: #ffffff;
    box-shadow: 0 18px 44px rgba(7, 25, 66, 0.06);
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__fallback {
    display: flex;
    align-items: flex-end;
    min-height: 220px;
    padding: 22px;
    background:
      radial-gradient(circle at top right, rgba(44, 66, 120, 0.16), transparent 34%),
      linear-gradient(180deg, #f5f7fb 0%, #edf2f9 100%);
    color: rgba(7, 25, 66, 0.76);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__info-card {
    padding: 24px;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__eyebrow {
    margin: 0 0 10px;
    color: rgba(7, 25, 66, 0.62);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__title {
    margin: 0;
    color: #071942;
    font-size: 32px;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__copy {
    margin: 14px 0 0;
    color: rgba(7, 25, 66, 0.82);
    font-size: 16px;
    line-height: 1.5;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__note {
    margin: 14px 0 0;
    color: rgba(7, 25, 66, 0.64);
    font-size: 14px;
    line-height: 1.45;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__price {
    margin-top: 18px;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .price {
    color: #071942;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .price--large .price-item,
  .snoozepod-pod-builder-hero-{{ section.id }} .price__regular .price-item--regular,
  .snoozepod-pod-builder-hero-{{ section.id }} .price__sale .price-item--sale {
    font-size: 22px;
    line-height: 1.2;
  }

  @media screen and (min-width: 750px) {
    .snoozepod-pod-builder-hero-{{ section.id }} {
      margin-left: 24px;
      margin-right: 24px;
    }

    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__title {
      font-size: 40px;
    }
  }

  @media screen and (min-width: 990px) {
    .snoozepod-pod-builder-hero-{{ section.id }} {
      margin: 28px auto 16px;
      padding: 0 32px;
    }

    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__grid {
      grid-template-columns: minmax(0, 54fr) minmax(0, 46fr);
      gap: 32px;
    }

    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__media-card,
    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__info-card {
      border-radius: 30px;
    }

    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__info-card {
      padding: 32px 34px;
    }

    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__title {
      max-width: 11ch;
      font-size: 48px;
    }
  }
{%- endstyle -%}

<section class="section">
  <div class="snoozepod-pod-builder-hero-{{ section.id }}">
    <div class="snoozepod-pod-builder-hero__grid">
      <div class="snoozepod-pod-builder-hero__media-wrapper">
        {%- if product.media.size > 0 -%}
          <div class="snoozepod-pod-builder-hero__media-card product__media-wrapper">
            {% render 'product-media-gallery', variant_images: variant_images %}
          </div>
        {%- else -%}
          <div class="snoozepod-pod-builder-hero__fallback">
            <span>{{ product.title | escape }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="snoozepod-pod-builder-hero__info-wrapper">
        <div class="snoozepod-pod-builder-hero__info-card">
          <p class="snoozepod-pod-builder-hero__eyebrow">Pod Builder</p>
          <h1 class="snoozepod-pod-builder-hero__title">{{ product.title | escape }}</h1>
          <p class="snoozepod-pod-builder-hero__copy">{{ anchor_copy }}</p>
          <p class="snoozepod-pod-builder-hero__note">
            This {{ anchor_kind }} is the anchor. The guided builder below handles size, base, motion, protection, pillow, and bedding direction in one flow.
          </p>

          <div class="snoozepod-pod-builder-hero__price">
            {%- render 'price',
              product: product,
              use_variant: true,
              show_badges: true,
              price_class: 'price--large'
            -%}
          </div>
        </div>
      </div>
    </div>

    {%- if product.media.size > 0 -%}
      {% render 'product-media-modal', variant_images: variant_images %}
      <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if first_3d_model -%}
      <script type="application/json" id="ProductJSON-{{ product.id }}">
        {{ product.media | where: 'media_type', 'model' | json }}
      </script>
      <script src="{{ 'product-model.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    <script type="application/ld+json">
      {{ product | structured_data }}
    </script>
  </div>
</section>

{% schema %}
{
  "name": "Pod builder hero",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Pod builder hero"
    }
  ]
}
{% endschema %}
