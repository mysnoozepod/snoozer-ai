{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'snoozepod-pod-builder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'snoozepod-pod-builder.js' | asset_url }}" defer></script>

{%- liquid
  assign anchor_kind = 'mattress'
  assign hero_label = 'Mattress'
  assign product_summary = product.description | strip_html | strip_newlines | replace: '  ', ' ' | strip | truncate: 150
  assign starter_copy = 'Start with this mattress, then choose the size, base, and comfort options around it.'
  assign builder_intro_copy = 'Choose your size, base, and add-on path here. Your selected build total updates before checkout.'

  if product.type contains 'Base' or product.type contains 'base' or product.handle contains 'base'
    assign anchor_kind = 'base'
    assign hero_label = 'Base'
    assign starter_copy = 'Start with this base, then choose the size and comfort options around it.'
    assign builder_intro_copy = 'Choose your size and support options here. Your selected build total updates before checkout.'
  endif

  case product.handle
    when '12-dual-comfort-hybrid'
      assign product_summary = 'Hybrid comfort with split-feel flexibility for shared sleep setups.'
    when '14-hybrid'
      assign product_summary = 'Supportive hybrid lift for shoppers who want stronger pushback and recovery.'
    when '12-all-foam-mattress'
      assign product_summary = 'Deeper all-foam contour with more comfort depth than the 10-inch profile.'
    when '10-all-foam-mattress'
      assign product_summary = 'Simpler all-foam contour with basic support for a cleaner starting point.'
  endcase

  if product_summary == blank
    assign product_summary = 'Start with this product as the foundation of your SnoozePod build.'
  endif

  assign image_media = product.media | where: 'media_type', 'image'
  assign featured_media = product.selected_or_first_available_variant.featured_media
  if featured_media and featured_media.media_type != 'image'
    assign featured_media = nil
  endif
  if featured_media == nil
    assign featured_media = image_media | first
  endif

  assign featured_preview = featured_media.preview_image
  if featured_preview == blank
    assign featured_preview = product.featured_image
  endif

  assign image_count = image_media.size
-%}

{%- style -%}
  .snoozepod-pod-builder-hero-{{ section.id }} {
    max-width: 1380px;
    margin: 12px 16px 8px;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    align-items: start;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__media-card,
  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__info-card,
  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__fallback {
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(7, 25, 66, 0.10);
    background: #ffffff;
    box-shadow: 0 18px 44px rgba(7, 25, 66, 0.06);
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__media-card {
    padding: 14px;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__media-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 240px;
    border-radius: 18px;
    background:
      radial-gradient(circle at top right, rgba(44, 66, 120, 0.08), transparent 38%),
      linear-gradient(180deg, #ffffff 0%, #f7f9fc 100%);
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__main-image {
    display: block;
    width: 100%;
    height: clamp(240px, 48vw, 360px);
    object-fit: contain;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(64px, 1fr));
    gap: 10px;
    margin-top: 14px;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__thumb {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 76px;
    padding: 8px;
    border: 1px solid rgba(7, 25, 66, 0.12);
    border-radius: 16px;
    background: #f8faff;
    cursor: pointer;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__thumb:hover,
  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__thumb:focus-visible,
  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__thumb.is-active {
    border-color: rgba(7, 25, 66, 0.28);
    box-shadow: 0 10px 24px rgba(7, 25, 66, 0.10);
    transform: translateY(-1px);
    outline: none;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__thumb img {
    display: block;
    width: 100%;
    max-height: 76px;
    object-fit: contain;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__fallback {
    display: flex;
    align-items: flex-end;
    min-height: 220px;
    padding: 22px;
    background:
      radial-gradient(circle at top right, rgba(44, 66, 120, 0.16), transparent 34%),
      linear-gradient(180deg, #f5f7fb 0%, #edf2f9 100%);
    color: rgba(7, 25, 66, 0.76);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__info-card {
    display: grid;
    gap: 0;
    padding: 20px;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__eyebrow {
    margin: 0 0 10px;
    color: rgba(7, 25, 66, 0.62);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__title {
    margin: 0;
    color: #071942;
    font-size: 28px;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__copy {
    margin: 12px 0 0;
    color: rgba(7, 25, 66, 0.82);
    font-size: 15px;
    line-height: 1.45;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__price {
    margin-top: 12px;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__price-label {
    margin: 0 0 0.6rem;
    color: rgba(7, 25, 66, 0.56);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .price {
    color: #071942;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .price--large .price-item,
  .snoozepod-pod-builder-hero-{{ section.id }} .price__regular .price-item--regular,
  .snoozepod-pod-builder-hero-{{ section.id }} .price__sale .price-item--sale {
    font-size: 24px;
    line-height: 1.2;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__actions {
    display: grid;
    gap: 10px;
    margin-top: 18px;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__actions .button {
    width: 100%;
    min-height: 52px;
    justify-content: center;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__reassurance {
    margin: 14px 0 0;
    color: rgba(7, 25, 66, 0.64);
    font-size: 13px;
    line-height: 1.45;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__inline-builder {
    margin-top: 18px;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__starter {
    margin-top: 18px;
    padding: 18px;
    border: 1px solid rgba(7, 25, 66, 0.08);
    border-radius: 20px;
    background: #f7f9fc;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__starter-title {
    margin: 0;
    color: #071942;
    font-size: 24px;
    line-height: 1.06;
    letter-spacing: -0.03em;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__starter-copy {
    margin: 10px 0 0;
    color: rgba(7, 25, 66, 0.78);
    font-size: 15px;
    line-height: 1.45;
  }

  .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__starter-helper {
    display: block;
    margin-top: 10px;
    color: rgba(7, 25, 66, 0.62);
    font-size: 13px;
    line-height: 1.4;
  }

  @media screen and (max-width: 989px) {
    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__info-wrapper {
      order: -1;
    }
  }

  @media screen and (min-width: 750px) {
    .snoozepod-pod-builder-hero-{{ section.id }} {
      margin-left: 24px;
      margin-right: 24px;
    }

    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__title {
      font-size: 34px;
    }

    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__media-stage {
      min-height: 280px;
    }
  }

  @media screen and (min-width: 990px) {
    .snoozepod-pod-builder-hero-{{ section.id }} {
      margin: 18px auto 12px;
      padding: 0 32px;
    }

    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__grid {
      grid-template-columns: minmax(0, 0.52fr) minmax(0, 0.48fr);
      gap: 20px;
    }

    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__media-card,
    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__info-card {
      border-radius: 30px;
    }

    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__media-card {
      padding: 16px;
    }

    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__info-card {
      padding: 34px 36px;
    }

    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__title {
      max-width: 11ch;
      font-size: 42px;
    }

    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__main-image {
      height: clamp(360px, 34vw, 460px);
    }

    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__thumbs {
      grid-template-columns: repeat(auto-fit, minmax(80px, 92px));
      justify-content: flex-start;
    }

    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__actions .button {
      width: auto;
      min-width: 220px;
      min-height: 54px;
    }

    .snoozepod-pod-builder-hero-{{ section.id }} .snoozepod-pod-builder-hero__starter {
      margin-top: 22px;
      padding: 22px 24px;
    }
  }
{%- endstyle -%}

<section class="section">
  <div class="snoozepod-pod-builder-hero-{{ section.id }}">
    <div class="snoozepod-pod-builder-hero__grid">
      <div class="snoozepod-pod-builder-hero__media-wrapper">
        {%- if featured_preview != blank -%}
          <div class="snoozepod-pod-builder-hero__media-card">
            <div class="snoozepod-pod-builder-hero__media-stage">
              <img
                class="snoozepod-pod-builder-hero__main-image"
                src="{{ featured_preview | image_url: width: 1400 }}"
                alt="{{ featured_preview.alt | default: product.title | escape }}"
                loading="eager"
                width="{{ featured_preview.width | default: 1400 }}"
                height="{{ featured_preview.height | default: 1400 }}"
                data-pod-builder-main-image
              >
            </div>

            {%- if image_count > 1 -%}
              <div class="snoozepod-pod-builder-hero__thumbs" role="list" aria-label="Product images">
                {%- for media in image_media -%}
                  {%- assign preview = media.preview_image -%}
                  {%- assign thumb_alt = preview.alt | default: product.title -%}
                  {%- assign is_active = false -%}
                  {%- if featured_media != blank and media.id == featured_media.id -%}
                    {%- assign is_active = true -%}
                  {%- elsif featured_media == blank and forloop.first -%}
                    {%- assign is_active = true -%}
                  {%- endif -%}
                  <button
                    type="button"
                    class="snoozepod-pod-builder-hero__thumb{% if is_active %} is-active{% endif %}"
                    data-pod-builder-thumb
                    data-image-src="{{ preview | image_url: width: 1400 }}"
                    data-image-alt="{{ preview.alt | default: product.title | escape }}"
                    aria-current="{% if is_active %}true{% else %}false{% endif %}"
                    aria-label="Show image {{ forloop.index }}"
                  >
                    {{
                      preview
                      | image_url: width: 220
                      | image_tag:
                        loading: 'lazy',
                        widths: '72, 96, 144, 220',
                        sizes: '72px',
                        alt: thumb_alt
                    }}
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="snoozepod-pod-builder-hero__fallback">
            <span>{{ product.title | escape }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="snoozepod-pod-builder-hero__info-wrapper">
        <div class="snoozepod-pod-builder-hero__info-card">
          <p class="snoozepod-pod-builder-hero__eyebrow">{{ hero_label }}</p>
          <h1 class="snoozepod-pod-builder-hero__title">{{ product.title | escape }}</h1>
          <p class="snoozepod-pod-builder-hero__copy">{{ product_summary }}</p>

          <div class="snoozepod-pod-builder-hero__price">
            <p class="snoozepod-pod-builder-hero__price-label">Mattress price</p>
            {%- render 'price',
              product: product,
              use_variant: true,
              show_badges: true,
              price_class: 'price--large'
            -%}
          </div>

          <div class="snoozepod-pod-builder-hero__inline-builder">
            {%- render 'snoozepod-guided-pod-builder-core',
              builder_id: section.id,
              builder_anchor_id: 'pod-builder',
              builder_heading: 'Build this SnoozePod',
              builder_intro: builder_intro_copy,
              builder_primary_label: 'Add Selected Build to Cart',
              builder_context: 'inline'
            -%}
          </div>

          <p class="snoozepod-pod-builder-hero__reassurance">Review every selection before anything is added to cart.</p>
        </div>
      </div>
    </div>

    <script type="application/ld+json">
      {{ product | structured_data }}
    </script>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('.snoozepod-pod-builder-hero-{{ section.id }}');
    if (!root) return;

    const mainImage = root.querySelector('[data-pod-builder-main-image]');
    const thumbs = root.querySelectorAll('[data-pod-builder-thumb]');
    if (!mainImage || !thumbs.length) return;

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const nextSrc = thumb.dataset.imageSrc;
        const nextAlt = thumb.dataset.imageAlt || mainImage.alt;

        if (nextSrc) {
          mainImage.src = nextSrc;
        }

        mainImage.alt = nextAlt;

        thumbs.forEach((button) => {
          button.classList.remove('is-active');
          button.setAttribute('aria-current', 'false');
        });

        thumb.classList.add('is-active');
        thumb.setAttribute('aria-current', 'true');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Pod builder hero",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Pod builder hero"
    }
  ]
}
{% endschema %}
