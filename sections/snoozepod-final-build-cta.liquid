{%- liquid
  assign mattress_catalog = ''
  assign mattress_handles = '10-all-foam-mattress|12-all-foam-mattress|12-dual-comfort-hybrid|14-hybrid' | split: '|'
  for handle in mattress_handles
    assign source_product = all_products[handle]
    if source_product != blank
      assign descriptor = ''
      case handle
        when '10-all-foam-mattress'
          assign descriptor = 'Pressure Relief / Motion Isolation'
        when '12-all-foam-mattress'
          assign descriptor = 'Plush Comfort / Pressure Relief'
        when '12-dual-comfort-hybrid'
          assign descriptor = 'Dual Comfort / Balanced Support'
        when '14-hybrid'
          assign descriptor = 'Cooling Support / Hybrid Feel'
      endcase

      capture mattress_catalog
        echo mattress_catalog
        echo '{"kind":"product","handle":'
        echo source_product.handle | json
        echo ',"title":'
        echo source_product.title | json
        echo ',"url":'
        echo source_product.url | json
        echo ',"descriptor":'
        echo descriptor | json
        echo ',"available":'
        echo source_product.available | json
        echo ',"priceMin":'
        echo source_product.price_min | json
        echo ',"image":'
        if source_product.featured_image
          echo source_product.featured_image | image_url: width: 900 | json
        else
          echo 'null'
        endif
        echo ',"imageAlt":'
        if source_product.featured_image and source_product.featured_image.alt != blank
          echo source_product.featured_image.alt | json
        else
          echo source_product.title | json
        endif
        echo ',"variants":'
        echo source_product.variants | json
        echo '},'
      endcapture
    endif
  endfor
  assign mattress_catalog = mattress_catalog | remove_last: ','

  assign base_catalog = ''
  assign base_handles = 'platform-base|storage-base|premium-motion-adjustable-base' | split: '|'
  for handle in base_handles
    assign source_product = all_products[handle]
    if source_product != blank
      assign type_label = source_product.type
      assign is_adjustable = false
      if source_product.handle contains 'adjustable' or source_product.tags contains 'base:adjustable'
        assign is_adjustable = true
        assign type_label = 'Adjustable base'
      elsif type_label == blank
        assign type_label = 'Base'
      endif

      capture base_catalog
        echo base_catalog
        echo '{"kind":"product","handle":'
        echo source_product.handle | json
        echo ',"title":'
        echo source_product.title | json
        echo ',"url":'
        echo source_product.url | json
        echo ',"typeLabel":'
        echo type_label | json
        echo ',"available":'
        echo source_product.available | json
        echo ',"isAdjustable":'
        echo is_adjustable | json
        echo ',"priceMin":'
        echo source_product.price_min | json
        echo ',"image":'
        if source_product.featured_image
          echo source_product.featured_image | image_url: width: 900 | json
        else
          echo 'null'
        endif
        echo ',"imageAlt":'
        if source_product.featured_image and source_product.featured_image.alt != blank
          echo source_product.featured_image.alt | json
        else
          echo source_product.title | json
        endif
        echo ',"variants":'
        echo source_product.variants | json
        echo '},'
      endcapture
    endif
  endfor
  assign base_catalog = base_catalog | remove_last: ','
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .snoozepod-visual-builder-{{ section.id }} {
    width: min(100%, var(--wide-content-max));
    margin: 0 auto;
    padding-left: var(--page-padding-mobile);
    padding-right: var(--page-padding-mobile);
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__frame {
    padding: 24px 18px;
    border: 1px solid rgba(7, 25, 66, 0.1);
    border-radius: 30px;
    background:
      radial-gradient(circle at top right, rgba(44, 66, 120, 0.08), transparent 30%),
      linear-gradient(180deg, #ffffff 0%, #f7f9fc 100%);
    box-shadow: 0 18px 42px rgba(7, 25, 66, 0.06);
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__eyebrow,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__step-label,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__summary-label,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__price-label,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__row-term {
    margin: 0;
    color: rgba(7, 25, 66, 0.56);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__heading,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__step-title,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__summary-title {
    margin: 0;
    color: #071942;
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__heading {
    font-size: 30px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__subheading,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__step-copy,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__review-note,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__next-action {
    margin: 0;
    color: rgba(7, 25, 66, 0.76);
    font-size: 15px;
    line-height: 1.5;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__step-chip {
    align-self: flex-start;
    padding: 9px 13px;
    border-radius: 999px;
    background: #eef3fb;
    color: #071942;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__progress {
    margin-top: 16px;
    height: 5px;
    border-radius: 999px;
    background: rgba(7, 25, 66, 0.08);
    overflow: hidden;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__progress span {
    display: block;
    width: 20%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #071942 0%, #2c4278 100%);
    transition: width 180ms ease;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__layout {
    display: grid;
    gap: 18px;
    margin-top: 18px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__main,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__summary {
    padding: 20px;
    border: 1px solid rgba(7, 25, 66, 0.08);
    border-radius: 24px;
    background: #ffffff;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__step-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__step-pill {
    padding: 8px 11px;
    border-radius: 999px;
    border: 1px solid rgba(7, 25, 66, 0.1);
    background: #ffffff;
    color: rgba(7, 25, 66, 0.64);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__step-pill.is-active {
    border-color: #071942;
    background: #071942;
    color: #ffffff;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__step-pill.is-complete {
    background: #eef3fb;
    color: #071942;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__step-head {
    margin-top: 18px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__step-title {
    margin-top: 6px;
    font-size: 28px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__step-copy {
    margin-top: 10px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
    margin-top: 18px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__option {
    position: relative;
    display: block;
    width: 100%;
    padding: 12px;
    border-radius: 22px;
    border: 1px solid rgba(7, 25, 66, 0.1);
    background: #f8fafd;
    color: #071942;
    text-align: left;
    cursor: pointer;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease, background-color 180ms ease;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__option:hover,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__option:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(7, 25, 66, 0.22);
    box-shadow: 0 14px 28px rgba(7, 25, 66, 0.08);
    outline: none;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__option.is-selected {
    border-color: rgba(7, 25, 66, 0.5);
    background: rgba(44, 66, 120, 0.08);
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__option.is-disabled {
    cursor: not-allowed;
    opacity: 0.55;
    box-shadow: none;
    transform: none;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__option-check {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    border: 1px solid rgba(7, 25, 66, 0.22);
    background: #ffffff;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__option.is-selected .snoozepod-visual-builder__option-check {
    border-color: #071942;
    background: #071942;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__option.is-selected .snoozepod-visual-builder__option-check::after {
    content: '';
    position: absolute;
    inset: 5px;
    border-radius: 999px;
    background: #ffffff;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__media,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__size-visual,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__motion-visual {
    min-height: 148px;
    border-radius: 18px;
    border: 1px solid rgba(7, 25, 66, 0.08);
    background: linear-gradient(180deg, #ffffff 0%, #eef3fb 100%);
    overflow: hidden;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__media {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__media-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 20px;
    color: rgba(7, 25, 66, 0.56);
    font-size: 14px;
    font-weight: 700;
    text-align: center;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__size-visual,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__motion-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__size-bed {
    display: block;
    width: calc(124px * var(--bed-scale, 1));
    max-width: 100%;
    height: 54px;
    border-radius: 18px;
    background: linear-gradient(180deg, #dce7f8 0%, #bdd0ee 100%);
    box-shadow: 0 14px 24px rgba(7, 25, 66, 0.12);
    position: relative;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__size-bed::before {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    top: 10px;
    height: 18px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.8);
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__size-bed::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: -10px;
    height: 10px;
    border-radius: 999px;
    background: rgba(7, 25, 66, 0.1);
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__motion-stage {
    display: grid;
    gap: 12px;
    justify-items: center;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__motion-bed {
    width: 128px;
    height: 52px;
    border-radius: 18px;
    background: linear-gradient(180deg, #dce7f8 0%, #bdd0ee 100%);
    position: relative;
    box-shadow: 0 14px 24px rgba(7, 25, 66, 0.12);
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__motion-bed::before,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__motion-bed::after {
    content: '';
    position: absolute;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: rgba(7, 25, 66, 0.22);
    opacity: 0;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__motion-bed::before {
    left: 50%;
    transform: translateX(-1px);
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__motion-bed::after {
    left: 34%;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__motion-visual--half_split .snoozepod-visual-builder__motion-bed::before,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__motion-visual--full_split .snoozepod-visual-builder__motion-bed::before {
    opacity: 1;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__motion-visual--full_split .snoozepod-visual-builder__motion-bed::after {
    opacity: 1;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__motion-caption {
    color: rgba(7, 25, 66, 0.62);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__option-body {
    display: grid;
    gap: 8px;
    margin-top: 12px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__option-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    color: rgba(7, 25, 66, 0.62);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.35;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__option-title {
    display: block;
    color: #071942;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.15;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__option-copy {
    display: block;
    color: rgba(7, 25, 66, 0.76);
    font-size: 14px;
    line-height: 1.45;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__option-note {
    display: block;
    color: rgba(7, 25, 66, 0.56);
    font-size: 12px;
    line-height: 1.4;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__catalog-empty {
    padding: 16px 18px;
    border-radius: 18px;
    border: 1px dashed rgba(7, 25, 66, 0.18);
    background: #f8fafd;
    color: rgba(7, 25, 66, 0.7);
    font-size: 14px;
    line-height: 1.45;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__review {
    margin-top: 18px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__review-grid {
    display: grid;
    gap: 12px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__review-card {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 12px;
    padding: 12px;
    border: 1px solid rgba(7, 25, 66, 0.08);
    border-radius: 20px;
    background: #f8fafd;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__review-media {
    width: 84px;
    height: 84px;
    border-radius: 16px;
    border: 1px solid rgba(7, 25, 66, 0.08);
    background: linear-gradient(180deg, #ffffff 0%, #eef3fb 100%);
    overflow: hidden;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__review-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__review-media .snoozepod-visual-builder__motion-visual {
    min-height: 100%;
    border: 0;
    background: transparent;
    padding: 0;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__review-media .snoozepod-visual-builder__motion-bed {
    width: 64px;
    height: 30px;
    border-radius: 14px;
    box-shadow: 0 8px 16px rgba(7, 25, 66, 0.12);
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__review-media .snoozepod-visual-builder__motion-caption {
    display: none;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__review-copy {
    display: grid;
    gap: 4px;
    align-content: center;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__review-list,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__summary-list {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__review-list {
    margin-top: 14px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__row {
    display: grid;
    gap: 4px;
    padding: 12px 14px;
    border-radius: 18px;
    border: 1px solid rgba(7, 25, 66, 0.08);
    background: #ffffff;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__row-value {
    margin: 0;
    color: #071942;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.35;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__nav > * {
    flex: 1 1 100%;
    justify-content: center;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__nav .button,
  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__primary {
    min-height: 48px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 800;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__preview {
    display: grid;
    gap: 12px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__preview-empty {
    display: grid;
    gap: 10px;
    min-height: 132px;
    padding: 18px;
    border-radius: 20px;
    border: 1px dashed rgba(7, 25, 66, 0.18);
    background: linear-gradient(180deg, #ffffff 0%, #eef3fb 100%);
    align-content: center;
    color: rgba(7, 25, 66, 0.72);
    font-size: 14px;
    line-height: 1.45;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__preview-pillars {
    display: flex;
    gap: 10px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__preview-pillars span {
    display: block;
    flex: 1 1 0;
    height: 10px;
    border-radius: 999px;
    background: rgba(7, 25, 66, 0.1);
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__preview-card {
    display: grid;
    grid-template-columns: 74px minmax(0, 1fr);
    gap: 12px;
    padding: 12px;
    border-radius: 18px;
    border: 1px solid rgba(7, 25, 66, 0.08);
    background: #f8fafd;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__preview-media {
    width: 74px;
    height: 74px;
    border-radius: 16px;
    border: 1px solid rgba(7, 25, 66, 0.08);
    background: linear-gradient(180deg, #ffffff 0%, #eef3fb 100%);
    overflow: hidden;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__preview-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__preview-copy {
    display: grid;
    gap: 4px;
    align-content: center;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__summary-head {
    margin-top: 18px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__summary-title {
    margin-top: 6px;
    font-size: 24px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__price {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid rgba(7, 25, 66, 0.08);
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__price strong {
    display: block;
    margin-top: 4px;
    color: #071942;
    font-size: 19px;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__next-action {
    margin-top: 16px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__actions {
    display: grid;
    gap: 10px;
    margin-top: 18px;
  }

  .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__primary {
    display: inline-flex;
    align-items: center;
