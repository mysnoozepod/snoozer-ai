</section>

<script>
  (() => {
    const root = document.querySelector('#shopify-section-{{ section.id }} [data-visual-builder]');
    if (!root || root.dataset.builderReady === 'true') return;
    root.dataset.builderReady = 'true';

    const STEP_COPY = {
      size: 'Start with the mattress size so compatible bases and prices stay in sync.',
      base: 'Choose mattress only, or add a base with real product imagery before you move on.',
      motion: 'Motion only appears when you choose the adjustable base path.',
      mattress: 'Compare the mattress lineup with actual product visuals in the size you chose.',
      review: 'Carry the selected size into the mattress page, then confirm the rest inside the inline builder.'
    };

    const STEPS = [
      { key: 'size', label: 'Size', title: 'Choose your size' },
      { key: 'base', label: 'Base', title: 'Choose your base' },
      { key: 'motion', label: 'Motion', title: 'Choose your motion setup' },
      { key: 'mattress', label: 'Mattress', title: 'Choose your mattress' },
      { key: 'review', label: 'Review', title: 'Review your build' }
    ];

    const SIZE_ORDER = ['Twin', 'Twin XL', 'Full', 'Queen', 'King', 'Split King', 'Cal King'];
    const SIZE_SCALE = {
      twin: 0.7,
      'twin xl': 0.72,
      full: 0.84,
      queen: 1,
      king: 1.16,
      'split king': 1.16,
      'cal king': 1.12
    };

    const MOTION_OPTIONS = [
      { key: 'standard', title: 'Standard', subtitle: 'Single motion setup for one surface.', caption: 'Unified' },
      { key: 'half_split', title: 'Half Split', subtitle: 'Split flexibility when the chosen size supports it.', caption: 'Shared split' },
      { key: 'full_split', title: 'Full Split', subtitle: 'Independent split movement when the chosen size allows it.', caption: 'Independent' }
    ];

    const mattresses = parseJson(readJson(root, '[data-visual-builder-mattresses]'), []);
    const baseProducts = parseJson(readJson(root, '[data-visual-builder-bases]'), []);
    const supportedSizes = collectSupportedSizes(mattresses);

    const state = {
      currentStep: 'size',
      size: '',
      base: '',
      motion: '',
      mattress: ''
    };

    const els = {
      stepCount: root.querySelector('[data-vb-step-count]'),
      progress: root.querySelector('[data-vb-progress]'),
      steps: root.querySelector('[data-vb-steps]'),
      stepLabel: root.querySelector('[data-vb-step-label]'),
      stepTitle: root.querySelector('[data-vb-step-title]'),
      stepCopy: root.querySelector('[data-vb-step-copy]'),
      options: root.querySelector('[data-vb-options]'),
      review: root.querySelector('[data-vb-review]'),
      reviewGrid: root.querySelector('[data-vb-review-grid]'),
      reviewList: root.querySelector('[data-vb-review-list]'),
      reviewNote: root.querySelector('[data-vb-review-note]'),
      summary: root.querySelector('[data-vb-summary]'),
      preview: root.querySelector('[data-vb-preview]'),
      priceLabel: root.querySelector('[data-vb-price-label]'),
      price: root.querySelector('[data-vb-price]'),
      nextAction: root.querySelector('[data-vb-next-action]'),
      primary: root.querySelector('[data-vb-primary]'),
      back: root.querySelector('[data-vb-back]'),
      next: root.querySelector('[data-vb-next]'),
      reset: root.querySelector('[data-vb-reset]')
    };

    function readJson(scope, selector) {
      const node = scope.querySelector(selector);
      return node ? node.textContent : '[]';
    }

    function parseJson(text, fallback) {
      try {
        return JSON.parse(text);
      } catch (error) {
        return fallback;
      }
    }

    function escapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function normalizeText(value) {
      return String(value == null ? '' : value)
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();
    }

    function normalizeSizeKey(size) {
      const value = normalizeText(size);
      if (value === 'twin x l') return 'twin xl';
      if (value === 'california king' || value === 'cal king') return 'cal king';
      return value;
    }

    function sizeAliases(size) {
      switch (normalizeSizeKey(size)) {
        case 'twin':
          return ['twin'];
        case 'twin xl':
          return ['twin xl', 'twin x l'];
        case 'full':
          return ['full', 'double'];
        case 'queen':
          return ['queen', 'queen 2pc', 'queen two pc'];
        case 'king':
          return ['king', 'king 2pc', 'king two pc'];
        case 'split king':
          return ['split king', 'king 2pc'];
        case 'cal king':
          return ['cal king', 'california king', 'cal king 2pc'];
        default:
          return [normalizeSizeKey(size)];
      }
    }

    function motionAliases(key) {
      if (key === 'half_split') return ['half split', 'split head'];
      if (key === 'full_split') return ['full split'];
      return ['standard', 'one piece', 'single'];
    }

    function variantTextParts(variant) {
      return [variant && variant.title, variant && variant.option1, variant && variant.option2, variant && variant.option3]
        .filter(Boolean)
        .map(normalizeText);
    }

    function variantMatchScore(variant, size) {
      const aliases = sizeAliases(size);
      const parts = variantTextParts(variant);
      let score = 0;

      aliases.forEach((alias, aliasIndex) => {
        parts.forEach((part) => {
          if (part === alias) {
            score = Math.max(score, aliasIndex === 0 ? 4 : 3);
          } else if (part.includes(alias) || alias.includes(part)) {
            score = Math.max(score, 2);
          }
        });
      });

      return score;
    }

    function motionMatchScore(variant, key) {
      const aliases = motionAliases(key);
      const parts = variantTextParts(variant);
      let score = 0;
      aliases.forEach((alias) => {
        parts.forEach((part) => {
          if (part === alias) score = Math.max(score, 3);
          else if (part.includes(alias) || alias.includes(part)) score = Math.max(score, 2);
        });
      });
      return score;
    }

    function parsePriceCents(value) {
      if (typeof value === 'number') return Number.isFinite(value) ? value : 0;
      const cleaned = String(value == null ? '' : value).replace(/[^0-9.-]/g, '');
      if (!cleaned) return 0;
      const numeric = Number(cleaned);
      if (!Number.isFinite(numeric)) return 0;
      return cleaned.includes('.') ? Math.round(numeric * 100) : numeric;
    }

    function formatMoney(cents) {
      const amount = parsePriceCents(cents) / 100;
      try {
        return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(amount);
      } catch (error) {
        return '$' + amount.toFixed(2);
      }
    }

    function firstAvailableVariant(product) {
      const variants = Array.isArray(product && product.variants) ? product.variants : [];
      return variants.find((variant) => variant && variant.available !== false) || variants[0] || null;
    }

    function findVariantForSize(product, size) {
      if (!product || !size) return null;
      const variants = Array.isArray(product.variants) ? product.variants : [];
      let best = null;
      let bestScore = 0;

      variants.forEach((variant) => {
        const score = variantMatchScore(variant, size);
        if (!score) return;

        const rank = score + (variant && variant.available !== false ? 0.5 : 0);
        if (!best || rank > bestScore) {
          best = variant;
          bestScore = rank;
        }
      });

      return best;
    }

    function resolveBaseVariant(product, size, motionKey) {
      const sizeVariant = findVariantForSize(product, size);
      if (!product || !product.isAdjustable || !sizeVariant || !motionKey) {
        return { variant: sizeVariant, exactMotionMatch: Boolean(sizeVariant) };
      }

      const variants = Array.isArray(product.variants) ? product.variants : [];
      let best = null;
      let bestScore = 0;

      variants.forEach((variant) => {
        const sizeScore = variantMatchScore(variant, size);
        const motionScore = motionMatchScore(variant, motionKey);
        if (!sizeScore || !motionScore) return;

        const rank = sizeScore + motionScore + (variant && variant.available !== false ? 0.5 : 0);
        if (!best || rank > bestScore) {
          best = variant;
          bestScore = rank;
        }
      });

      return {
        variant: best || sizeVariant,
        exactMotionMatch: Boolean(best)
      };
    }

    function findCanonicalSizeFromVariant(variant) {
      const parts = variantTextParts(variant);
      for (let index = 0; index < SIZE_ORDER.length; index += 1) {
        const size = SIZE_ORDER[index];
        const aliases = sizeAliases(size);
        const matched = aliases.some((alias) => {
          return parts.some((part) => part === alias || part.includes(alias) || alias.includes(part));
        });
        if (matched) return size;
      }
      return '';
    }

    function collectSupportedSizes(products) {
      const seen = new Set();
      const found = [];

      (products || []).forEach((product) => {
        (product.variants || []).forEach((variant) => {
          const size = findCanonicalSizeFromVariant(variant);
          if (!size || seen.has(size)) return;
          seen.add(size);
          found.push(size);
        });
      });

      const ordered = SIZE_ORDER.filter((size) => seen.has(size));
      found.forEach((size) => {
        if (ordered.indexOf(size) === -1) ordered.push(size);
      });

      return ordered;
    }

    function allowedMotionOptionsForSize(size) {
      const normalized = normalizeSizeKey(size);
      if (normalized === 'king' || normalized === 'split king') return MOTION_OPTIONS;
      if (normalized === 'queen') {
        return MOTION_OPTIONS.filter((option) => option.key !== 'full_split');
      }
      return MOTION_OPTIONS.filter((option) => option.key === 'standard');
    }

    function visibleSteps() {
      return STEPS.filter((step) => step.key !== 'motion' || isAdjustableBaseSelection());
    }

    function isAdjustableBaseSelection() {
      const base = getSelectedBaseProduct();
      return Boolean(base && base.isAdjustable);
    }

    function getSelectedBaseProduct() {
      return baseProducts.find((product) => product.handle === state.base) || null;
    }

    function getSelectedMattressProduct() {
      return mattresses.find((product) => product.handle === state.mattress) || null;
    }

    function getSelectedMotion() {
      return MOTION_OPTIONS.find((option) => option.key === state.motion) || null;
    }

    function sizeScale(size) {
      return SIZE_SCALE[normalizeSizeKey(size)] || 1;
    }

    function baseOptions() {
      return [
        {
          kind: 'system',
          handle: 'mattress-only',
          title: 'Mattress only',
          descriptor: 'Skip the base for now and stay focused on the mattress.',
          available: true
        }
      ].concat(baseProducts);
    }

    function mattressOptionsForSize() {
      return mattresses.map((product) => {
        const variant = findVariantForSize(product, state.size);
        return Object.assign({}, product, {
          matchedVariant: variant,
          unavailableForSize: !variant
        });
      });
    }

    function canProceed(stepKey) {
      if (stepKey === 'review') return true;
      if (stepKey === 'size') return Boolean(state.size);
      if (stepKey === 'base') return Boolean(state.base);
      if (stepKey === 'motion') return Boolean(state.motion);
      if (stepKey === 'mattress') return Boolean(state.mattress);
      return false;
    }

    function summaryRows() {
      const mattressProduct = getSelectedMattressProduct();
      const mattressVariant = mattressProduct ? findVariantForSize(mattressProduct, state.size) : null;
      const baseProduct = getSelectedBaseProduct();
      const baseVariantResult = baseProduct ? resolveBaseVariant(baseProduct, state.size, state.motion) : null;
      const motionOption = getSelectedMotion();
      const rows = [
        { term: 'Size', value: state.size || 'Choose size' },
        {
          term: 'Base',
        value: !state.base
            ? 'Choose base'
            : state.base === 'mattress-only'
              ? 'Mattress only'
              : baseProduct
                ? baseProduct.title + basePriceSuffix(baseProduct, baseVariantResult)
                : 'Choose base'
        }
      ];

      if (isAdjustableBaseSelection()) {
        rows.push({
          term: 'Motion',
          value: motionOption ? motionOption.title : 'Choose motion'
        });
      }

      rows.push({
        term: 'Mattress',
        value: mattressProduct
          ? mattressProduct.title + (mattressVariant ? ' / ' + formatMoney(mattressVariant.price) : priceMinSuffix(mattressProduct))
          : 'Choose mattress'
      });

      return rows;
    }

    function priceMinSuffix(product) {
      const cents = parsePriceCents(product && product.priceMin);
      return cents ? ' / From ' + formatMoney(cents) : '';
    }

    function basePriceSuffix(product, resolved) {
      if (!product) return '';
      if (product.isAdjustable) {
        return parsePriceCents(product.priceMin) ? ' / From ' + formatMoney(product.priceMin) : '';
      }
      if (resolved && resolved.variant) {
        return ' / ' + formatMoney(resolved.variant.price);
      }
      return priceMinSuffix(product);
    }

    function previewCards() {
      const cards = [];
      const baseProduct = getSelectedBaseProduct();
      const mattressProduct = getSelectedMattressProduct();

      if (mattressProduct) {
        cards.push({
          label: 'Mattress',
          title: mattressProduct.title,
          copy: mattressProduct.descriptor || 'Selected for the chosen size.',
          image: mattressProduct.image,
          imageAlt: mattressProduct.imageAlt || mattressProduct.title
        });
      }

      if (baseProduct) {
        cards.push({
          label: 'Base',
          title: baseProduct.title,
          copy: baseProduct.typeLabel || 'Selected base',
          image: baseProduct.image,
          imageAlt: baseProduct.imageAlt || baseProduct.title
        });
      }

      return cards;
    }

    function reviewCards() {
      const cards = previewCards();
      if (isAdjustableBaseSelection() && state.motion) {
        const motionOption = getSelectedMotion();
        cards.push({
          label: 'Motion',
          title: motionOption ? motionOption.title : 'Motion',
          copy: motionOption ? motionOption.subtitle : 'Selected motion direction.',
          image: '',
          imageAlt: ''
        });
      }
      return cards;
    }

    function priceState() {
      const mattressProduct = getSelectedMattressProduct();
      const mattressVariant = mattressProduct ? findVariantForSize(mattressProduct, state.size) : null;
      const baseProduct = getSelectedBaseProduct();
      const baseResult = baseProduct ? resolveBaseVariant(baseProduct, state.size, state.motion) : null;

      if (!mattressProduct || !mattressVariant) {
        return {
          label: 'Estimated total',
          value: 'Select a mattress to see pricing',
          exact: false
        };
      }

      if (!baseProduct) {
        return {
          label: 'Estimated total',
          value: formatMoney(mattressVariant.price),
          exact: true
        };
      }

      if (baseProduct.isAdjustable) {
        return {
          label: 'Selected prices',
          value: formatMoney(mattressVariant.price) + ' mattress + adjustable base pricing confirmed on the product page',
          exact: false
        };
      }

      if (!baseResult || !baseResult.variant) {
        return {
          label: 'Selected prices',
          value: formatMoney(mattressVariant.price) + ' mattress + base pricing confirmed on the product page',
          exact: false
        };
      }

      return {
        label: 'Estimated total',
        value: formatMoney(parsePriceCents(mattressVariant.price) + parsePriceCents(baseResult.variant.price)),
        exact: true
      };
    }

    function nextActionText(stepKey) {
      if (!state.size) return 'Choose a size to start the build.';
      if (stepKey === 'size') return 'Next: choose the base path.';
      if (!state.base) return 'Choose a base before you continue.';
      if (stepKey === 'base' && isAdjustableBaseSelection()) return 'Next: choose the motion setup.';
      if (isAdjustableBaseSelection() && !state.motion) return 'Choose the motion setup before you continue.';
      if (!state.mattress) return 'Choose a mattress to unlock the review step.';
      if (stepKey === 'review') {
        return 'Size carries into the mattress page. Base and motion are confirmed there inside the inline builder.';
      }
      return 'Review the build, then continue into the mattress page.';
    }

    function primaryLinkState() {
      const mattressProduct = getSelectedMattressProduct();
      const mattressVariant = mattressProduct ? findVariantForSize(mattressProduct, state.size) : null;
      if (!mattressProduct || !mattressVariant || state.currentStep !== 'review') {
        return {
          href: '#',
          label: 'Continue to Mattress',
          enabled: false
        };
      }

      return {
        href: mattressProduct.url + '?variant=' + encodeURIComponent(String(mattressVariant.id)) + '#pod-builder',
        label: 'Continue to ' + mattressProduct.title,
        enabled: true
      };
    }

    function renderStepPills(stepList) {
      const currentIndex = stepList.findIndex((step) => step.key === state.currentStep);
      els.steps.innerHTML = stepList.map((step, index) => {
        const classes = ['snoozepod-visual-builder__step-pill'];
        if (step.key === state.currentStep) classes.push('is-active');
        else if (index < currentIndex) classes.push('is-complete');
        return '<span class="' + classes.join(' ') + '">' + escapeHtml(step.label) + '</span>';
      }).join('');
    }

    function renderSizeOptions() {
      return supportedSizes.map((size) => {
        const selected = state.size === size;
        return (
          '<button type="button" class="snoozepod-visual-builder__option snoozepod-visual-builder__option--size' +
          (selected ? ' is-selected' : '') +
          '" data-builder-option data-step="size" data-value="' + escapeHtml(size) + '">' +
          '<span class="snoozepod-visual-builder__size-visual"><span class="snoozepod-visual-builder__size-bed" style="--bed-scale:' + sizeScale(size) + ';"></span></span>' +
          '<span class="snoozepod-visual-builder__option-body">' +
          '<span class="snoozepod-visual-builder__option-title">' + escapeHtml(size) + '</span>' +
          '<span class="snoozepod-visual-builder__option-copy">Carry this size into mattress and base pricing.</span>' +
          '</span>' +
          '<span class="snoozepod-visual-builder__option-check" aria-hidden="true"></span>' +
          '</button>'
        );
      }).join('');
    }

    function renderBaseOptions() {
      return baseOptions().map((option) => {
        const selected = state.base === option.handle;
        const isSystem = option.kind === 'system';
        const mediaMarkup = isSystem
          ? '<span class="snoozepod-visual-builder__size-visual"><span class="snoozepod-visual-builder__size-bed" style="--bed-scale:0.92;"></span></span>'
          : (
              '<span class="snoozepod-visual-builder__media">' +
              (option.image
                ? '<img src="' + escapeHtml(option.image) + '" alt="' + escapeHtml(option.imageAlt || option.title) + '" loading="lazy">'
                : '<span class="snoozepod-visual-builder__media-fallback">' + escapeHtml(option.title) + '</span>') +
              '</span>'
            );
        const priceText = !isSystem && parsePriceCents(option.priceMin) ? 'From ' + formatMoney(option.priceMin) : '';
        const descriptor = isSystem ? option.descriptor : (option.typeLabel || 'Base');

        return (
          '<button type="button" class="snoozepod-visual-builder__option' + (selected ? ' is-selected' : '') + '" data-builder-option data-step="base" data-value="' + escapeHtml(option.handle) + '">' +
          mediaMarkup +
          '<span class="snoozepod-visual-builder__option-body">' +
          '<span class="snoozepod-visual-builder__option-meta">' +
          (descriptor ? '<span>' + escapeHtml(descriptor) + '</span>' : '') +
          (priceText ? '<span>' + escapeHtml(priceText) + '</span>' : '') +
          '</span>' +
          '<span class="snoozepod-visual-builder__option-title">' + escapeHtml(option.title) + '</span>' +
          '<span class="snoozepod-visual-builder__option-copy">' + escapeHtml(isSystem ? option.descriptor : 'Use this base path with the selected mattress size.') + '</span>' +
          '</span>' +
          '<span class="snoozepod-visual-builder__option-check" aria-hidden="true"></span>' +
          '</button>'
        );
      }).join('');
    }

    function renderMotionOptions() {
      const allowedKeys = allowedMotionOptionsForSize(state.size).map((option) => option.key);
      return MOTION_OPTIONS.map((option) => {
        const selected = state.motion === option.key;
        const disabled = allowedKeys.indexOf(option.key) === -1;
        return (
          '<button type="button" class="snoozepod-visual-builder__option' +
          (selected ? ' is-selected' : '') +
          (disabled ? ' is-disabled' : '') +
          '" data-builder-option data-step="motion" data-value="' + escapeHtml(option.key) + '"' +
          (disabled ? ' aria-disabled="true"' : '') +
          '>' +
          '<span class="snoozepod-visual-builder__motion-visual snoozepod-visual-builder__motion-visual--' + escapeHtml(option.key) + '">' +
          '<span class="snoozepod-visual-builder__motion-stage">' +
          '<span class="snoozepod-visual-builder__motion-bed"></span>' +
          '<span class="snoozepod-visual-builder__motion-caption">' + escapeHtml(option.caption) + '</span>' +
          '</span></span>' +
          '<span class="snoozepod-visual-builder__option-body">' +
          '<span class="snoozepod-visual-builder__option-title">' + escapeHtml(option.title) + '</span>' +
          '<span class="snoozepod-visual-builder__option-copy">' + escapeHtml(option.subtitle) + '</span>' +
          (disabled ? '<span class="snoozepod-visual-builder__option-note">Unavailable for the selected size.</span>' : '') +
          '</span>' +
          '<span class="snoozepod-visual-builder__option-check" aria-hidden="true"></span>' +
          '</button>'
        );
      }).join('');
    }

    function renderMattressOptions() {
      const options = mattressOptionsForSize();
      const availableCount = options.filter((option) => !option.unavailableForSize).length;
      if (!availableCount) {
        return '<div class="snoozepod-visual-builder__catalog-empty">No mattresses are available for the chosen size yet.</div>';
      }

      return options.map((option) => {
        const selected = state.mattress === option.handle;
        const disabled = option.unavailableForSize || option.available === false;
        const priceText = option.matchedVariant ? formatMoney(option.matchedVariant.price) : ('From ' + formatMoney(option.priceMin));

        return (
          '<button type="button" class="snoozepod-visual-builder__option' +
          (selected ? ' is-selected' : '') +
          (disabled ? ' is-disabled' : '') +
          '" data-builder-option data-step="mattress" data-value="' + escapeHtml(option.handle) + '"' +
          (disabled ? ' aria-disabled="true"' : '') +
          '>' +
          '<span class="snoozepod-visual-builder__media">' +
          (option.image
            ? '<img src="' + escapeHtml(option.image) + '" alt="' + escapeHtml(option.imageAlt || option.title) + '" loading="lazy">'
            : '<span class="snoozepod-visual-builder__media-fallback">' + escapeHtml(option.title) + '</span>') +
          '</span>' +
          '<span class="snoozepod-visual-builder__option-body">' +
          '<span class="snoozepod-visual-builder__option-meta">' +
          '<span>' + escapeHtml(priceText) + '</span>' +
          '</span>' +
          '<span class="snoozepod-visual-builder__option-title">' + escapeHtml(option.title) + '</span>' +
          '<span class="snoozepod-visual-builder__option-copy">' + escapeHtml(option.descriptor || 'Compare this mattress in the selected size.') + '</span>' +
          (disabled ? '<span class="snoozepod-visual-builder__option-note">Unavailable in ' + escapeHtml(state.size) + '.</span>' : '') +
          '</span>' +
          '<span class="snoozepod-visual-builder__option-check" aria-hidden="true"></span>' +
          '</button>'
        );
      }).join('');
    }

    function renderOptions(stepKey) {
      if (stepKey === 'size') {
        els.options.innerHTML = renderSizeOptions();
        return;
      }
      if (stepKey === 'base') {
        els.options.innerHTML = renderBaseOptions();
        return;
      }
      if (stepKey === 'motion') {
        els.options.innerHTML = renderMotionOptions();
        return;
      }
      if (stepKey === 'mattress') {
        els.options.innerHTML = renderMattressOptions();
        return;
      }
      els.options.innerHTML = '';
    }

    function renderPreview() {
      const cards = previewCards();
      if (!cards.length) {
        els.preview.innerHTML =
          '<div class="snoozepod-visual-builder__preview-empty">' +
          '<div class="snoozepod-visual-builder__preview-pillars"><span></span><span></span><span></span></div>' +
          '<div>Choose a size, base, and mattress to build a visual summary here.</div>' +
          '</div>';
        return;
      }

      els.preview.innerHTML = cards.map((card) => {
        return (
          '<div class="snoozepod-visual-builder__preview-card">' +
          '<div class="snoozepod-visual-builder__preview-media">' +
          (card.image
            ? '<img src="' + escapeHtml(card.image) + '" alt="' + escapeHtml(card.imageAlt || card.title) + '" loading="lazy">'
            : '<span class="snoozepod-visual-builder__media-fallback">' + escapeHtml(card.label) + '</span>') +
          '</div>' +
          '<div class="snoozepod-visual-builder__preview-copy">' +
          '<span class="snoozepod-visual-builder__summary-label">' + escapeHtml(card.label) + '</span>' +
          '<span class="snoozepod-visual-builder__option-title">' + escapeHtml(card.title) + '</span>' +
          '<span class="snoozepod-visual-builder__option-copy">' + escapeHtml(card.copy) + '</span>' +
          '</div></div>'
        );
      }).join('');
    }

    function renderSummary() {
      const rows = summaryRows();
      els.summary.innerHTML = rows.map((row) => {
        return (
          '<div class="snoozepod-visual-builder__row">' +
          '<dt class="snoozepod-visual-builder__row-term">' + escapeHtml(row.term) + '</dt>' +
          '<dd class="snoozepod-visual-builder__row-value">' + escapeHtml(row.value) + '</dd>' +
          '</div>'
        );
      }).join('');

      els.reviewList.innerHTML = els.summary.innerHTML;
    }

    function renderReview() {
      const cards = reviewCards();
      els.reviewGrid.innerHTML = cards.map((card) => {
        const isMotionCard = !card.image;
        return (
          '<div class="snoozepod-visual-builder__review-card">' +
          '<div class="snoozepod-visual-builder__review-media">' +
          (isMotionCard
            ? '<div class="snoozepod-visual-builder__motion-visual snoozepod-visual-builder__motion-visual--' + escapeHtml(state.motion || 'standard') + '">' +
              '<span class="snoozepod-visual-builder__motion-stage"><span class="snoozepod-visual-builder__motion-bed"></span></span></div>'
            : '<img src="' + escapeHtml(card.image) + '" alt="' + escapeHtml(card.imageAlt || card.title) + '" loading="lazy">') +
          '</div>' +
          '<div class="snoozepod-visual-builder__review-copy">' +
          '<span class="snoozepod-visual-builder__summary-label">' + escapeHtml(card.label) + '</span>' +
          '<span class="snoozepod-visual-builder__option-title">' + escapeHtml(card.title) + '</span>' +
          '<span class="snoozepod-visual-builder__option-copy">' + escapeHtml(card.copy) + '</span>' +
          '</div></div>'
        );
      }).join('');

      els.reviewNote.textContent = 'Size is preserved in the mattress link below. Base and motion are confirmed on the mattress page inside the inline builder.';
    }

    function renderPricing() {
      const pricing = priceState();
      els.priceLabel.textContent = pricing.label;
      els.price.textContent = pricing.value;
    }

    function renderPrimaryAction() {
      const primary = primaryLinkState();
      els.primary.textContent = primary.label;
      els.primary.href = primary.href;
      els.primary.classList.toggle('is-disabled', !primary.enabled);
      els.primary.setAttribute('aria-disabled', primary.enabled ? 'false' : 'true');
    }

    function setValue(stepKey, value) {
      state[stepKey] = value;

      if (stepKey === 'size') {
        const mattressProduct = getSelectedMattressProduct();
        if (mattressProduct && !findVariantForSize(mattressProduct, value)) {
          state.mattress = '';
        }

        const allowedMotionKeys = allowedMotionOptionsForSize(value).map((option) => option.key);
        if (state.motion && allowedMotionKeys.indexOf(state.motion) === -1) {
          state.motion = '';
        }
      }

      if (stepKey === 'base' && !isAdjustableBaseSelection()) {
        state.motion = '';
        if (state.currentStep === 'motion') {
          state.currentStep = 'mattress';
        }
      }
    }

    function render() {
      const stepList = visibleSteps();
      if (!stepList.some((step) => step.key === state.currentStep)) {
        state.currentStep = stepList[0].key;
      }

      const currentIndex = stepList.findIndex((step) => step.key === state.currentStep);
      const currentStep = stepList[currentIndex];

      els.stepCount.textContent = 'Step ' + (currentIndex + 1) + ' of ' + stepList.length;
      els.progress.style.width = (((currentIndex + 1) / stepList.length) * 100) + '%';
      els.stepLabel.textContent = currentStep.label;
      els.stepTitle.textContent = currentStep.title;
      els.stepCopy.textContent = STEP_COPY[currentStep.key];
      els.nextAction.textContent = nextActionText(currentStep.key);

      renderStepPills(stepList);
      renderOptions(currentStep.key);
      renderPreview();
      renderSummary();
      renderReview();
      renderPricing();
      renderPrimaryAction();

      const reviewing = currentStep.key === 'review';
      els.review.hidden = !reviewing;
      els.options.hidden = reviewing;
      els.next.hidden = reviewing;
      els.back.disabled = currentIndex === 0;

      if (!reviewing) {
        const nextStep = stepList[currentIndex + 1];
        els.next.disabled = !canProceed(currentStep.key);
        els.next.textContent = nextStep && nextStep.key === 'review' ? 'Review Build' : 'Next';
      }
    }

    root.addEventListener('click', (event) => {
      const optionButton = event.target.closest('[data-builder-option]');
      if (optionButton) {
        if (optionButton.classList.contains('is-disabled')) return;
        setValue(optionButton.getAttribute('data-step'), optionButton.getAttribute('data-value'));
        render();
        return;
      }

      if (event.target.closest('[data-vb-back]')) {
        const stepList = visibleSteps();
        const currentIndex = stepList.findIndex((step) => step.key === state.currentStep);
        if (currentIndex > 0) {
          state.currentStep = stepList[currentIndex - 1].key;
          render();
        }
        return;
      }

      if (event.target.closest('[data-vb-next]')) {
        const stepList = visibleSteps();
        const currentIndex = stepList.findIndex((step) => step.key === state.currentStep);
        const currentStep = stepList[currentIndex];
        if (!canProceed(currentStep.key)) return;
        if (stepList[currentIndex + 1]) {
          state.currentStep = stepList[currentIndex + 1].key;
          render();
        }
        return;
      }

      if (event.target.closest('[data-vb-reset]')) {
        state.currentStep = 'size';
        state.size = '';
        state.base = '';
        state.motion = '';
        state.mattress = '';
        render();
      }
    });

    render();
  })();
</script>

{% schema %}
{
  "name": "SnoozePod final CTA",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
