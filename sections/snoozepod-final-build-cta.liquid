      <div class="snoozepod-visual-builder__frame" data-visual-builder>
        <script type="application/json" data-visual-builder-mattresses>[{{ mattress_catalog }}]</script>
        <script type="application/json" data-visual-builder-bases>[{{ base_catalog }}]</script>

        <div class="snoozepod-visual-builder__header">
          <div>
            <p class="snoozepod-visual-builder__eyebrow">Visual guided build</p>
            <h2 class="snoozepod-visual-builder__heading">{{ section.settings.heading | escape }}</h2>
            <p class="snoozepod-visual-builder__subheading">{{ section.settings.subheading | escape }}</p>
          </div>
          <div class="snoozepod-visual-builder__step-chip" data-vb-step-count>Step 1 of 4</div>
