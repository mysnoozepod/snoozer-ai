    }

    .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__frame {
      padding: 28px 24px;
    }

    .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__nav > * {
      flex: 0 0 auto;
    }
  }

  @media screen and (min-width: 990px) {
    .snoozepod-visual-builder-{{ section.id }} {
      padding-left: 64px;
      padding-right: 64px;
    }

    .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__frame {
      padding: 34px 30px;
    }

    .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }

    .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__layout {
      grid-template-columns: minmax(0, 1.34fr) minmax(320px, 0.76fr);
      gap: 20px;
      align-items: start;
    }

    .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__main,
    .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__summary {
      padding: 24px;
      border-radius: 28px;
    }

    .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__summary {
      position: sticky;
      top: 12px;
    }

    .snoozepod-visual-builder-{{ section.id }} .snoozepod-visual-builder__heading {
