{%- liquid
  assign hero_heading = section.settings.heading_override | strip
  if hero_heading == blank
    assign hero_heading = collection.title
  endif

  assign collection_key = collection.handle | default: collection.title | handleize
  assign hero_body = section.settings.body | strip
  if collection_key contains 'mattress'
    assign hero_body = 'Explore mattress options built around comfort, support, and how you actually rest.'
  elsif collection_key contains 'base'
    assign hero_body = 'Explore bases that add positioning, support, and comfort control to your sleep setup.'
  elsif collection_key contains 'pillow'
    assign hero_body = 'Explore pillows that support alignment, pressure relief, and your nightly sleep position.'
  elsif collection_key contains 'bedding'
    assign hero_body = 'Explore bedding pieces that finish the feel of your sleep environment.'
  elsif collection_key contains 'furniture'
    assign hero_body = 'Explore furniture that completes the room around your sleep setup.'
  endif

  assign hero_image = section.settings.image
  if hero_image == blank and collection.image != blank
    assign hero_image = collection.image
  endif

  assign hero_alt = section.settings.image_alt | strip
  if hero_alt == blank
    if section.settings.image != blank
      assign hero_alt = hero_heading
    elsif collection.image != blank and collection.image.alt != blank
      assign hero_alt = collection.image.alt
    else
      assign hero_alt = hero_heading
    endif
  endif
-%}

{%- style -%}
  .snoozepod-collection-hero-{{ section.id }} {
    max-width: 1480px;
    margin: 16px 16px 8px;
    padding: 18px 18px;
    border-radius: 20px;
    background: #f5f7fb;
  }

  .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    align-items: center;
  }

  .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__grid--single {
    grid-template-columns: 1fr;
  }

  .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__copy {
    min-width: 0;
  }

  .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__eyebrow {
    display: inline-block;
    margin: 0 0 8px;
    color: rgba(7, 25, 66, 0.7);
    font-size: 11px;
    line-height: 1.2;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__heading {
    margin: 0;
    color: #071942;
    font-size: clamp(30px, 9vw, 38px);
    line-height: 1.02;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__body {
    margin: 10px 0 0;
    max-width: 52rem;
    color: rgba(7, 25, 66, 0.75);
    font-size: 15px;
    line-height: 1.35;
  }

  .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__body p {
    margin: 0;
  }

  .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__media {
    overflow: hidden;
    order: 2;
    border-radius: 18px;
    background: linear-gradient(180deg, #f5f7fb 0%, #edf2f9 100%);
  }

  .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__media img {
    display: block;
    width: 100%;
    height: 156px;
    object-fit: cover;
  }

  .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__fallback {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    width: 100%;
    height: 156px;
    padding: 18px;
    background:
      radial-gradient(circle at top right, rgba(44, 66, 120, 0.18), transparent 38%),
      linear-gradient(180deg, #f5f7fb 0%, #edf2f9 100%);
  }

  .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__fallback-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.8);
    color: rgba(7, 25, 66, 0.76);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  @media screen and (min-width: 750px) {
    .snoozepod-collection-hero-{{ section.id }} {
      margin-left: 24px;
      margin-right: 24px;
    }

    .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__heading {
      font-size: 38px;
    }
  }

  @media screen and (min-width: 990px) {
    .snoozepod-collection-hero-{{ section.id }} {
      margin: 22px auto 10px;
      padding: 24px 32px;
      border-radius: 24px;
    }

    .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.72fr);
      gap: 28px;
    }

    .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__media {
      order: 2;
    }

    .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__copy {
      order: 1;
    }

    .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__eyebrow {
      margin-bottom: 10px;
    }

    .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__heading {
      max-width: 680px;
      font-size: 42px;
      line-height: 1;
    }

    .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__body {
      max-width: 680px;
      margin-top: 12px;
      font-size: 16px;
      line-height: 1.35;
    }

    .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__media {
      border-radius: 20px;
    }

    .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__media img,
    .snoozepod-collection-hero-{{ section.id }} .snoozepod-collection-hero__fallback {
      height: 220px;
      max-height: 220px;
    }
  }
{%- endstyle -%}

<section class="section snoozepod-collection-hero-section">
  <div class="snoozepod-collection-hero-{{ section.id }}">
    <div class="snoozepod-collection-hero__grid{% if hero_image == blank %} snoozepod-collection-hero__grid--single{% endif %}">
      {%- if hero_image != blank -%}
        <div class="snoozepod-collection-hero__media">
          {{
            hero_image
            | image_url: width: 1600
            | image_tag:
              widths: '480, 720, 960, 1280, 1600',
              sizes: '(min-width: 990px) calc((100vw - 128px) * 0.53), 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: hero_alt | escape
          }}
        </div>
      {%- endif -%}

      <div class="snoozepod-collection-hero__copy">
        {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
          <p class="snoozepod-collection-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="snoozepod-collection-hero__heading">{{ hero_heading | escape }}</h1>
        {%- if hero_body != blank -%}
          <div class="snoozepod-collection-hero__body rte">
            <p>{{ hero_body | escape }}</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection hero",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Show eyebrow",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SnoozePod Collection"
    },
    {
      "type": "text",
      "id": "heading_override",
      "label": "Heading override"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Explore sleep products built to support your full sleep environment."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image override"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    }
  ],
  "presets": [
    {
      "name": "Collection hero"
    }
  ]
}
{% endschema %}
