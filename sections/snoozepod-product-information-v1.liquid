{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign product_type_key = product.type | handleize
  assign product_category = 'all'
  if product_type_key contains 'mattress'
    assign product_category = 'mattress'
    if product_type_key contains 'protector'
      assign product_category = 'bedding'
    endif
  elsif product_type_key contains 'pillow'
    assign product_category = 'pillow'
  elsif product_type_key contains 'base'
    assign product_category = 'adjustable_base'
  elsif product_type_key contains 'sheet' or product_type_key contains 'bedding' or product_type_key contains 'comforter' or product_type_key contains 'protector' or product_type_key contains 'topper'
    assign product_category = 'bedding'
  elsif product_type_key contains 'headboard' or product_type_key contains 'platform' or product_type_key contains 'furniture'
    assign product_category = 'furniture'
  endif
-%}

{%- style -%}
  .snoozepod-product-information-{{ section.id }} {
    max-width: 1360px;
    margin: 24px auto 40px;
    padding: 0 16px;
  }

  .snoozepod-product-information-{{ section.id }} .snoozepod-product-information__heading {
    margin: 0 0 18px;
    color: #071942;
    font-size: clamp(28px, 6vw, 40px);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .snoozepod-product-information-{{ section.id }} .snoozepod-product-information__items {
    display: grid;
    gap: 12px;
  }

  .snoozepod-product-information-{{ section.id }} .snoozepod-product-information__item {
    overflow: hidden;
    border: 1px solid rgba(7, 25, 66, 0.12);
    border-radius: 18px;
    background: #ffffff;
  }

  .snoozepod-product-information-{{ section.id }} .snoozepod-product-information__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
    padding: 16px 18px;
    color: #071942;
    font-size: 17px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .snoozepod-product-information-{{ section.id }} .snoozepod-product-information__summary::-webkit-details-marker {
    display: none;
  }

  .snoozepod-product-information-{{ section.id }} .snoozepod-product-information__summary::after {
    content: '+';
    flex: 0 0 auto;
    font-size: 24px;
    font-weight: 400;
    line-height: 1;
  }

  .snoozepod-product-information-{{ section.id }} details[open] .snoozepod-product-information__summary::after {
    content: '−';
  }

  .snoozepod-product-information-{{ section.id }} .snoozepod-product-information__content {
    padding: 0 18px 20px;
    color: rgba(7, 25, 66, 0.8);
    font-size: 15px;
    line-height: 1.65;
  }

  .snoozepod-product-information-{{ section.id }} .snoozepod-product-information__content > :first-child {
    margin-top: 0;
  }

  .snoozepod-product-information-{{ section.id }} .snoozepod-product-information__content > :last-child {
    margin-bottom: 0;
  }

  .snoozepod-product-information-{{ section.id }} .snoozepod-product-information__policy-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
  }

  .snoozepod-product-information-{{ section.id }} .snoozepod-product-information__policy-links a {
    color: #071942;
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  @media screen and (min-width: 750px) {
    .snoozepod-product-information-{{ section.id }} {
      padding: 0 32px;
    }

    .snoozepod-product-information-{{ section.id }} .snoozepod-product-information__summary {
      min-height: 68px;
      padding: 18px 24px;
      font-size: 19px;
    }

    .snoozepod-product-information-{{ section.id }} .snoozepod-product-information__content {
      padding: 0 24px 24px;
      font-size: 16px;
    }
  }
{%- endstyle -%}

<section class="section" data-product-category="{{ product_category }}">
  <div class="snoozepod-product-information-{{ section.id }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="snoozepod-product-information__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="snoozepod-product-information__items">
      {%- for block in section.blocks -%}
        {%- liquid
          assign show_block = false
          if block.settings.applies_to == 'all' or block.settings.applies_to == product_category
            assign show_block = true
          endif

          assign has_content = false
          if block.type == 'details' and product.description != blank
            assign has_content = true
          endif
          if block.settings.content != blank
            assign has_content = true
          endif
          if block.type == 'delivery_returns'
            if shop.shipping_policy.url != blank or shop.refund_policy.url != blank
              assign has_content = true
            endif
          endif
        -%}

        {%- if show_block and has_content -%}
          <details class="snoozepod-product-information__item" {{ block.shopify_attributes }}>
            <summary class="snoozepod-product-information__summary">
              <span>{{ block.settings.heading | escape }}</span>
            </summary>
            <div class="snoozepod-product-information__content rte">
              {%- if block.type == 'details' and product.description != blank -%}
                {{ product.description }}
              {%- endif -%}
              {%- if block.settings.content != blank -%}
                {{ block.settings.content }}
              {%- endif -%}
              {%- if block.type == 'delivery_returns' -%}
                <div class="snoozepod-product-information__policy-links">
                  {%- if shop.shipping_policy.url != blank -%}
                    <a href="{{ shop.shipping_policy.url }}">Shipping policy</a>
                  {%- endif -%}
                  {%- if shop.refund_policy.url != blank -%}
                    <a href="{{ shop.refund_policy.url }}">Return policy</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </details>
        {%- elsif request.design_mode and show_block and section.settings.show_editor_placeholders -%}
          <div class="snoozepod-data-placeholder" {{ block.shopify_attributes }}>
            Theme editor preview only: {{ block.settings.heading | escape }} is hidden until Ty-approved content is connected.
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
