{%- liquid
  assign suppress_category_navigation = false
  assign navigation_heading = section.settings.heading
  if collection.handle == 'mattresses' or collection.handle == 'adjustable-bases'
    assign suppress_category_navigation = true
    assign visible_collection_count = 0
  endif

  assign mapped_collections = collection.metafields.custom.category_navigation.value
  unless suppress_category_navigation
    assign visible_collection_count = 0
    if mapped_collections != blank
      assign visible_collection_count = mapped_collections.size
    else
      for block in section.blocks
        if block.settings.collection != blank
          assign visible_collection_count = visible_collection_count | plus: 1
        endif
      endfor
    endif
  endunless
-%}

{%- style -%}
  .snoozepod-collection-navigation-{{ section.id }} {
    max-width: 1480px;
    margin: 20px auto 32px;
    padding: 0 16px;
  }

  .snoozepod-collection-navigation-{{ section.id }} .snoozepod-collection-navigation__heading {
    margin: 0 0 16px;
    color: #071942;
    font-size: clamp(26px, 6vw, 36px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .snoozepod-collection-navigation-{{ section.id }} .snoozepod-collection-navigation__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .snoozepod-collection-navigation-{{ section.id }} .snoozepod-collection-navigation__card {
    position: relative;
    overflow: hidden;
    min-height: 132px;
    border: 1px solid rgba(7, 25, 66, 0.1);
    border-radius: 18px;
    background: #f5f7fb;
  }

  .snoozepod-collection-navigation-{{ section.id }} .snoozepod-collection-navigation__card img {
    display: block;
    width: 100%;
    height: 132px;
    object-fit: cover;
  }

  .snoozepod-collection-navigation-{{ section.id }} .snoozepod-collection-navigation__fallback {
    min-height: 132px;
    background:
      radial-gradient(circle at top right, rgba(44, 66, 120, 0.15), transparent 42%),
      linear-gradient(180deg, #f7f9fc 0%, #edf2f9 100%);
  }

  .snoozepod-collection-navigation-{{ section.id }} .snoozepod-collection-navigation__link {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 16px;
    background: linear-gradient(180deg, transparent 30%, rgba(7, 25, 66, 0.78) 100%);
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.15;
    text-decoration: none;
  }

  .snoozepod-collection-navigation-{{ section.id }} .snoozepod-collection-navigation__link:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: -5px;
  }

  @media screen and (min-width: 750px) {
    .snoozepod-collection-navigation-{{ section.id }} {
      padding: 0 32px;
    }

    .snoozepod-collection-navigation-{{ section.id }} .snoozepod-collection-navigation__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
    }

    .snoozepod-collection-navigation-{{ section.id }} .snoozepod-collection-navigation__card,
    .snoozepod-collection-navigation-{{ section.id }} .snoozepod-collection-navigation__card img,
    .snoozepod-collection-navigation-{{ section.id }} .snoozepod-collection-navigation__fallback {
      min-height: 190px;
      height: 190px;
    }

    .snoozepod-collection-navigation-{{ section.id }} .snoozepod-collection-navigation__link {
      padding: 20px;
      font-size: 18px;
    }
  }
{%- endstyle -%}

{%- if visible_collection_count > 0 or request.design_mode -%}
  <section class="section">
    <div class="snoozepod-collection-navigation-{{ section.id }}">
      {%- if navigation_heading != blank -%}
        <h2 class="snoozepod-collection-navigation__heading">{{ navigation_heading | escape }}</h2>
      {%- endif -%}

      {%- if visible_collection_count > 0 -%}
        <div class="snoozepod-collection-navigation__grid">
          {%- if mapped_collections != blank -%}
            {%- for navigation_collection in mapped_collections -%}
              {% render 'snoozepod-collection-navigation-card', navigation_collection: navigation_collection %}
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              {% render 'snoozepod-collection-navigation-card',
                navigation_collection: block.settings.collection,
                navigation_attributes: block.shopify_attributes
              %}
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- elsif request.design_mode -%}
        <div class="snoozepod-data-placeholder" role="note">
          Theme editor preview only: Choose actual Shopify collections to display category navigation.
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Shop by category v1",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "limit": 12,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category v1",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
