{%- style -%}
  .snoozepod-page-content-{{ section.id }} {
    max-width: 1040px;
    margin: 32px auto;
    padding: 0 20px;
  }

  .snoozepod-page-content-{{ section.id }} .snoozepod-page-content__card {
    padding: 28px 20px;
    border-radius: 28px;
    background: #ffffff;
    border: 1px solid rgba(7, 25, 66, 0.08);
    box-shadow: 0 18px 36px rgba(7, 25, 66, 0.04);
  }

  .snoozepod-page-content-{{ section.id }} .support-page-richtext,
  .snoozepod-page-content-{{ section.id }} .support-page-note {
    color: rgba(7, 25, 66, 0.86);
    font-size: 17px;
    line-height: 1.65;
  }

  .snoozepod-page-content-{{ section.id }} .support-page-richtext > *:first-child,
  .snoozepod-page-content-{{ section.id }} .support-page-note > *:first-child {
    margin-top: 0;
  }

  .snoozepod-page-content-{{ section.id }} .support-page-richtext > *:last-child,
  .snoozepod-page-content-{{ section.id }} .support-page-note > *:last-child {
    margin-bottom: 0;
  }

  .snoozepod-page-content-{{ section.id }} .support-page-richtext h1,
  .snoozepod-page-content-{{ section.id }} .support-page-richtext h2,
  .snoozepod-page-content-{{ section.id }} .support-page-richtext h3,
  .snoozepod-page-content-{{ section.id }} .support-page-richtext h4 {
    color: #071942;
    line-height: 1.2;
  }

  .snoozepod-page-content-{{ section.id }} .support-page-richtext h2 {
    margin-top: 0;
    font-size: 30px;
    letter-spacing: -0.03em;
  }

  .snoozepod-page-content-{{ section.id }} .support-page-richtext h3 {
    font-size: 22px;
    letter-spacing: -0.02em;
  }

  .snoozepod-page-content-{{ section.id }} .support-page-faq {
    display: grid;
    gap: 14px;
  }

  .snoozepod-page-content-{{ section.id }} .support-page-faq__item {
    border: 1px solid rgba(7, 25, 66, 0.08);
    border-radius: 22px;
    background: #f8fafe;
    overflow: hidden;
  }

  .snoozepod-page-content-{{ section.id }} .support-page-faq__item summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px;
    cursor: pointer;
    color: #071942;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
  }

  .snoozepod-page-content-{{ section.id }} .support-page-faq__item summary::-webkit-details-marker {
    display: none;
  }

  .snoozepod-page-content-{{ section.id }} .support-page-faq__item summary::after {
    content: "+";
    flex: 0 0 auto;
    color: rgba(7, 25, 66, 0.5);
    font-size: 24px;
    line-height: 1;
  }

  .snoozepod-page-content-{{ section.id }} .support-page-faq__item[open] summary::after {
    content: "–";
  }

  .snoozepod-page-content-{{ section.id }} .support-page-faq__answer {
    padding: 0 22px 20px;
    color: rgba(7, 25, 66, 0.76);
    font-size: 16px;
    line-height: 1.65;
  }

  @media screen and (min-width: 990px) {
    .snoozepod-page-content-{{ section.id }} {
      padding: 0 32px;
    }

    .snoozepod-page-content-{{ section.id }} .snoozepod-page-content__card {
      padding: 40px 48px;
      border-radius: 32px;
    }

    .snoozepod-page-content-{{ section.id }} .support-page-richtext,
    .snoozepod-page-content-{{ section.id }} .support-page-note {
      font-size: 19px;
    }
  }
{%- endstyle -%}

{%- liquid
  capture page_body_markup
    render 'support-page-body', page: page, page_handle: page.handle
  endcapture
  assign page_body_markup = page_body_markup | strip
-%}

<section class="section">
  <div class="snoozepod-page-content-{{ section.id }}">
    {%- if page_body_markup != blank -%}
      <div class="snoozepod-page-content__card">
        {{ page_body_markup }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page content",
  "class": "section",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "Page content"
    }
  ]
}
{% endschema %}
