{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- if collection.handle == 'mattresses' -%}
  {{ 'snoozepod-shop-by-size.js' | asset_url | script_tag }}
{%- endif -%}
{%- if section.settings.show_snoozepod_card_details -%}
  {{ 'component-snoozepod-commerce-v1.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if collection.handle == 'mattresses' -%}
  {%- style -%}
    .snoozepod-shop-by-size {
      max-width: min(100%, var(--wide-content-max));
      margin: 0 auto 28px;
      padding: 0 22px;
    }

    .snoozepod-shop-by-size__panel {
      padding: 22px;
      border: 1px solid rgba(10, 25, 55, 0.11);
      border-radius: 22px;
      background: linear-gradient(135deg, #f3f6fb 0%, #faf8f3 100%);
      box-shadow: 0 12px 28px rgba(7, 25, 66, 0.06);
    }

    .snoozepod-shop-by-size__eyebrow {
      margin: 0 0 6px;
      color: #48607f;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .snoozepod-shop-by-size__heading {
      margin: 0;
      color: #081a3b;
      font-size: clamp(24px, 3vw, 34px);
      line-height: 1.12;
      letter-spacing: -0.03em;
    }

    .snoozepod-shop-by-size__intro,
    .snoozepod-shop-by-size__status {
      color: #40516c;
      font-size: 14px;
      line-height: 1.5;
    }

    .snoozepod-shop-by-size__intro { margin: 8px 0 18px; }
    .snoozepod-shop-by-size__status { margin: 14px 0 0; }

    .snoozepod-shop-by-size__options {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 9px;
    }

    .snoozepod-shop-by-size__option,
    .snoozepod-shop-by-size__clear {
      min-height: 46px;
      border-radius: 999px;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    .snoozepod-shop-by-size__option {
      padding: 10px 14px;
      border: 1px solid #b7c4d7;
      color: #12294d;
      background: #e4eaf2;
    }

    .snoozepod-shop-by-size__option:hover:not(:disabled),
    .snoozepod-shop-by-size__option:focus-visible {
      border-color: #173d73;
      background: #d7e1ee;
    }

    .snoozepod-shop-by-size__option.is-active,
    .snoozepod-shop-by-size__option[aria-pressed='true'] {
      border-color: #0b2c5a;
      color: #ffffff;
      background: #0b2c5a;
      box-shadow: 0 6px 16px rgba(11, 44, 90, 0.2);
    }

    .snoozepod-shop-by-size__option:disabled {
      color: #7e8999;
      background: #edf0f4;
      cursor: not-allowed;
      opacity: 0.7;
    }

    .snoozepod-shop-by-size__clear {
      margin-top: 14px;
      padding: 8px 16px;
      border: 1px solid #b7c4d7;
      color: #173d73;
      background: #ffffff;
    }

    .snoozepod-size-card-price {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 4px 8px;
      color: rgb(var(--color-foreground));
    }

    .snoozepod-size-card-price__label {
      width: 100%;
      color: rgba(var(--color-foreground), 0.67);
      font-size: 12px;
      font-weight: 600;
    }

    .snoozepod-size-card-price__amount {
      font-size: 15px;
      font-weight: 700;
    }

    @media screen and (min-width: 750px) {
      .snoozepod-shop-by-size { padding: 0 64px; }
      .snoozepod-shop-by-size__panel { padding: 28px 30px; }
      .snoozepod-shop-by-size__options { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    }
  {%- endstyle -%}
{%- endif -%}

{%- if template.suffix == 'snoozepod' or template.suffix == 'main' or template.suffix == 'snoozepod-v1' -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .snoozepod-collection-grid.section-{{ section.id }}-padding {
      padding-top: 4px !important;
      padding-bottom: 24px !important;
    }

    .snoozepod-collection-grid .page-width,
    .snoozepod-collection-grid .facets-wrapper,
    .snoozepod-collection-grid .collection.page-width,
    .snoozepod-collection-grid .facets-vertical.page-width {
      max-width: min(100%, var(--wide-content-max));
      margin-left: auto;
      margin-right: auto;
      padding-left: 22px;
      padding-right: 22px;
    }

    .snoozepod-collection-grid .product-grid {
      gap: 12px;
    }

    .snoozepod-collection-grid .product-card-wrapper .card {
      height: 100%;
      overflow: hidden;
      border: 1px solid rgba(10, 25, 55, 0.10);
      border-radius: 20px;
      background: #ffffff;
      box-shadow: 0 10px 22px rgba(7, 25, 66, 0.05);
    }

    .snoozepod-collection-grid .product-card-wrapper .card__inner {
      border-radius: 20px 20px 0 0;
      background: #f7f8fb;
    }

    .snoozepod-collection-grid .product-card-wrapper .card__inner.ratio,
    .snoozepod-collection-grid .product-card-wrapper .card.card--media {
      --ratio-percent: 88% !important;
    }

    .snoozepod-collection-grid .product-card-wrapper .card__media,
    .snoozepod-collection-grid .product-card-wrapper .card--standard .card__media,
    .snoozepod-collection-grid .product-card-wrapper .card__media .media {
      border-radius: 18px 18px 0 0;
      background: linear-gradient(180deg, #faf8f3 0%, #f5f7fb 100%);
      overflow: hidden;
    }

    .snoozepod-collection-grid .product-card-wrapper .card__content {
      padding: 12px;
      gap: 10px;
    }

    .snoozepod-collection-grid .product-card-wrapper .card__information {
      gap: 6px;
      padding: 0.3rem 0.2rem 0;
    }

    .snoozepod-collection-grid .product-card-wrapper .card__heading {
      font-size: 17px;
      line-height: 1.22;
      letter-spacing: -0.02em;
    }

    .snoozepod-collection-grid .product-card-wrapper .card-information,
    .snoozepod-collection-grid .product-card-wrapper .price,
    .snoozepod-collection-grid .product-card-wrapper .caption-with-letter-spacing {
      font-size: 14px;
      line-height: 1.28;
    }

    .snoozepod-collection-grid .product-card-wrapper .quick-add__submit {
      min-height: 42px;
      padding: 0.8rem 1.2rem;
      border-radius: 999px;
      font-size: 13px;
      line-height: 1.2;
    }

    .snoozepod-collection-grid .product-card-wrapper .price__regular,
    .snoozepod-collection-grid .product-card-wrapper .price-item {
      font-size: 14px;
    }

    .snoozepod-collection-grid .product-card-wrapper .button--secondary:after {
      box-shadow: none;
    }

    @media screen and (min-width: 990px) {
      .snoozepod-collection-grid.section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }

      .snoozepod-collection-grid .page-width,
      .snoozepod-collection-grid .facets-wrapper,
      .snoozepod-collection-grid .collection.page-width,
      .snoozepod-collection-grid .facets-vertical.page-width {
        padding-left: 64px;
        padding-right: 64px;
      }

      .snoozepod-collection-grid .product-grid {
        gap: 18px;
      }

      .snoozepod-collection-grid .product-card-wrapper .card__content {
        padding: 14px 14px 16px;
      }

      .snoozepod-collection-grid .product-card-wrapper .card__heading {
        font-size: 18px;
      }

      .snoozepod-collection-grid .product-card-wrapper .card-information,
      .snoozepod-collection-grid .product-card-wrapper .price,
      .snoozepod-collection-grid .product-card-wrapper .caption-with-letter-spacing {
        font-size: 14px;
      }

      .snoozepod-collection-grid .product-card-wrapper .quick-add__submit {
        min-height: 44px;
        font-size: 13px;
      }

      .snoozepod-collection-grid .product-card-wrapper .card__inner.ratio,
      .snoozepod-collection-grid .product-card-wrapper .card.card--media {
        --ratio-percent: 82% !important;
      }

      .snoozepod-collection-grid .product-card-wrapper .price__regular,
      .snoozepod-collection-grid .product-card-wrapper .price-item {
        font-size: 15px;
      }
    }
  {%- endstyle -%}
{%- endif -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}{% if template.suffix == 'snoozepod' or template.suffix == 'main' or template.suffix == 'snoozepod-v1' %} snoozepod-collection-grid{% endif %}">
  {%- if collection.handle == 'mattresses' -%}
    <section class="snoozepod-shop-by-size" data-shop-by-size aria-labelledby="ShopBySizeHeading-{{ section.id }}">
      <div class="snoozepod-shop-by-size__panel">
        <p class="snoozepod-shop-by-size__eyebrow">Find your fit</p>
        <h2 class="snoozepod-shop-by-size__heading" id="ShopBySizeHeading-{{ section.id }}">Shop Mattresses by Size</h2>
        <p class="snoozepod-shop-by-size__intro">Choose a size to see mattresses that are currently available, with the exact price for that size.</p>
        <div class="snoozepod-shop-by-size__options" aria-label="Mattress size">
          {%- assign snoozepod_sizes = 'Twin|Twin XL|Full|Queen|King|California King' | split: '|' -%}
          {%- for snoozepod_size in snoozepod_sizes -%}
            <button class="snoozepod-shop-by-size__option" type="button" data-shop-by-size-option="{{ snoozepod_size }}" aria-pressed="false">
              {{ snoozepod_size }}
            </button>
          {%- endfor -%}
        </div>
        <button class="snoozepod-shop-by-size__clear" type="button" data-shop-by-size-clear hidden>Show all mattress sizes</button>
        <p class="snoozepod-shop-by-size__status" data-shop-by-size-status aria-live="polite">Choose a size to see exact availability and pricing.</p>
      </div>
    </section>
  {%- endif -%}
  {%- paginate collection.products by section.settings.products_per_page -%}
    {% comment %} Sort is the first tabbable element when filter type is vertical {% endcomment %}
    {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}
      <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
        <form class="facets-vertical-form" id="FacetSortForm">
          <div class="facet-filters sorting caption">
            <div class="facet-filters__field">
              <h2 class="facet-filters__label caption-large text-body">
                <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
              </h2>
              <div class="select">
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                <select
                  name="sort_by"
                  class="facet-filters__sort select__select caption-large"
                  id="SortBy"
                  aria-describedby="a11y-refresh-page-message"
                >
                  {%- for option in collection.sort_options -%}
                    <option
                      value="{{ option.value | escape }}"
                      {% if option.value == sort_by %}
                        selected="selected"
                      {% endif %}
                    >
                      {{ option.name | escape }}
                    </option>
                  {%- endfor -%}
                </select>
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </div>
            </div>
          </div>

          <div class="product-count-vertical light" role="status">
            <h2 class="product-count__text text-body">
              <span id="ProductCountDesktop">
                {%- if collection.results_count -%}
                  {{
                    'templates.search.results_with_count'
                    | t: terms: collection.terms, count: collection.results_count
                  }}
                {%- elsif collection.products_count == collection.all_products_count -%}
                  {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                {%- else -%}
                  {{
                    'products.facets.product_count'
                    | t: product_count: collection.products_count, count: collection.all_products_count
                  }}
                {%- endif -%}
              </span>
            </h2>
            {%- render 'loading-spinner' -%}
          </div>
        </form>
      </facet-filters-form>
    {%- endif -%}

    <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %}">
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: collection,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            filter_type: section.settings.filter_type,
            paginate: paginate
          %}
        </aside>
      {%- endif -%}

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        id="ProductGridContainer"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div
            class="collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          >
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="
                grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
                grid--{{ section.settings.columns_desktop }}-col-desktop
                {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
              "
            >
              {% assign skip_card_product_styles = false %}
              {% assign shop_by_size_enabled = false %}
              {% if collection.handle == 'mattresses' %}
                {% assign shop_by_size_enabled = true %}
              {% endif %}
              {%- for product in collection.products -%}
                {% assign lazy_load = false %}
                {%- if forloop.index > 2 -%}
                  {%- assign lazy_load = true -%}
                {%- endif -%}
                <li
                  class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if collection.handle == 'mattresses' %}data-shop-by-size-product{% endif %}
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    lazy_load: lazy_load,
                    skip_styles: skip_card_product_styles,
                    quick_add: section.settings.quick_add,
                    show_snoozepod_details: section.settings.show_snoozepod_card_details,
                    shop_by_size: shop_by_size_enabled,
                    section_id: section.id
                  %}
                  {%- if collection.handle == 'mattresses' -%}
                    {%- liquid
                      assign snoozepod_size_option_index = 1
                      for product_option_name in product.options
                        assign product_option_name_normalized = product_option_name | downcase
                        if product_option_name_normalized == 'size'
                          assign snoozepod_size_option_index = forloop.index
                        endif
                      endfor
                    -%}
                    <script type="application/json" data-shop-by-size-variants>
                      [
                        {%- for variant in product.variants -%}
                          {%- liquid
                            assign snoozepod_variant_size = variant.option1
                            if snoozepod_size_option_index == 2
                              assign snoozepod_variant_size = variant.option2
                            elsif snoozepod_size_option_index == 3
                              assign snoozepod_variant_size = variant.option3
                            endif
                          -%}
                          {
                            "variantId": {{ variant.id | json }},
                            "nativeSize": {{ snoozepod_variant_size | json }},
                            "available": {{ variant.available | json }},
                            "price": {{ variant.price | money | json }}
                          }{% unless forloop.last %},{% endunless %}
                        {%- endfor -%}
                      ]
                    </script>
                  {%- endif -%}
                </li>
                {%- assign skip_card_product_styles = true -%}
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate, anchor: '' %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.image_shape.options__1.label"
        },
        {
          "value": "arch",
          "label": "t:sections.all.image_shape.options__2.label"
        },
        {
          "value": "blob",
          "label": "t:sections.all.image_shape.options__3.label"
        },
        {
          "value": "chevronleft",
          "label": "t:sections.all.image_shape.options__4.label"
        },
        {
          "value": "chevronright",
          "label": "t:sections.all.image_shape.options__5.label"
        },
        {
          "value": "diamond",
          "label": "t:sections.all.image_shape.options__6.label"
        },
        {
          "value": "parallelogram",
          "label": "t:sections.all.image_shape.options__7.label"
        },
        {
          "value": "round",
          "label": "t:sections.all.image_shape.options__8.label"
        }
      ],
      "default": "default",
      "label": "t:sections.all.image_shape.label",
      "info": "t:sections.all.image_shape.info"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_rating.label",
      "info": "t:sections.main-collection-product-grid.settings.show_rating.info"
    },
    {
      "type": "checkbox",
      "id": "show_snoozepod_card_details",
      "default": false,
      "label": "Show Product Card v1 details"
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "none",
      "label": "t:sections.main-collection-product-grid.settings.quick_add.label",
      "info": "t:sections.main-collection-product-grid.settings.quick_add.info",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_1"
        },
        {
          "value": "standard",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_2"
        },
        {
          "value": "bulk",
