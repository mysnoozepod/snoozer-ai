{%- style -%}
  .snoozepod-category-education-{{ section.id }} {
    max-width: 1480px;
    margin: 8px 16px 28px;
  }

  .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__card {
    padding: 18px;
    border-radius: 22px;
    background: #f5f7fb;
  }

  .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__eyebrow {
    display: inline-block;
    margin: 0 0 12px;
    color: rgba(7, 25, 66, 0.7);
    font-size: 13px;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__heading {
    margin: 0;
    color: #071942;
    font-size: 22px;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__body {
    margin: 8px 0 0;
    max-width: 58rem;
    color: rgba(7, 25, 66, 0.78);
    font-size: 14px;
    line-height: 1.35;
  }

  .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__body p {
    margin: 0;
  }

  .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__tiles {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin-top: 14px;
  }

  .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__tile {
    height: 100%;
    padding: 14px;
    border: 1px solid rgba(7, 25, 66, 0.08);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.8);
  }

  .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__tile-title {
    margin: 0;
    color: #071942;
    font-size: 16px;
    line-height: 1.2;
    font-weight: 700;
  }

  .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__tile-text {
    margin: 6px 0 0;
    color: rgba(7, 25, 66, 0.76);
    font-size: 14px;
    line-height: 1.35;
  }

  @media screen and (min-width: 750px) {
    .snoozepod-category-education-{{ section.id }} {
      margin: 8px 24px 36px;
    }

    .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .snoozepod-category-education-{{ section.id }} {
      margin: 8px auto 40px;
    }

    .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__card {
      padding: 18px 22px 22px;
      border-radius: 20px;
    }

    .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__heading {
      font-size: 24px;
      line-height: 1.05;
    }

    .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__body {
      font-size: 14px;
    }

    .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__tiles {
      gap: 12px;
      margin-top: 14px;
    }

    .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__tile {
      padding: 14px 16px;
    }

    .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__tile-title {
      font-size: 16px;
    }

    .snoozepod-category-education-{{ section.id }} .snoozepod-category-education__tile-text {
      font-size: 14px;
    }
  }
{%- endstyle -%}

<section class="section snoozepod-category-education-section">
  <div class="snoozepod-category-education-{{ section.id }}">
    <div class="snoozepod-category-education__card">
      {%- if section.settings.eyebrow != blank -%}
        <p class="snoozepod-category-education__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h2 class="snoozepod-category-education__heading">{{ section.settings.heading | escape }}</h2>

      {%- if section.settings.body != blank -%}
        <div class="snoozepod-category-education__body rte">
          <p>{{ section.settings.body | escape }}</p>
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="snoozepod-category-education__tiles">
          {%- for block in section.blocks -%}
            <div class="snoozepod-category-education__tile" {{ block.shopify_attributes }}>
              <h3 class="snoozepod-category-education__tile-title">{{ block.settings.title | escape }}</h3>
              <p class="snoozepod-category-education__tile-text">{{ block.settings.text | escape }}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category education",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Sleep Environment Guide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How This Fits Your Sleep Environment"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Your SnoozePod is built from the pieces that shape how you rest: mattress, base, pillows, sheets, protection, and finishing details."
    }
  ],
  "blocks": [
    {
      "type": "education_tile",
      "name": "Education tile",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Start with comfort"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Choose the feel and support that match how you sleep."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category education",
      "blocks": [
        {
          "type": "education_tile",
          "settings": {
            "title": "Start with comfort",
            "text": "Choose the feel and support that match how you sleep."
          }
        },
        {
          "type": "education_tile",
          "settings": {
            "title": "Layer in support",
            "text": "Add products that improve position, pressure relief, and recovery."
          }
        },
        {
          "type": "education_tile",
          "settings": {
            "title": "Finish the room",
            "text": "Complete the environment around your nightly routine."
          }
        }
      ]
    }
  ]
}
{% endschema %}
