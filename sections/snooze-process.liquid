{%- style -%}
  .snooze-process-{{ section.id }} {
    padding-top: 4.8rem;
    padding-bottom: 4.8rem;
  }

  .snooze-process-{{ section.id }} .snooze-process__header {
    max-width: 72rem;
    margin-bottom: 2.4rem;
  }

  .snooze-process-{{ section.id }} .snooze-process__heading {
    margin: 0;
  }

  .snooze-process-{{ section.id }} .snooze-process__intro {
    margin: 1.6rem 0 0;
    color: rgba(var(--color-foreground), 0.75);
  }

  .snooze-process-{{ section.id }} .snooze-process__grid {
    display: grid;
    gap: 1.6rem;
  }

  .snooze-process-{{ section.id }} .snooze-process__card {
    display: grid;
    gap: 1.6rem;
    padding: 2.4rem;
    height: 100%;
    border: 0.1rem solid rgba(var(--color-foreground), 0.08);
    border-radius: 1.6rem;
    background: rgb(var(--color-background));
  }

  .snooze-process-{{ section.id }} .snooze-process__step-media {
    overflow: hidden;
    border-radius: 1.2rem;
    background: rgba(var(--color-foreground), 0.03);
    aspect-ratio: 4 / 3;
  }

  .snooze-process-{{ section.id }} .snooze-process__step-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .snooze-process-{{ section.id }} .snooze-process__step-number {
    display: inline-flex;
    width: 4.8rem;
    height: 4.8rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgba(var(--color-foreground), 0.06);
    font-size: 1.8rem;
    font-weight: 600;
    line-height: 1;
  }

  .snooze-process-{{ section.id }} .snooze-process__step-title {
    margin: 0;
  }

  .snooze-process-{{ section.id }} .snooze-process__step-text {
    margin: 0;
    color: rgba(var(--color-foreground), 0.75);
  }

  @media screen and (min-width: 750px) {
    .snooze-process-{{ section.id }} {
      padding-top: 6.4rem;
      padding-bottom: 6.4rem;
    }

    .snooze-process-{{ section.id }} .snooze-process__header {
      margin-bottom: 3.2rem;
    }

    .snooze-process-{{ section.id }} .snooze-process__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  @media screen and (min-width: 990px) {
    .snooze-process-{{ section.id }} .snooze-process__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

<section class="snooze-process snooze-process-{{ section.id }}">
  <div class="page-width">
    <div class="snooze-process__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="snooze-process__heading h2">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.intro_text != blank -%}
        <div class="snooze-process__intro rte">
          <p>{{ section.settings.intro_text | escape | newline_to_br }}</p>
        </div>
      {%- endif -%}
    </div>

    <div class="snooze-process__grid">
      {%- for block in section.blocks -%}
        <article class="snooze-process__card" {{ block.shopify_attributes }}>
          {%- if block.settings.step_image != blank -%}
            <div class="snooze-process__step-media">
              {{
                block.settings.step_image
                | image_url: width: 1600
                | image_tag:
                  widths: '320, 480, 640, 800, 1200, 1600',
                  sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                  class: 'snooze-process__step-image',
                  loading: 'lazy',
                  alt: block.settings.step_image.alt | default: block.settings.step_title | default: 'Step image' | escape
              }}
            </div>
          {%- else -%}
            <span class="snooze-process__step-number" aria-hidden="true">{{ forloop.index }}</span>
          {%- endif -%}

          <div class="snooze-process__step-copy">
            <h3 class="snooze-process__step-title h3">
              {%- if block.settings.step_title != blank -%}
                {{ block.settings.step_title | escape }}
              {%- else -%}
                {{ 'Step ' | append: forloop.index }}
              {%- endif -%}
            </h3>

            {%- if block.settings.step_text != blank -%}
              <div class="snooze-process__step-text rte">
                <p>{{ block.settings.step_text | escape | newline_to_br }}</p>
              </div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Snooze process",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro text",
      "default": "Short supporting text."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "step_title",
          "label": "Step title"
        },
        {
          "type": "textarea",
          "id": "step_text",
          "label": "Step text"
        },
        {
          "type": "image_picker",
          "id": "step_image",
          "label": "Step image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Snooze process",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
