{%- liquid
  assign hero_image = section.settings.hero_image
  assign hero_alt = section.settings.hero_image_alt | strip
  if hero_alt == blank
    assign hero_alt = section.settings.hero_headline
  endif

  assign mini_calendly_url = section.settings.mini_calendly_url | strip
  if mini_calendly_url == blank
    assign mini_calendly_url = 'https://calendly.com/d/cypf-52b-v4v'
  endif

  assign booking_calendly_url = section.settings.calendly_url | strip
  if booking_calendly_url == blank
    assign booking_calendly_url = 'https://calendly.com/zohotyree/30min'
  endif

  assign hide_footer_newsletter = false
  if request.page_type == 'page' and page.handle == 'book-a-snooze-session'
    assign hide_footer_newsletter = true
  endif
-%}

{%- style -%}
  .snoozer-landing-booking-{{ section.id }} {
    max-width: 1180px;
    margin: 16px auto 28px;
    padding: 0 16px;
    color: #071942;
  }

  .snoozer-landing-booking-{{ section.id }} .landing-stack {
    display: grid;
    gap: 14px;
  }

  .snoozer-landing-booking-{{ section.id }} .panel {
    border: 1px solid rgba(7, 25, 66, 0.08);
    border-radius: 28px;
    background: #ffffff;
    overflow: hidden;
  }

  .snoozer-landing-booking-{{ section.id }} .panel--soft {
    background: #f5f7fb;
  }

  .snoozer-landing-booking-{{ section.id }} .hero {
    display: grid;
    gap: 20px;
    padding: 28px 24px;
  }

  .snoozer-landing-booking-{{ section.id }} .eyebrow {
    margin: 0 0 10px;
    color: rgba(7, 25, 66, 0.7);
    font-size: 13px;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .snoozer-landing-booking-{{ section.id }} .title {
    margin: 0;
    font-size: 36px;
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .snoozer-landing-booking-{{ section.id }} .text,
  .snoozer-landing-booking-{{ section.id }} .subtext {
    margin: 12px 0 0;
    color: rgba(7, 25, 66, 0.78);
    font-size: 17px;
    line-height: 1.55;
  }

  .snoozer-landing-booking-{{ section.id }} .helper {
    margin: 14px 0 0;
    color: rgba(7, 25, 66, 0.7);
    font-size: 14px;
    line-height: 1.5;
    font-weight: 600;
  }

  .snoozer-landing-booking-{{ section.id }} .visual,
  .snoozer-landing-booking-{{ section.id }} .fallback {
    min-height: 220px;
    border-radius: 24px;
    overflow: hidden;
  }

  .snoozer-landing-booking-{{ section.id }} .visual img {
    display: block;
    width: 100%;
    min-height: 220px;
    height: 100%;
    object-fit: cover;
  }

  .snoozer-landing-booking-{{ section.id }} .fallback {
    display: flex;
    align-items: flex-end;
    padding: 22px;
    background:
      radial-gradient(circle at top right, rgba(44, 66, 120, 0.16), transparent 34%),
      linear-gradient(180deg, #eaf0f8 0%, #dfe7f3 100%);
    color: rgba(7, 25, 66, 0.76);
    font-size: 14px;
    font-weight: 600;
  }

  .snoozer-landing-booking-{{ section.id }} .section-pad {
    padding: 24px;
  }

  .snoozer-landing-booking-{{ section.id }} .heading {
    margin: 0;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .snoozer-landing-booking-{{ section.id }} .section-copy {
    max-width: 720px;
  }

  .snoozer-landing-booking-{{ section.id }} .section-label {
    margin: 0 0 12px;
    color: rgba(7, 25, 66, 0.6);
    font-size: 12px;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
    font-weight: 700;
  }

  .snoozer-landing-booking-{{ section.id }} .calendly-shell {
    margin-top: 18px;
    padding: 10px;
    border: 1px solid rgba(7, 25, 66, 0.08);
    border-radius: 24px;
    background: #ffffff;
    overflow: hidden;
    line-height: 0;
  }

  .snoozer-landing-booking-{{ section.id }} .calendly-inline-widget {
    display: block;
    width: 100%;
    min-width: 320px;
    min-height: 700px;
    height: 700px;
  }

  .snoozer-landing-booking-{{ section.id }} .calendly-shell iframe {
    display: block;
    width: 100%;
    min-width: 320px;
    min-height: 700px !important;
    height: 700px !important;
    border: 0;
  }

  {%- if hide_footer_newsletter -%}
    body.template-page #shopify-section-newsletter {
      display: none !important;
    }
  {%- endif -%}

  @media screen and (min-width: 750px) {
    .snoozer-landing-booking-{{ section.id }} {
      padding: 0 24px;
    }
  }

  @media screen and (min-width: 990px) {
    .snoozer-landing-booking-{{ section.id }} {
      padding: 0 32px;
    }

    .snoozer-landing-booking-{{ section.id }} .hero {
      grid-template-columns: minmax(0, 1.02fr) minmax(360px, 0.98fr);
      gap: 28px;
      padding: 36px;
      align-items: center;
    }

    .snoozer-landing-booking-{{ section.id }} .title {
      font-size: 50px;
    }

    .snoozer-landing-booking-{{ section.id }} .visual,
    .snoozer-landing-booking-{{ section.id }} .fallback,
    .snoozer-landing-booking-{{ section.id }} .visual img {
      min-height: 300px;
      height: 100%;
    }

    .snoozer-landing-booking-{{ section.id }} .section-pad {
      padding: 30px 32px;
    }
  }

  @media screen and (max-width: 749px) {
    .snoozer-landing-booking-{{ section.id }} .calendly-inline-widget {
      min-height: 800px;
      height: 800px;
    }

    .snoozer-landing-booking-{{ section.id }} .calendly-shell iframe {
      min-height: 800px !important;
      height: 800px !important;
    }
  }
{%- endstyle -%}

<section class="section">
  <div class="snoozer-landing-booking-{{ section.id }}">
    <div class="landing-stack">
      <div class="panel panel--soft">
        <div class="hero">
          <div>
            {%- if section.settings.hero_eyebrow != blank -%}
              <p class="eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
            {%- endif -%}
            <h1 class="title">{{ section.settings.hero_headline | escape }}</h1>
            <p class="text">{{ section.settings.hero_text | escape }}</p>
            {%- if section.settings.hero_helper_text != blank -%}
              <p class="helper">{{ section.settings.hero_helper_text | escape }}</p>
            {%- endif -%}
          </div>
          {%- if hero_image != blank -%}
            <div class="visual">
              {{
                hero_image
                | image_url: width: 1400
                | image_tag:
                  widths: '480, 720, 960, 1400',
                  sizes: '(min-width: 990px) 42vw, 100vw',
                  loading: 'lazy',
                  alt: hero_alt | escape
              }}
            </div>
          {%- else -%}
            <div class="fallback">Private Snooze Session</div>
          {%- endif -%}
        </div>
      </div>

      <div class="panel">
        <div class="section-pad">
          <p class="section-label">Step 1</p>
          <h2 class="heading">{{ section.settings.mini_heading | escape }}</h2>
          <p class="subtext section-copy">{{ section.settings.mini_text | escape }}</p>
          <div class="calendly-shell">
            <div
              id="CalendlyInlineWidgetMini-{{ section.id }}"
              class="calendly-inline-widget"
              data-url="{{ mini_calendly_url | escape }}"
              style="min-width:320px;height:700px;"
            ></div>
          </div>
        </div>
      </div>

      <div class="panel" id="snooze-session-booking-{{ section.id }}">
        <div class="section-pad">
          <p class="section-label">Step 2</p>
          <h2 class="heading">{{ section.settings.booking_heading | escape }}</h2>
          <p class="subtext section-copy">{{ section.settings.booking_text | escape }}</p>
          <div class="calendly-shell">
            <div
              id="CalendlyInlineWidgetBooking-{{ section.id }}"
              class="calendly-inline-widget"
              data-url="{{ booking_calendly_url | escape }}"
              style="min-width:320px;height:700px;"
            ></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var widgetIds = [
      'CalendlyInlineWidgetMini-{{ section.id }}',
      'CalendlyInlineWidgetBooking-{{ section.id }}'
    ];

    function getWidgetRoots() {
      return widgetIds
        .map(function (id) {
          return document.getElementById(id);
        })
        .filter(Boolean);
    }

    function applyWidgetSizing(root) {
      if (!root) return;
      var mobile = window.matchMedia('(max-width: 749px)').matches;
      var nextHeight = mobile ? '800px' : '700px';
      root.style.width = '100%';
      root.style.minWidth = '320px';
      root.style.minHeight = nextHeight;
      root.style.height = nextHeight;
    }

    function mountCalendly(root, options) {
      if (!root) return;
      applyWidgetSizing(root);
      if (!window.Calendly || typeof window.Calendly.initInlineWidget !== 'function') return;

      var forceRemount = Boolean(options && options.force);
      if (!forceRemount && root.querySelector('iframe')) {
        root.dataset.calendlyMounted = 'true';
        return;
      }
      if (!forceRemount && root.dataset.calendlyMounted === 'true') return;

      root.innerHTML = '';
      window.Calendly.initInlineWidget({
        url: root.getAttribute('data-url'),
        parentElement: root
      });
      root.dataset.calendlyMounted = 'true';
    }

    function mountAllCalendly(options) {
      getWidgetRoots().forEach(function (root) {
        mountCalendly(root, options);
      });
    }

    function loadCalendlyScript() {
      if (window.Calendly && typeof window.Calendly.initInlineWidget === 'function') {
        return Promise.resolve(window.Calendly);
      }

      if (window.__mysnoozepodCalendlyLoader) {
        return window.__mysnoozepodCalendlyLoader;
      }

      window.__mysnoozepodCalendlyLoader = new Promise(function (resolve, reject) {
        var existingScript = document.querySelector('script[data-calendly-widget-script="true"]');
        if (existingScript) {
          if (window.Calendly && typeof window.Calendly.initInlineWidget === 'function') {
            resolve(window.Calendly);
            return;
          }

          existingScript.addEventListener(
            'load',
            function () {
              resolve(window.Calendly);
            },
            { once: true }
          );
          existingScript.addEventListener('error', reject, { once: true });
          return;
        }

        var script = document.createElement('script');
        script.src = 'https://assets.calendly.com/assets/external/widget.js';
        script.async = true;
        script.setAttribute('data-calendly-widget-script', 'true');
        script.addEventListener(
          'load',
          function () {
            resolve(window.Calendly);
          },
          { once: true }
        );
        script.addEventListener('error', reject, { once: true });
        document.head.appendChild(script);
      });

      return window.__mysnoozepodCalendlyLoader;
    }

    loadCalendlyScript()
      .then(function () {
        mountAllCalendly({ force: true });
      })
      .catch(function () {});

    window.addEventListener('resize', function () {
      getWidgetRoots().forEach(function (root) {
        applyWidgetSizing(root);
      });
    });

    document.addEventListener('shopify:section:load', function (event) {
      if (!event.target || !event.target.querySelector) return;

      var containsBookingWidget = widgetIds.some(function (id) {
        return event.target.querySelector('#' + id);
      });

      if (!containsBookingWidget) return;

      loadCalendlyScript()
        .then(function () {
          mountAllCalendly({ force: true });
        })
        .catch(function () {});
    });
  })();
</script>

{% schema %}
{
  "name": "Landing booking",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "hero_eyebrow", "label": "Hero eyebrow", "default": "BOOK YOUR SNOOZE SESSION" },
    { "type": "text", "id": "hero_headline", "label": "Hero headline", "default": "Book A Private Snooze Session" },
    { "type": "textarea", "id": "hero_text", "label": "Hero text", "default": "Answer a few quick sleep questions, then choose a time to visit the showroom with a clearer plan for what to test." },
    { "type": "textarea", "id": "hero_helper_text", "label": "Hero helper text", "default": "Start with the mini Snooze Assessment below, then book your private session." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_image_alt", "label": "Hero image alt text" },
    { "type": "text", "id": "mini_heading", "label": "Mini assessment heading", "default": "Start With Your Mini Snooze Assessment" },
    { "type": "textarea", "id": "mini_text", "label": "Mini assessment text", "default": "Answer a few quick questions so your showroom visit starts with direction." },
    { "type": "text", "id": "mini_calendly_url", "label": "Mini assessment Calendly URL", "default": "https://calendly.com/d/cypf-52b-v4v" },
    { "type": "text", "id": "booking_heading", "label": "Booking heading", "default": "Choose Your Snooze Session Time" },
    { "type": "textarea", "id": "booking_text", "label": "Booking text", "default": "After the mini assessment, choose a time for your private showroom visit." },
    { "type": "text", "id": "calendly_url", "label": "Booking Calendly URL", "default": "https://calendly.com/zohotyree/30min" }
  ],
  "presets": [
    {
      "name": "Landing booking"
    }
  ]
}
{% endschema %}
