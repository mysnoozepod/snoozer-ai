{%- liquid
  assign hero_image = section.settings.hero_image
  assign hero_alt = section.settings.hero_image_alt | strip
  if hero_alt == blank
    assign hero_alt = section.settings.hero_headline
  endif
  assign visit_steps = section.blocks | where: 'type', 'visit_step'
  assign difference_cards = section.blocks | where: 'type', 'difference_card'
  assign faq_items = section.blocks | where: 'type', 'faq_item'
  assign assessment_page_url = '/pages/snooze-assessment'
  assign booking_anchor_id = 'snooze-session-booking-' | append: section.id
  assign booking_anchor_href = '#' | append: booking_anchor_id
  assign calendly_url = section.settings.calendly_url | strip
  if calendly_url == blank
    assign calendly_url = 'https://calendly.com/zohotyree/30min'
  endif
-%}

{%- style -%}
  .snoozer-landing-booking-{{ section.id }} {
    max-width: 1180px;
    margin: 20px auto 48px;
    padding: 0 16px;
    color: #071942;
  }

  .snoozer-landing-booking-{{ section.id }} .landing-stack {
    display: grid;
    gap: 20px;
  }

  .snoozer-landing-booking-{{ section.id }} .panel,
  .snoozer-landing-booking-{{ section.id }} .band {
    border: 1px solid rgba(7, 25, 66, 0.08);
    border-radius: 28px;
    background: #ffffff;
    overflow: hidden;
  }

  .snoozer-landing-booking-{{ section.id }} .panel--soft {
    background: #f5f7fb;
  }

  .snoozer-landing-booking-{{ section.id }} .hero {
    display: grid;
    gap: 24px;
    padding: 28px 24px;
  }

  .snoozer-landing-booking-{{ section.id }} .eyebrow {
    margin: 0 0 10px;
    color: rgba(7, 25, 66, 0.7);
    font-size: 13px;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .snoozer-landing-booking-{{ section.id }} .title {
    margin: 0;
    font-size: 36px;
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .snoozer-landing-booking-{{ section.id }} .text,
  .snoozer-landing-booking-{{ section.id }} .subtext {
    margin: 14px 0 0;
    color: rgba(7, 25, 66, 0.78);
    font-size: 17px;
    line-height: 1.55;
  }

  .snoozer-landing-booking-{{ section.id }} .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }

  .snoozer-landing-booking-{{ section.id }} .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 24px;
    border-radius: 999px;
    border: 1px solid rgba(7, 25, 66, 0.12);
    background: #ffffff;
    color: #071942;
    font-size: 16px;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }

  .snoozer-landing-booking-{{ section.id }} .button--primary {
    background: #071942;
    border-color: #071942;
    color: #ffffff;
  }

  .snoozer-landing-booking-{{ section.id }} .visual,
  .snoozer-landing-booking-{{ section.id }} .fallback {
    min-height: 220px;
    border-radius: 24px;
    overflow: hidden;
  }

  .snoozer-landing-booking-{{ section.id }} .visual img {
    display: block;
    width: 100%;
    min-height: 220px;
    height: 100%;
    object-fit: cover;
  }

  .snoozer-landing-booking-{{ section.id }} .fallback {
    display: flex;
    align-items: flex-end;
    padding: 22px;
    background:
      radial-gradient(circle at top right, rgba(44, 66, 120, 0.16), transparent 34%),
      linear-gradient(180deg, #eaf0f8 0%, #dfe7f3 100%);
    color: rgba(7, 25, 66, 0.76);
    font-size: 14px;
    font-weight: 600;
  }

  .snoozer-landing-booking-{{ section.id }} .section-pad,
  .snoozer-landing-booking-{{ section.id }} .band {
    padding: 24px;
  }

  .snoozer-landing-booking-{{ section.id }} .heading {
    margin: 0;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .snoozer-landing-booking-{{ section.id }} .grid {
    display: grid;
    gap: 16px;
    margin-top: 18px;
  }

  .snoozer-landing-booking-{{ section.id }} .grid--three,
  .snoozer-landing-booking-{{ section.id }} .grid--difference {
    grid-template-columns: 1fr;
  }

  .snoozer-landing-booking-{{ section.id }} .card {
    height: 100%;
    padding: 20px;
    border: 1px solid rgba(7, 25, 66, 0.08);
    border-radius: 22px;
    background: #ffffff;
  }

  .snoozer-landing-booking-{{ section.id }} .card__title {
    margin: 0;
    font-size: 21px;
    line-height: 1.15;
  }

  .snoozer-landing-booking-{{ section.id }} .card__text {
    margin: 10px 0 0;
    color: rgba(7, 25, 66, 0.76);
    font-size: 16px;
    line-height: 1.5;
  }

  .snoozer-landing-booking-{{ section.id }} .section-copy {
    max-width: 720px;
  }

  .snoozer-landing-booking-{{ section.id }} .calendly-shell {
    margin-top: 20px;
    padding: 10px;
    border: 1px solid rgba(7, 25, 66, 0.08);
    border-radius: 24px;
    background: #ffffff;
    overflow: hidden;
    line-height: 0;
  }

  .snoozer-landing-booking-{{ section.id }} .calendly-inline-widget {
    display: block;
    width: 100%;
    min-width: 320px;
    min-height: 700px;
    height: 700px;
  }

  .snoozer-landing-booking-{{ section.id }} .calendly-shell iframe {
    display: block;
    width: 100%;
    min-width: 320px;
    min-height: 700px !important;
    height: 700px !important;
    border: 0;
  }

  .snoozer-landing-booking-{{ section.id }} .faq {
    display: grid;
    gap: 12px;
    margin-top: 18px;
  }

  .snoozer-landing-booking-{{ section.id }} .faq details {
    border: 1px solid rgba(7, 25, 66, 0.08);
    border-radius: 18px;
    background: #ffffff;
    padding: 16px 18px;
  }

  .snoozer-landing-booking-{{ section.id }} .faq summary {
    cursor: pointer;
    list-style: none;
    font-size: 18px;
    font-weight: 700;
  }

  .snoozer-landing-booking-{{ section.id }} .faq summary::-webkit-details-marker {
    display: none;
  }

  .snoozer-landing-booking-{{ section.id }} .faq__answer {
    margin-top: 12px;
    color: rgba(7, 25, 66, 0.76);
    font-size: 15px;
    line-height: 1.55;
  }

  .snoozer-landing-booking-{{ section.id }} .band {
    background: #071942;
    color: #ffffff;
  }

  .snoozer-landing-booking-{{ section.id }} .band .heading,
  .snoozer-landing-booking-{{ section.id }} .band .subtext {
    color: #ffffff;
  }

  @media screen and (min-width: 750px) {
    .snoozer-landing-booking-{{ section.id }} {
      padding: 0 24px;
    }

    .snoozer-landing-booking-{{ section.id }} .grid--three,
    .snoozer-landing-booking-{{ section.id }} .grid--difference {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .snoozer-landing-booking-{{ section.id }} {
      padding: 0 32px;
    }

    .snoozer-landing-booking-{{ section.id }} .hero {
      grid-template-columns: minmax(0, 1.02fr) minmax(360px, 0.98fr);
      gap: 28px;
      padding: 36px;
      align-items: center;
    }

    .snoozer-landing-booking-{{ section.id }} .title {
      font-size: 50px;
    }

    .snoozer-landing-booking-{{ section.id }} .visual,
    .snoozer-landing-booking-{{ section.id }} .fallback,
    .snoozer-landing-booking-{{ section.id }} .visual img {
      min-height: 300px;
      height: 100%;
    }

    .snoozer-landing-booking-{{ section.id }} .section-pad,
    .snoozer-landing-booking-{{ section.id }} .band {
      padding: 30px 32px;
    }
  }

  @media screen and (max-width: 749px) {
    .snoozer-landing-booking-{{ section.id }} .button {
      width: 100%;
    }

    .snoozer-landing-booking-{{ section.id }} .calendly-inline-widget {
      min-height: 800px;
      height: 800px;
    }

    .snoozer-landing-booking-{{ section.id }} .calendly-shell iframe {
      min-height: 800px !important;
      height: 800px !important;
    }
  }
{%- endstyle -%}

<section class="section">
  <div class="snoozer-landing-booking-{{ section.id }}">
    <div class="landing-stack">
      <div class="panel panel--soft">
        <div class="hero">
          <div>
            {%- if section.settings.hero_eyebrow != blank -%}
              <p class="eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
            {%- endif -%}
            <h1 class="title">{{ section.settings.hero_headline | escape }}</h1>
            <p class="text">{{ section.settings.hero_text | escape }}</p>
            <div class="actions">
              <a
                class="button button--primary"
                href="{% if section.settings.primary_link != blank %}{{ section.settings.primary_link }}{% else %}{{ booking_anchor_href }}{% endif %}"
              >
                {{ section.settings.primary_label | escape }}
              </a>
              <a
                class="button"
                href="{% if section.settings.secondary_link != blank %}{{ section.settings.secondary_link }}{% else %}{{ assessment_page_url }}{% endif %}"
              >
                {{ section.settings.secondary_label | escape }}
              </a>
            </div>
          </div>
          {%- if hero_image != blank -%}
            <div class="visual">
              {{
                hero_image
                | image_url: width: 1400
                | image_tag:
                  widths: '480, 720, 960, 1400',
                  sizes: '(min-width: 990px) 42vw, 100vw',
                  loading: 'lazy',
                  alt: hero_alt | escape
              }}
            </div>
          {%- else -%}
            <div class="fallback">Private Snooze Session</div>
          {%- endif -%}
        </div>
      </div>

      <div class="panel">
        <div class="section-pad">
          <h2 class="heading">{{ section.settings.visit_heading | escape }}</h2>
          <div class="grid grid--three">
            {%- for block in visit_steps -%}
              <div class="card" {{ block.shopify_attributes }}>
                <h3 class="card__title">{{ block.settings.title | escape }}</h3>
                {%- if block.settings.text != blank -%}
                  <p class="card__text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="section-pad">
          <h2 class="heading">{{ section.settings.different_heading | escape }}</h2>
          <p class="subtext section-copy">{{ section.settings.different_text | escape }}</p>
          <div class="grid grid--difference">
            {%- for block in difference_cards -%}
              <div class="card" {{ block.shopify_attributes }}>
                <h3 class="card__title">{{ block.settings.title | escape }}</h3>
                {%- if block.settings.text != blank -%}
                  <p class="card__text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>

      <div class="panel panel--soft">
        <div class="section-pad">
          <h2 class="heading">{{ section.settings.assessment_heading | escape }}</h2>
          <p class="subtext section-copy">{{ section.settings.assessment_text | escape }}</p>
          <div class="actions">
            <a
              class="button button--primary"
              href="{% if section.settings.assessment_link != blank %}{{ section.settings.assessment_link }}{% else %}{{ assessment_page_url }}{% endif %}"
            >
              {{ section.settings.assessment_label | escape }}
            </a>
          </div>
        </div>
      </div>

      <div class="panel" id="{{ booking_anchor_id }}">
        <div class="section-pad">
          <h2 class="heading">{{ section.settings.booking_heading | escape }}</h2>
          <p class="subtext section-copy">{{ section.settings.booking_text | escape }}</p>
          <div class="calendly-shell">
            <div
              id="CalendlyInlineWidget-{{ section.id }}"
              class="calendly-inline-widget"
              data-url="{{ calendly_url | escape }}"
              style="min-width:320px;height:700px;"
            ></div>
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="section-pad">
          <h2 class="heading">{{ section.settings.faq_heading | escape }}</h2>
          <div class="faq">
            {%- for block in faq_items -%}
              <details {{ block.shopify_attributes }}>
                <summary>{{ block.settings.question | escape }}</summary>
                <div class="faq__answer">{{ block.settings.answer | escape }}</div>
              </details>
            {%- endfor -%}
          </div>
        </div>
      </div>

      <div class="band">
        <h2 class="heading">{{ section.settings.final_heading | escape }}</h2>
        <p class="subtext">{{ section.settings.final_text | escape }}</p>
        <div class="actions">
          <a
            class="button"
            href="{% if section.settings.final_primary_link != blank %}{{ section.settings.final_primary_link }}{% else %}{{ booking_anchor_href }}{% endif %}"
          >
            {{ section.settings.final_primary_label | escape }}
          </a>
          <a
            class="button"
            href="{% if section.settings.final_secondary_link != blank %}{{ section.settings.final_secondary_link }}{% else %}{{ assessment_page_url }}{% endif %}"
          >
            {{ section.settings.final_secondary_label | escape }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var widgetId = 'CalendlyInlineWidget-{{ section.id }}';
    var widgetRoot = null;

    function getWidgetRoot() {
      if (widgetRoot && document.body.contains(widgetRoot)) return widgetRoot;
      widgetRoot = document.getElementById(widgetId);
      return widgetRoot;
    }

    function applyWidgetSizing(root) {
      if (!root) return;
      var mobile = window.matchMedia('(max-width: 749px)').matches;
      var nextHeight = mobile ? '800px' : '700px';
      root.style.width = '100%';
      root.style.minWidth = '320px';
      root.style.minHeight = nextHeight;
      root.style.height = nextHeight;
    }

    function mountCalendly(options) {
      var root = getWidgetRoot();
      if (!root) return;
      applyWidgetSizing(root);
      if (!window.Calendly || typeof window.Calendly.initInlineWidget !== 'function') return;

      var forceRemount = Boolean(options && options.force);
      if (!forceRemount && root.querySelector('iframe')) {
        root.dataset.calendlyMounted = 'true';
        return;
      }
      if (!forceRemount && root.dataset.calendlyMounted === 'true') return;

      root.innerHTML = '';
      window.Calendly.initInlineWidget({
        url: root.getAttribute('data-url'),
        parentElement: root
      });
      root.dataset.calendlyMounted = 'true';
    }

    function loadCalendlyScript() {
      if (window.Calendly && typeof window.Calendly.initInlineWidget === 'function') {
        return Promise.resolve(window.Calendly);
      }

      if (window.__mysnoozepodCalendlyLoader) {
        return window.__mysnoozepodCalendlyLoader;
      }

      window.__mysnoozepodCalendlyLoader = new Promise(function (resolve, reject) {
        var existingScript = document.querySelector('script[data-calendly-widget-script="true"]');
        if (existingScript) {
          if (window.Calendly && typeof window.Calendly.initInlineWidget === 'function') {
            resolve(window.Calendly);
            return;
          }

          existingScript.addEventListener('load', function () {
            resolve(window.Calendly);
          }, { once: true });
          existingScript.addEventListener('error', reject, { once: true });
          return;
        }

        var script = document.createElement('script');
        script.src = 'https://assets.calendly.com/assets/external/widget.js';
        script.async = true;
        script.setAttribute('data-calendly-widget-script', 'true');
        script.addEventListener('load', function () {
          resolve(window.Calendly);
        }, { once: true });
        script.addEventListener('error', reject, { once: true });
        document.head.appendChild(script);
      });

      return window.__mysnoozepodCalendlyLoader;
    }

    loadCalendlyScript().then(function () {
      mountCalendly({ force: true });
    }).catch(function () {});

    window.addEventListener('resize', function () {
      var root = getWidgetRoot();
      if (!root) return;
      applyWidgetSizing(root);
    });

    document.addEventListener('shopify:section:load', function (event) {
      if (!event.target || !event.target.querySelector) return;
      if (!event.target.querySelector('#' + widgetId)) return;
      widgetRoot = event.target.querySelector('#' + widgetId);
      loadCalendlyScript().then(function () {
        mountCalendly({ force: true });
      }).catch(function () {});
    });
  })();
</script>

{% schema %}
