      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Do I need to complete a separate Snooze Assessment?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "No. For this booking page, the key prep questions are built into the scheduling flow so your visit starts with direction." }
      ]
    }
  ],
  "presets": [
