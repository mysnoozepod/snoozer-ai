{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign is_value_strip = false
  if section.id == 'value-strip' or section.id contains 'value-strip'
    assign is_value_strip = true
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding .multicolumn-card__icon-wrapper {
    width: 4.8rem;
    height: 4.8rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(var(--color-foreground), 0.08);
    color: rgb(var(--color-foreground));
  }

  .section-{{ section.id }}-padding .multicolumn-card__icon-wrapper .svg-wrapper {
    width: 2rem;
    height: 2rem;
  }

  .section-{{ section.id }}-padding .multicolumn-card__icon-wrapper svg {
    width: 100%;
    height: 100%;
  }

  {%- if is_value_strip -%}
    .section-{{ section.id }}-padding .multicolumn-card__chevron {
      display: none;
    }

    @media screen and (max-width: 749px) {
      .section-{{ section.id }}-padding {
        max-width: var(--content-max);
        padding-top: var(--sp-5) !important;
        padding-bottom: var(--sp-5) !important;
        padding-left: var(--page-padding-mobile);
        padding-right: var(--page-padding-mobile);
      }

      .section-{{ section.id }}-padding .multicolumn-list {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 10px;
        overflow: visible;
        padding-bottom: 0;
      }

      .section-{{ section.id }}-padding .multicolumn-list__item {
        width: 100%;
      }

      .section-{{ section.id }}-padding .slider-buttons {
        display: none !important;
      }

      .section-{{ section.id }}-padding .multicolumn-card {
        display: grid;
        position: relative;
        grid-template-columns: 42px minmax(0, 1fr) 18px;
        align-items: center;
        column-gap: 12px;
        text-align: left;
        width: 100%;
        min-height: 72px;
        padding: 12px 14px;
        border: var(--card-border);
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 0.4rem 1.2rem rgba(8, 25, 55, 0.04);
      }

      .section-{{ section.id }}-padding .multicolumn-card__image-wrapper {
        width: auto;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .section-{{ section.id }}-padding .multicolumn-card__icon-wrapper {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-pill);
        background: #eef2f7;
        color: rgb(var(--color-primary-navy));
        margin: 0;
      }

      .section-{{ section.id }}-padding .multicolumn-card__icon-wrapper .svg-wrapper,
      .section-{{ section.id }}-padding .multicolumn-card__icon-wrapper svg,
      .section-{{ section.id }}-padding .multicolumn-card__icon-wrapper img {
        width: 20px;
        height: 20px;
      }

      .section-{{ section.id }}-padding .multicolumn-card__image-wrapper + .multicolumn-card__info {
        padding-top: 0;
      }

      .section-{{ section.id }}-padding .multicolumn-card__info {
        padding: 0;
        width: 100%;
        display: grid;
        justify-items: start;
        align-content: center;
        text-align: left;
        min-width: 0;
      }

      .section-{{ section.id }}-padding .multicolumn-card__info h3 {
        font-size: 16px;
        line-height: 1.15;
        font-weight: 700;
        margin: 0 0 var(--sp-1);
        color: rgb(var(--color-primary-navy));
        letter-spacing: -0.03em;
      }

      .section-{{ section.id }}-padding .multicolumn-card__info .rte {
        max-width: none;
        margin: 0;
        font-size: 13.5px;
        line-height: 1.25;
        color: rgba(var(--color-text-primary), 0.82);
      }

      .section-{{ section.id }}-padding .multicolumn-card__info .rte p {
        margin: 0;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
      }

      .section-{{ section.id }}-padding .multicolumn-card__chevron {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        color: rgb(var(--color-primary-navy));
        justify-self: end;
        align-self: center;
      }

      .section-{{ section.id }}-padding .multicolumn-card__chevron .svg-wrapper,
      .section-{{ section.id }}-padding .multicolumn-card__chevron svg {
        width: 18px;
        height: 18px;
      }
    }
  {%- elsif section.id == 'how-it-works' -%}
    .section-{{ section.id }}-padding {
      padding-top: 2.8rem !important;
      padding-bottom: 3.2rem !important;
    }

    .section-{{ section.id }}-padding .multicolumn__title {
      margin-bottom: 1.8rem;
    }

    .section-{{ section.id }}-padding .multicolumn-list {
      gap: 1.6rem;
    }

    .section-{{ section.id }}-padding .multicolumn-card {
      height: 100%;
      min-height: 19rem;
      padding: 2.4rem 2.2rem;
      border: 0.1rem solid rgba(var(--color-text-primary), 0.06);
      border-radius: 2rem;
      background: rgb(var(--color-background));
      box-shadow: 0 1.2rem 3rem rgba(7, 26, 68, 0.06);
      position: relative;
      transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
      overflow: hidden;
    }

    .section-{{ section.id }}-padding .multicolumn-card:hover {
      transform: translateY(-0.3rem);
      box-shadow: 0 1.8rem 3.6rem rgba(7, 26, 68, 0.1);
      border-color: rgba(var(--color-primary-navy), 0.12);
    }

    .section-{{ section.id }}-padding .multicolumn-card:active {
      transform: scale(0.99);
    }

    .section-{{ section.id }}-padding .multicolumn-card__image-wrapper,
    .section-{{ section.id }}-padding .multicolumn-card__step-label {
      display: none;
    }

    .section-{{ section.id }}-padding .multicolumn-card__icon-wrapper {
      width: 5.4rem;
      height: 5.4rem;
      background: #eef2f7;
      color: rgb(var(--color-primary-navy));
      margin: 0 0 1.6rem;
    }

    .section-{{ section.id }}-padding .multicolumn-card__icon-wrapper .svg-wrapper {
      width: 2.8rem;
      height: 2.8rem;
    }

    .section-{{ section.id }}-padding .multicolumn-card--linked {
      cursor: pointer;
    }

    .section-{{ section.id }}-padding .multicolumn-card__info {
      padding: 0;
      position: relative;
      z-index: 1;
    }

    .section-{{ section.id }}-padding .multicolumn-card__overlay-link,
    .section-{{ section.id }}-padding .multicolumn-card__overlay-button {
      position: absolute;
      inset: 0;
      z-index: 2;
      border: 0;
      padding: 0;
      margin: 0;
      border-radius: inherit;
      background: transparent;
      cursor: pointer;
    }

    .section-{{ section.id }}-padding .multicolumn-card__info h3 {
      font-size: 2.4rem;
      line-height: 3rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: rgb(var(--color-primary-navy));
      letter-spacing: -0.03em;
    }

    .section-{{ section.id }}-padding .multicolumn-card__info .rte {
      font-size: 1.7rem;
      line-height: 2.4rem;
      color: rgba(var(--color-text-primary), 0.82);
    }

    .section-{{ section.id }}-padding .multicolumn-card__info .rte p {
      margin: 0;
    }

    .section-{{ section.id }}-padding .multicolumn-list {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(28rem, 82%);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-bottom: 0.4rem;
      scroll-padding-inline: 1.6rem;
    }

    .section-{{ section.id }}-padding .multicolumn-list::-webkit-scrollbar {
      display: none;
    }

    .section-{{ section.id }}-padding .multicolumn-list__item {
      scroll-snap-align: center;
    }

    .section-{{ section.id }}-padding .slider-buttons {
      display: none !important;
    }

  {%- elsif section.id == 'why-guided-benefits' -%}
    .section-{{ section.id }}-padding {
      padding-top: 0 !important;
      padding-bottom: 6.4rem !important;
    }

    .section-{{ section.id }}-padding .multicolumn-list {
      gap: 2rem;
    }

    .section-{{ section.id }}-padding .multicolumn-card {
      height: 100%;
      padding: 2.4rem;
      border: 0.1rem solid rgba(var(--color-text-primary), 0.08);
      border-radius: 1.6rem;
      background: rgb(var(--color-background));
    }

    .section-{{ section.id }}-padding .multicolumn-card__image-wrapper {
      margin: 0 0 1.6rem;
      width: auto;
    }

    .section-{{ section.id }}-padding .multicolumn-card__icon-wrapper {
      width: 5rem;
      height: 5rem;
      background: rgba(var(--color-primary-navy), 0.06);
      color: rgb(var(--color-primary-navy));
    }

    .section-{{ section.id }}-padding .multicolumn-card__image-wrapper + .multicolumn-card__info {
      padding-top: 0;
    }

    .section-{{ section.id }}-padding .multicolumn-card__info {
      padding: 0;
    }

    .section-{{ section.id }}-padding .multicolumn-card__info h3 {
      font-size: 1.9rem;
      line-height: 2.6rem;
      margin-bottom: 0.8rem;
    }
  {%- elsif section.id == 'category-navigation' or section.id == 'collection_list_KVb8Pk' -%}
    .section-{{ section.id }}-padding {
      padding-top: 3.2rem !important;
      padding-bottom: 4rem !important;
    }

    .section-{{ section.id }}-padding .multicolumn__title {
      margin-bottom: 1.6rem;
    }

    .section-{{ section.id }}-padding .multicolumn-list {
      gap: 1.6rem;
    }

    .section-{{ section.id }}-padding .multicolumn-card {
      height: 100%;
      padding: 2rem;
      border: 0.1rem solid rgba(var(--color-text-primary), 0.08);
      border-radius: 1.6rem;
      background: rgb(var(--color-background));
    }

    .section-{{ section.id }}-padding .multicolumn-card__image-wrapper {
      margin: 0 0 1.6rem;
      width: auto;
    }

    .section-{{ section.id }}-padding .multicolumn-card__image-wrapper + .multicolumn-card__info {
      padding-top: 0;
    }

    .section-{{ section.id }}-padding .multicolumn-card__info {
      padding: 0;
    }

    .section-{{ section.id }}-padding .multicolumn-card__info h3 {
      font-size: 1.9rem;
      line-height: 2.6rem;
      margin-bottom: 0.8rem;
    }

    .section-{{ section.id }}-padding .multicolumn-card__info .link {
      margin-top: 1.6rem;
      font-weight: 500;
    }
  {%- endif -%}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    {%- if section.id == 'value-strip' -%}
      .section-{{ section.id }}-padding {
        padding-top: var(--sp-6) !important;
        padding-bottom: var(--sp-6) !important;
        padding-left: var(--page-padding-tablet);
        padding-right: var(--page-padding-tablet);
      }

      .section-{{ section.id }}-padding .multicolumn-list {
        display: grid;
        grid-auto-flow: row;
        grid-auto-columns: initial;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        justify-content: center;
        gap: var(--sp-5);
        overflow: visible;
        scroll-snap-type: none;
        padding-bottom: 0;
      }

      .section-{{ section.id }}-padding .multicolumn-card {
        max-width: none;
        min-height: 100%;
        grid-template-columns: minmax(0, 1fr);
        justify-items: center;
        text-align: center;
        row-gap: var(--sp-4);
        padding: var(--card-padding-desktop);
      }

      .section-{{ section.id }}-padding .multicolumn-card__icon-wrapper {
        width: 5.6rem;
        height: 5.6rem;
        margin: 0 auto;
      }

      .section-{{ section.id }}-padding .multicolumn-card__icon-wrapper .svg-wrapper,
      .section-{{ section.id }}-padding .multicolumn-card__icon-wrapper svg,
      .section-{{ section.id }}-padding .multicolumn-card__icon-wrapper img {
        width: 2.8rem;
        height: 2.8rem;
      }

      .section-{{ section.id }}-padding .multicolumn-card__info {
        justify-items: center;
      }

      .section-{{ section.id }}-padding .multicolumn-card__chevron {
        display: none;
      }

      .section-{{ section.id }}-padding .multicolumn-card__info .rte {
        max-width: 22rem;
      }

      .section-{{ section.id }}-padding .multicolumn-card__info h3 {
        font-size: var(--h3-desktop);
      }
    {%- elsif section.id == 'how-it-works' -%}
      .section-{{ section.id }}-padding {
        padding-top: 3.2rem !important;
        padding-bottom: 4rem !important;
      }

      .section-{{ section.id }}-padding .multicolumn-list {
        display: grid;
        grid-auto-flow: row;
        grid-auto-columns: initial;
        overflow: visible;
        scroll-snap-type: none;
        padding-bottom: 0;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .section-{{ section.id }}-padding .multicolumn-card {
        min-height: 22rem;
        padding: 2.8rem;
      }

      .section-{{ section.id }}-padding .multicolumn-card__icon-wrapper {
        width: 6rem;
        height: 6rem;
      }

      .section-{{ section.id }}-padding .multicolumn-card__icon-wrapper .svg-wrapper {
        width: 3.2rem;
        height: 3.2rem;
      }
    {%- elsif section.id == 'category-navigation' or section.id == 'collection_list_KVb8Pk' -%}
      .section-{{ section.id }}-padding {
        padding-top: 4rem !important;
        padding-bottom: 4.8rem !important;
      }
    {%- elsif section.id == 'why-guided-benefits' -%}
      .section-{{ section.id }}-padding {
        padding-bottom: 7.2rem !important;
      }
    {%- endif -%}
  }

  @media screen and (min-width: 990px) {
    {%- if section.id == 'how-it-works' -%}
      .section-{{ section.id }}-padding .multicolumn__title {
        margin-bottom: 2rem;
      }

    {%- elsif section.id == 'why-guided-benefits' -%}
      .section-{{ section.id }}-padding {
        padding-bottom: 8rem !important;
      }
    {%- endif -%}
  }
{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif
-%}

<div class="multicolumn color-{{ section.settings.color_scheme }} gradient{% unless section.settings.background_style == 'none' and settings.text_boxes_border_thickness > 0 or settings.text_boxes_shadow_opacity > 0 %} background-{{ section.settings.background_style }}{% endunless %}{% if section.settings.title == blank %} no-heading{% endif %}">
  <div
    class="page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin multicolumn__title">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
        {%- if section.settings.button_label != blank and show_mobile_slider -%}
          <a href="{{ section.settings.button_link }}" class="link underlined-link large-up-hide">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}
    <slider-component class="slider-mobile-gutter">
      <ul
        class="multicolumn-list contains-content-container grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop{% if show_mobile_slider %} slider slider--tablet grid--peek{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- liquid
          assign highest_ratio = 0
          for block in section.blocks
            if block.settings.image.aspect_ratio > highest_ratio
              assign highest_ratio = block.settings.image.aspect_ratio
            endif
          endfor
        -%}
        {%- for block in section.blocks -%}
          {%- assign empty_column = '' -%}
          {%- assign has_icon = false -%}
          {%- assign is_how_it_works_card = false -%}
          {%- assign is_snoozer_trigger = false -%}
          {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
            {%- assign has_icon = true -%}
          {%- endif -%}
          {%- if section.id == 'how-it-works' -%}
            {%- assign is_how_it_works_card = true -%}
            {%- if block.settings.link == '#ask-snoozer' -%}
              {%- assign is_snoozer_trigger = true -%}
            {%- endif -%}
          {%- endif -%}
          {%- if block.settings.image == blank
            and has_icon == false
            and block.settings.title == blank
            and block.settings.text == blank
            and block.settings.link_label == blank
          -%}
            {%- assign empty_column = ' multicolumn-list__item--empty' -%}
          {%- endif -%}

          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="multicolumn-list__item grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}{% if section.settings.column_alignment == 'center' %} center{% endif %}{{ empty_column }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <div class="multicolumn-card content-container{% if is_how_it_works_card and block.settings.link != blank %} multicolumn-card--linked{% endif %}">
              {%- if is_how_it_works_card and block.settings.link != blank -%}
                {%- if is_snoozer_trigger -%}
                  <button
                    type="button"
                    class="multicolumn-card__overlay-button"
                    data-snoozer-trigger
                    data-snoozer-source="process-card-{{ forloop.index }}"
                    aria-label="{{ block.settings.title | escape }}"
                  ></button>
                {%- else -%}
                  <a
                    href="{{ block.settings.link }}"
                    class="multicolumn-card__overlay-link"
                    aria-label="{{ block.settings.title | escape }}"
                  ></a>
                {%- endif -%}
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                {% if section.settings.image_ratio == 'adapt' or section.settings.image_ratio == 'circle' %}
                  {% assign spaced_image = true %}
                {% endif %}
                <div class="multicolumn-card__image-wrapper multicolumn-card__image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} multicolumn-card-spacing{% endif %}">
                  <div
                    class="media media--transparent media--{{ section.settings.image_ratio }}"
                    {% if section.settings.image_ratio == 'adapt' %}
                      style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
                    {% endif %}
                  >
                    {%- liquid
                      assign number_of_columns = section.settings.columns_desktop
                      assign number_of_columns_mobile = section.settings.columns_mobile
                      assign grid_space_desktop = number_of_columns | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                      assign grid_space_tablet = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                      assign grid_space_mobile = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | divided_by: 2 | plus: 30 | append: 'px'
                      if section.settings.image_width == 'half'
                        assign image_width = 0.5
                      elsif section.settings.image_width == 'third'
                        assign image_width = 0.33
                      else
                        assign image_width = 1
                      endif
                    -%}
                    {% capture sizes %}
                      (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ grid_space_desktop }}) * {{ image_width }} /  {{ number_of_columns }}),
                      (min-width: 990px) calc((100vw - {{ grid_space_desktop }}) * {{ image_width }} / {{ number_of_columns }}),
                      (min-width: 750px) calc((100vw - {{ grid_space_tablet }}) * {{ image_width }} / {{ number_of_columns_mobile }}),
                      calc((100vw - {{ grid_space_mobile }}) * {{ image_width }} / {{ number_of_columns_mobile }})
                    {% endcapture %}
                    {{
                      block.settings.image
                      | image_url: width: 3200
                      | image_tag:
                        widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                        sizes: sizes,
                        class: 'multicolumn-card__image'
                    }}
                  </div>
                </div>
              {%- elsif has_icon -%}
                <div class="multicolumn-card__image-wrapper multicolumn-card__image-wrapper--third-width multicolumn-card-spacing">
                  <div class="multicolumn-card__icon-wrapper">
                    {% render 'icon-accordion', icon: block.settings.icon %}
                  </div>
                </div>
              {%- endif -%}
              <div class="multicolumn-card__info">
                {%- if section.id == 'how-it-works' and is_how_it_works_card == false -%}
                  <p class="multicolumn-card__step-label">Step {{ forloop.index }}</p>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="inline-richtext">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.link_label != blank and is_how_it_works_card == false -%}
                  <a
                    class="link animate-arrow"
                    {% if block.settings.link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.link }}"
                    {% endif %}
                  >
                    {{- block.settings.link_label | escape -}}
                    <span class="svg-wrapper"
                      ><span class="icon-wrap">&nbsp;{{ 'icon-arrow.svg' | inline_asset_content }}</span></span
                    >
                  </a>
                {%- endif -%}
              </div>
              {%- if is_value_strip -%}
                <span class="multicolumn-card__chevron" aria-hidden="true">
                  <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
                </span>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_mobile_slider -%}
        <div class="slider-buttons large-up-hide">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
    <div class="center{% if show_mobile_slider %} small-hide medium-hide{% endif %}">
      {%- if section.settings.button_label != blank -%}
        <a
          class="button button--primary"
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

