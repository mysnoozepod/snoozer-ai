{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .split-image-section__grid {
    display: grid;
    gap: 2.4rem;
    align-items: center;
  }

  .split-image-section__content {
    max-width: 52rem;
  }

  .split-image-section__heading {
    margin: 0 0 1.6rem;
  }

  .split-image-section__text {
    margin: 0 0 2.4rem;
    color: rgb(var(--color-text-secondary));
  }

  .split-image-section__media {
    overflow: hidden;
    border-radius: 1.6rem;
    border: 0.1rem solid rgba(var(--color-text-primary), 0.08);
    background: rgb(var(--color-background));
    aspect-ratio: 3 / 2;
  }

  .split-image-section__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .split-image-section__grid {
      grid-template-columns: minmax(0, 1fr) minmax(32rem, 48rem);
      gap: 4.8rem;
    }

    .split-image-section__grid--image-left .split-image-section__media {
      order: -1;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="split-image-section__grid split-image-section__grid--image-{{ section.settings.image_position }}">
      <div class="split-image-section__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="split-image-section__heading h2">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="split-image-section__text rte">
            <p>{{ section.settings.text | escape | newline_to_br }}</p>
          </div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
            class="button button--primary"
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
      {%- if section.settings.image != blank -%}
        <div class="split-image-section__media">
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              widths: '480, 720, 960, 1200, 1600, 2000, 2400',
              sizes: '(min-width: 990px) 48rem, 100vw',
              class: 'split-image-section__image',
              loading: 'lazy',
              alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Split image section",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The SnoozePod Unmanned Showroom"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Experience mattresses in a private, pressure-free environment. Explore at your own pace, test what you like, and get guidance on your terms."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book a Snooze Session"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Split image section"
    }
  ]
}
{% endschema %}
