{% comment %}
  Dormant prototype only.
  Do not place this section on customer-facing pages.
  The live Snoozer experience is handled in the header HUD and dedicated landing surfaces.
{% endcomment %}

{% if request.design_mode %}
  <div class="snoozer-interface-note">
    <p class="snoozer-interface-note__eyebrow">Internal Only</p>
    <h2 class="snoozer-interface-note__title">Dormant Snoozer prototype</h2>
    <p class="snoozer-interface-note__copy">
      This section is not connected to the live Snoozer flow and should stay off customer-facing pages.
    </p>
  </div>

  <style>
    .snoozer-interface-note {
      max-width: 760px;
      margin: 24px auto;
      padding: 24px;
      border: 1px dashed rgba(7, 25, 66, 0.2);
      border-radius: 20px;
      background: #f5f7fb;
      color: #071942;
      text-align: left;
    }

    .snoozer-interface-note__eyebrow {
      margin: 0 0 10px;
      color: rgba(7, 25, 66, 0.64);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.12em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .snoozer-interface-note__title {
      margin: 0;
      font-size: 28px;
      line-height: 1.1;
      letter-spacing: -0.03em;
    }

    .snoozer-interface-note__copy {
      margin: 12px 0 0;
      color: rgba(7, 25, 66, 0.78);
      font-size: 16px;
      line-height: 1.55;
    }
  </style>
{% endif %}

{% schema %}
  {
    "name": "Snoozer Interface (Dormant)",
    "settings": []
  }
{% endschema %}
