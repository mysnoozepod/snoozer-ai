{%- style -%}
  .snoozepod-collection-cta-{{ section.id }} {
    max-width: 1480px;
    margin: 24px 16px 48px;
  }

  .snoozepod-collection-cta-{{ section.id }} .snoozepod-collection-cta__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding: 32px 24px;
    border-radius: 34px;
    background: linear-gradient(135deg, #071942 0%, #2c4278 100%);
    color: #ffffff;
  }

  .snoozepod-collection-cta-{{ section.id }} .snoozepod-collection-cta__copy {
    min-width: 0;
  }

  .snoozepod-collection-cta-{{ section.id }} .snoozepod-collection-cta__heading {
    margin: 0;
    color: #ffffff;
    font-size: 34px;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .snoozepod-collection-cta-{{ section.id }} .snoozepod-collection-cta__body {
    margin: 16px 0 0;
    max-width: 660px;
    color: rgba(255, 255, 255, 0.88);
    font-size: 17px;
    line-height: 1.45;
  }

  .snoozepod-collection-cta-{{ section.id }} .snoozepod-collection-cta__body p {
    margin: 0;
  }

  .snoozepod-collection-cta-{{ section.id }} .snoozepod-collection-cta__actions {
    display: grid;
    width: 100%;
    gap: 12px;
  }

  .snoozepod-collection-cta-{{ section.id }} .snoozepod-collection-cta__actions .button,
  .snoozepod-collection-cta-{{ section.id }} .snoozepod-collection-cta__actions .snoozepod-collection-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 58px;
    padding: 0 34px;
    border-radius: 999px;
    font-size: 17px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }

  .snoozepod-collection-cta-{{ section.id }} .snoozepod-collection-cta__button--primary {
    background: #ffffff;
    color: #071942;
  }

  .snoozepod-collection-cta-{{ section.id }} .snoozepod-collection-cta__button--secondary {
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.45);
  }

  @media screen and (min-width: 750px) {
    .snoozepod-collection-cta-{{ section.id }} {
      margin-left: 24px;
      margin-right: 24px;
    }
  }

  @media screen and (min-width: 990px) {
    .snoozepod-collection-cta-{{ section.id }} {
      margin: 48px auto 72px;
    }

    .snoozepod-collection-cta-{{ section.id }} .snoozepod-collection-cta__card {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 40px;
      padding: 48px 64px;
      border-radius: 32px;
    }

    .snoozepod-collection-cta-{{ section.id }} .snoozepod-collection-cta__heading {
      font-size: 46px;
    }

    .snoozepod-collection-cta-{{ section.id }} .snoozepod-collection-cta__body {
      font-size: 20px;
    }

    .snoozepod-collection-cta-{{ section.id }} .snoozepod-collection-cta__actions {
      display: inline-flex;
      flex-wrap: wrap;
      justify-content: flex-start;
      width: auto;
      gap: 18px;
    }

    .snoozepod-collection-cta-{{ section.id }} .snoozepod-collection-cta__button--primary {
      min-width: 300px;
    }

    .snoozepod-collection-cta-{{ section.id }} .snoozepod-collection-cta__button--secondary {
      min-width: 280px;
    }
  }
{%- endstyle -%}

<section class="section snoozepod-collection-cta-section">
  <div class="snoozepod-collection-cta-{{ section.id }}">
    <div class="snoozepod-collection-cta__card">
      <div class="snoozepod-collection-cta__copy">
        <h2 class="snoozepod-collection-cta__heading">{{ section.settings.heading | escape }}</h2>
        <div class="snoozepod-collection-cta__body rte">
          <p>{{ section.settings.body | escape }}</p>
        </div>
      </div>

      <div class="snoozepod-collection-cta__actions">
        <a
          class="snoozepod-collection-cta__button snoozepod-collection-cta__button--primary"
          href="{% if section.settings.primary_link != blank %}{{ section.settings.primary_link }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
        >
          {{ section.settings.primary_label | escape }}
        </a>

        {%- if section.settings.show_secondary and section.settings.secondary_label != blank -%}
          {%- if section.settings.secondary_link != blank and section.settings.secondary_link != '#ask-snoozer' -%}
            <a
              class="snoozepod-collection-cta__button snoozepod-collection-cta__button--secondary"
              href="{{ section.settings.secondary_link }}"
            >
              {{ section.settings.secondary_label | escape }}
            </a>
          {%- else -%}
            <button
              type="button"
              class="snoozepod-collection-cta__button snoozepod-collection-cta__button--secondary"
              data-snoozer-trigger
              data-snoozer-source="collection-final-cta"
            >
              {{ section.settings.secondary_label | escape }}
            </button>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SnoozePod collection CTA",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Around Better Sleep"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Explore this collection, then use Snoozer to connect the right pieces around your sleep needs."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary CTA label",
      "default": "Explore Products"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary CTA label",
      "default": "Ask Snoozer"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary CTA link"
    },
    {
      "type": "checkbox",
      "id": "show_secondary",
      "label": "Show secondary CTA",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "SnoozePod collection CTA"
    }
  ]
}
{% endschema %}
