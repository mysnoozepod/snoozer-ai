{%- style -%}
  .homepage-shelf-section--featured {
    background: #f7f9fc;
  }

  .homepage-shelf-section--featured .section-{{ section.id }}-padding {
    padding-top: var(--sp-6) !important;
    padding-bottom: var(--sp-6) !important;
  }

  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
  }

  .section-{{ section.id }}-padding .homepage-shelf--full {
    background: transparent;
  }

  {%- if section.id == 'light-product-preview' or section.id == 'featured_collection_4WFByd' -%}
    .section-{{ section.id }}-padding {
      padding-top: 3.2rem !important;
      padding-bottom: 4rem !important;
    }

    .section-{{ section.id }}-padding .homepage-shelf__header {
      display: grid;
      gap: 1.2rem;
      margin-bottom: 2rem;
    }

    .section-{{ section.id }}-padding .homepage-shelf__title {
      margin: 0;
    }

    .section-{{ section.id }}-padding .homepage-shelf__copy {
      max-width: 58rem;
    }

    .section-{{ section.id }}-padding .homepage-shelf__description {
      color: rgb(var(--color-text-secondary));
    }

    .section-{{ section.id }}-padding .homepage-shelf__description p {
      margin: 0;
    }

    .section-{{ section.id }}-padding .homepage-shelf__link {
      font-weight: 600;
      text-underline-offset: 0.3rem;
    }

    .section-{{ section.id }}-padding .homepage-fit-grid {
      --grid-mobile-horizontal-spacing: 1.2rem;
      --grid-mobile-vertical-spacing: 1.2rem;
      --grid-desktop-horizontal-spacing: 2rem;
      --grid-desktop-vertical-spacing: 2rem;
      margin-bottom: 0;
    }

    .section-{{ section.id }}-padding .homepage-fit-card {
      height: 100%;
      padding: 2rem;
      border: 0.1rem solid rgba(var(--color-text-primary), 0.08);
      border-radius: 1.6rem;
      background: rgb(var(--color-background));
    }

    .section-{{ section.id }}-padding .homepage-fit-card__title {
      margin: 0 0 1rem;
    }

    .section-{{ section.id }}-padding .homepage-fit-card__copy,
    .section-{{ section.id }}-padding .homepage-fit-card__support {
      margin: 0;
    }

    .section-{{ section.id }}-padding .homepage-fit-card__support {
      margin-top: 1rem;
      color: rgb(var(--color-text-secondary));
    }

    .section-{{ section.id }}-padding .homepage-shelf__header + .page-width,
    .section-{{ section.id }}-padding .homepage-shelf .product-grid {
      --grid-mobile-horizontal-spacing: 1.2rem;
      --grid-mobile-vertical-spacing: 2rem;
      --grid-desktop-horizontal-spacing: 2rem;
      --grid-desktop-vertical-spacing: 2.4rem;
    }
  {%- elsif section.id == 'showroom' -%}
    .section-{{ section.id }}-padding {
      padding-top: 5.6rem !important;
      padding-bottom: 5.6rem !important;
    }

    .section-{{ section.id }}-padding .homepage-showroom {
      display: grid;
      gap: 2.4rem;
      align-items: center;
    }

    .section-{{ section.id }}-padding .homepage-showroom__content {
      max-width: 52rem;
    }

    .section-{{ section.id }}-padding .homepage-showroom__heading {
      margin: 0 0 1.6rem;
    }

    .section-{{ section.id }}-padding .homepage-showroom__copy {
      margin: 0 0 2.4rem;
      color: rgb(var(--color-text-secondary));
    }

    .section-{{ section.id }}-padding .homepage-showroom__media {
      overflow: hidden;
      border-radius: 1.6rem;
      border: 0.1rem solid rgba(var(--color-text-primary), 0.08);
      background: rgb(var(--color-background));
      aspect-ratio: 4 / 3;
    }

    .section-{{ section.id }}-padding .homepage-showroom__media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  {%- elsif section.id == 'full-product-section' or section.id contains 'featured_collection_666q7i' or section.settings.custom_liquid contains '10-all-foam-mattress|12-all-foam-mattress|12-dual-comfort-hybrid|14-hybrid' -%}
    .section-{{ section.id }}-padding {
      padding-top: var(--sp-6) !important;
      padding-bottom: var(--sp-6) !important;
    }

    .section-{{ section.id }}-padding .homepage-shelf--full .homepage-shelf__inner {
      width: min(100%, var(--content-max));
      margin: 0 auto;
      padding-inline: var(--page-padding-mobile);
    }

    .section-{{ section.id }}-padding .homepage-shelf--full .homepage-shelf__header {
      display: grid;
      gap: var(--sp-3);
      margin-bottom: var(--sp-6);
      text-align: left;
    }

    .section-{{ section.id }}-padding .homepage-shelf--full .homepage-shelf__copy {
      max-width: 62rem;
    }

    .section-{{ section.id }}-padding .homepage-shelf--full .homepage-shelf__title {
      margin: 0;
      font-size: var(--h2-mobile);
      line-height: 1.12;
      letter-spacing: -0.03em;
      color: rgb(var(--color-primary-navy));
    }

    .section-{{ section.id }}-padding .homepage-shelf--full .homepage-shelf__description {
      margin: 0;
      color: rgba(var(--color-text-primary), 0.78);
      font-size: 14px;
      line-height: 1.35;
    }

    .section-{{ section.id }}-padding .homepage-shelf--full .homepage-shelf__description p {
      margin: 0;
    }

    .section-{{ section.id }}-padding .homepage-shelf__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-3);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .section-{{ section.id }}-padding .homepage-shelf__item {
      min-width: 0;
    }

    .section-{{ section.id }}-padding .homepage-shelf-card {
      display: flex;
      flex-direction: column;
      height: 100%;
      min-height: 160px;
      padding: var(--sp-3);
      border: var(--card-border);
      border-radius: var(--radius-md);
      background: #ffffff;
      box-shadow: var(--card-shadow-soft);
      transition: border-color var(--duration-short) ease, box-shadow var(--duration-short) ease,
        transform var(--duration-short) ease;
    }

    .section-{{ section.id }}-padding .homepage-shelf-card__media-link {
      display: block;
      text-decoration: none;
    }

    .section-{{ section.id }}-padding .homepage-shelf-card__media {
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 82px;
      border-radius: var(--radius-md);
      background: linear-gradient(180deg, #faf7f2 0%, #ffffff 100%);
    }

    .section-{{ section.id }}-padding .homepage-shelf-card__image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      opacity: 1;
      filter: contrast(1.03) saturate(1.04);
      transition: transform var(--duration-short) ease;
    }

    .section-{{ section.id }}-padding .homepage-shelf-card__body {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      gap: 4px;
      padding-top: var(--sp-3);
    }

    .section-{{ section.id }}-padding .homepage-shelf-card__title {
      margin: 0;
      font-size: var(--body-mobile);
      line-height: 1.15;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .section-{{ section.id }}-padding .homepage-shelf-card__title-link {
      color: inherit;
      text-decoration: none;
    }

    .section-{{ section.id }}-padding .homepage-shelf-card__descriptor {
      margin: 0;
      color: rgba(var(--color-text-primary), 0.74);
      font-size: var(--small-text);
      line-height: 1.25;
    }

    .section-{{ section.id }}-padding .homepage-shelf-card__cta {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-1);
      margin-top: auto;
      padding-top: 2px;
      color: #071a44;
      font-size: var(--small-text);
      line-height: 1.3;
      font-weight: 600;
      text-decoration: none;
    }

    .section-{{ section.id }}-padding .homepage-shelf-card__cta:hover {
      text-decoration: underline;
      text-underline-offset: 0.25rem;
    }

    .section-{{ section.id }}-padding .homepage-shelf__footer {
      display: flex;
      justify-content: center;
      margin-top: var(--sp-5);
    }

    .section-{{ section.id }}-padding .homepage-shelf__section-cta {
      width: min(100%, 32rem);
      min-height: var(--button-height-mobile);
      padding-inline: var(--sp-5);
      border-radius: var(--button-radius);
      font-size: var(--body-mobile);
      font-weight: 600;
    }
  {%- endif -%}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    {%- if section.id == 'light-product-preview' or section.id == 'featured_collection_4WFByd' -%}
      .section-{{ section.id }}-padding {
        padding-top: 4rem !important;
        padding-bottom: 4.8rem !important;
      }
    {%- elsif section.id == 'showroom' -%}
      .section-{{ section.id }}-padding {
        padding-top: 6.4rem !important;
        padding-bottom: 6.4rem !important;
      }
    {%- elsif section.id == 'full-product-section' or section.id contains 'featured_collection_666q7i' or section.settings.custom_liquid contains '10-all-foam-mattress|12-all-foam-mattress|12-dual-comfort-hybrid|14-hybrid' -%}
      .homepage-shelf-section--featured .section-{{ section.id }}-padding {
        padding-top: var(--sp-8) !important;
        padding-bottom: var(--sp-8) !important;
      }

      .section-{{ section.id }}-padding .homepage-shelf--full .homepage-shelf__inner {
        padding-inline: var(--page-padding-tablet);
      }

      .section-{{ section.id }}-padding .homepage-shelf__grid {
        gap: var(--sp-5);
      }
    {%- endif -%}
  }

  @media screen and (min-width: 990px) {
    {%- if section.id == 'light-product-preview' or section.id == 'featured_collection_4WFByd' -%}
      .section-{{ section.id }}-padding .homepage-shelf__header {
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        gap: 3.2rem;
        margin-bottom: 2.4rem;
      }
    {%- elsif section.id == 'full-product-section' or section.id contains 'featured_collection_666q7i' or section.settings.custom_liquid contains '10-all-foam-mattress|12-all-foam-mattress|12-dual-comfort-hybrid|14-hybrid' -%}
      .section-{{ section.id }}-padding .homepage-shelf--full .homepage-shelf__header {
        margin-bottom: var(--sp-6);
      }

      .section-{{ section.id }}-padding .homepage-shelf--full .homepage-shelf__inner {
        padding-inline: var(--page-padding-desktop);
      }

      .section-{{ section.id }}-padding .homepage-shelf--full .homepage-shelf__title {
        font-size: var(--h2-desktop);
      }

      .section-{{ section.id }}-padding .homepage-shelf--full .homepage-shelf__description {
        font-size: var(--body-desktop);
      }

      .section-{{ section.id }}-padding .homepage-shelf__grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--sp-5);
      }

      .section-{{ section.id }}-padding .homepage-shelf-card {
        padding: var(--card-padding-desktop);
      }

      .section-{{ section.id }}-padding .homepage-shelf-card:hover {
        transform: translateY(-0.3rem);
        box-shadow: 0 1.2rem 3rem rgba(8, 25, 55, 0.08);
      }

      .section-{{ section.id }}-padding .homepage-shelf-card__media {
        height: var(--product-image-height-desktop);
      }

      .section-{{ section.id }}-padding .homepage-shelf-card__title {
        font-size: var(--h3-desktop);
      }

      .section-{{ section.id }}-padding .homepage-shelf-card__descriptor,
      .section-{{ section.id }}-padding .homepage-shelf-card__cta {
        font-size: var(--body-desktop);
      }

      .section-{{ section.id }}-padding .homepage-shelf__section-cta {
        min-height: var(--button-height-desktop);
        font-size: var(--body-desktop);
      }
    {%- elsif section.id == 'showroom' -%}
      .section-{{ section.id }}-padding {
        padding-top: 6.4rem !important;
        padding-bottom: 7.2rem !important;
      }

      .section-{{ section.id }}-padding .homepage-showroom {
        grid-template-columns: minmax(0, 1fr) minmax(32rem, 48rem);
        gap: 4.8rem;
      }
    {%- endif -%}
  }
{%- endstyle -%}
{%- liquid
  assign render_curated_homepage_shelf = false
  if section.id contains 'featured_collection_666q7i' or section.settings.custom_liquid contains '10-all-foam-mattress|12-all-foam-mattress|12-dual-comfort-hybrid|14-hybrid'
    assign render_curated_homepage_shelf = true
  endif
-%}
<div class="color-{{ section.settings.color_scheme }} gradient{% if section.id == 'full-product-section' or section.id contains 'featured_collection_666q7i' or section.settings.custom_liquid contains '10-all-foam-mattress|12-all-foam-mattress|12-dual-comfort-hybrid|14-hybrid' or section.settings.custom_liquid contains 'homepage-shelf--full' %} homepage-shelf-section homepage-shelf-section--featured{% endif %}">
  <div class="section-{{ section.id }}-padding">
    {%- if render_curated_homepage_shelf -%}
      {%- liquid
        assign mattress_collection = collections['mattresses']
        assign mattress_collection_url = routes.all_products_collection_url
        if mattress_collection != blank and mattress_collection.url != blank
          assign mattress_collection_url = mattress_collection.url
        endif
      -%}
      <div class="homepage-shelf homepage-shelf--full">
        <div class="homepage-shelf__inner">
          <div class="homepage-shelf__header">
            <div class="homepage-shelf__copy">
              <h2 class="homepage-shelf__title title inline-richtext h2">Start With The Mattress</h2>
              <div class="homepage-shelf__description collection__description body rte">
                <p>Explore comfort options built for different sleep styles, support needs, and budgets.</p>
              </div>
            </div>
          </div>
          <ul class="homepage-shelf__grid" role="list">
            {%- assign mattress_handles = '10-all-foam-mattress|12-all-foam-mattress|12-dual-comfort-hybrid|14-hybrid' | split: '|' -%}
            {%- for handle in mattress_handles -%}
              {%- assign mattress_product = all_products[handle] -%}
              {%- if mattress_product != blank -%}
                {%- liquid
                  assign card_title = mattress_product.title
                  assign card_descriptor = ''
                  case handle
                    when '10-all-foam-mattress'
                      assign card_title = '10" All Foam'
                      assign card_descriptor = 'Simple comfort. Great value.'
                    when '12-all-foam-mattress'
                      assign card_title = '12" All Foam'
                      assign card_descriptor = 'More comfort. More support.'
                    when '12-dual-comfort-hybrid'
                      assign card_title = '12" Dual Comfort Hybrid'
                      assign card_descriptor = 'Pressure relief + support.'
                    when '14-hybrid'
                      assign card_title = '14" Hybrid'
                      assign card_descriptor = 'Premium support. Luxury feel.'
                  endcase
                  assign card_alt = mattress_product.featured_media.alt | default: mattress_product.title
                -%}
                <li class="homepage-shelf__item">
                  <article class="homepage-shelf-card">
                    <a class="homepage-shelf-card__media-link" href="{{ mattress_product.url }}">
                      <div class="homepage-shelf-card__media">
                        {%- if mattress_product.featured_media -%}
                          {{
                            mattress_product.featured_media
                            | image_url: width: 900
                            | image_tag:
                              class: 'homepage-shelf-card__image',
                              widths: '220, 320, 420, 520, 720, 900',
                              sizes: '(min-width: 990px) calc((min(100vw, 1280px) - 192px) / 4), (min-width: 750px) calc((100vw - 88px) / 2), calc((100vw - 56px) / 2)',
                              loading: 'lazy',
                              alt: card_alt
                          }}
                        {%- endif -%}
                      </div>
                    </a>
                    <div class="homepage-shelf-card__body">
                      <h3 class="homepage-shelf-card__title">
                        <a class="homepage-shelf-card__title-link" href="{{ mattress_product.url }}">
                          {{ card_title }}
                        </a>
                      </h3>
                      <p class="homepage-shelf-card__descriptor">{{ card_descriptor }}</p>
                      <a class="homepage-shelf-card__cta" href="{{ mattress_product.url }}">View &rarr;</a>
                    </div>
                  </article>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          <div class="homepage-shelf__footer">
            <a class="homepage-shelf__section-cta button button--secondary" href="{{ mattress_collection_url }}">
              Shop Mattresses
            </a>
          </div>
        </div>
      </div>
    {%- else -%}
      {{ section.settings.custom_liquid }}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.custom-liquid.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:sections.custom-liquid.settings.custom_liquid.label",
      "info": "t:sections.custom-liquid.settings.custom_liquid.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-liquid.presets.name"
    }
  ]
}
{% endschema %}
