{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
{% comment %}Support pages use inline fallback content here to avoid missing snippet dependencies during theme sync and to preserve live compatibility shims in the active Shopify theme.{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .support-page__editorial-media {
    margin: 2.4rem 0 0;
    overflow: hidden;
    border-radius: 1.6rem;
    background: rgba(var(--color-foreground), 0.04);
    box-shadow: 0 1.6rem 4rem rgba(15, 31, 52, 0.12);
  }

  .support-page__editorial-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1672 / 941;
    object-fit: cover;
  }
{%- endstyle -%}

{%- liquid
  assign support_handles = 'faqs,shipping-policy,90-day-sleep-trial,privacy-policy,terms-of-service,contact-us,about-us' | split: ','
  assign page_key = page.handle | handleize
  assign page_title_key = page.title | handleize
  if support_handles contains page_title_key
    assign page_key = page_title_key
  elsif page_key == blank
    assign page_key = page_title_key
  endif
  assign is_support_page = false
  if support_handles contains page_key
    assign is_support_page = true
  endif

  assign content_image_asset = blank
  assign content_image_alt = blank
  case page_key
    when 'building-your-snoozepod', 'what-is-a-snoozepod', 'how-the-mysnoozepod-showroom-works', 'what-is-a-snooze-session', 'what-to-expect-during-your-snooze-session', 'how-to-prepare-for-your-showroom-visit', 'what-happens-after-your-snooze-session', 'comparing-sleep-systems-without-sales-pressure', 'from-showroom-recommendation-to-home-delivery'
      assign content_image_asset = 'content-guide-showroom.png'
      assign content_image_alt = 'Guests comparing mattresses during a calm guided showroom visit'
    when 'how-a-virtual-snooze-session-works'
      assign content_image_asset = 'content-guide-virtual-session.png'
      assign content_image_alt = 'A virtual sleep consultation taking place in a comfortable bedroom'
    when 'what-makes-a-complete-sleep-system', 'how-your-sleep-system-components-work-together', 'how-to-choose-the-right-mattress', 'how-to-choose-the-right-mattress-size', 'showroom-comfort-vs-ordered-configuration', 'questions-to-ask-before-buying-a-mattress', 'when-is-it-time-to-replace-your-mattress'
      assign content_image_asset = 'content-guide-sleep-system.png'
      assign content_image_alt = 'A coordinated mattress, pillows, sheets, comforter, and bedroom foundation'
    when 'understanding-mattress-comfort-soft-to-firm', 'mattress-support-vs-mattress-firmness', 'understanding-pressure-relief-and-body-alignment', 'choosing-a-mattress-for-side-back-or-combination-sleep'
      assign content_image_asset = 'content-guide-comfort-comparison.png'
      assign content_image_alt = 'Shoppers comparing different mattress comfort choices in a relaxed showroom'
    when 'benefits-of-dual-comfort-mattresses', 'how-independent-left-and-right-comfort-works', 'choosing-between-soft-medium-soft-medium-firm-and-firm', 'choosing-different-comfort-levels-as-a-couple', 'what-happens-when-partners-have-different-sleep-preferences', 'choosing-comfort-for-each-side-of-the-bed', 'who-is-a-dual-comfort-mattress-for', 'choosing-a-mattress-for-couples-with-different-sleep-styles'
      assign content_image_asset = 'content-guide-dual-comfort.png'
      assign content_image_alt = 'A couple independently testing comfort on each side of one mattress'
    when 'standard-split-head-half-split-and-full-split-explained', 'is-a-split-head-mattress-right-for-you', 'understanding-split-head-adjustable-sleep-systems'
      assign content_image_asset = 'content-guide-split-system.png'
      assign content_image_alt = 'A split-head sleep system demonstrating independent upper-body positioning'
    when 'memory-foam-vs-hybrid-mattresses', 'understanding-modular-mattresses', 'choosing-a-foam-mattress', 'choosing-a-hybrid-mattress', 'comparing-mattress-types', 'how-mattress-materials-affect-comfort'
      assign content_image_asset = 'content-guide-mattress-materials.png'
      assign content_image_alt = 'Unbranded foam, pocketed coil, textile, and fiber mattress material samples'
    when 'cooling-mattresses-what-actually-matters', 'creating-a-cooler-more-comfortable-sleep-environment', 'choosing-the-right-comforter-weight'
      assign content_image_asset = 'content-guide-cooling.png'
      assign content_image_alt = 'An airy bedroom arranged with lightweight bedding for a cooler sleep environment'
    when 'benefits-of-an-adjustable-base', 'adjustable-base-features-explained', 'how-to-choose-an-adjustable-base', 'understanding-zero-gravity-and-preset-positions', 'how-to-match-a-mattress-with-an-adjustable-base', 'adjustable-bases-vs-platform-bases'
      assign content_image_asset = 'content-guide-adjustable-base.png'
      assign content_image_alt = 'An adjustable bed positioned with the head and knees comfortably elevated'
    when 'how-to-find-the-right-pillow', 'how-mattress-protectors-help-protect-your-bed', 'choosing-sheets-for-standard-and-split-head-mattresses'
      assign content_image_asset = 'content-guide-bedding-essentials.png'
      assign content_image_alt = 'Coordinated pillows, sheets, mattress protection, and comforter layers'
  endcase

  assign page_eyebrow = blank
  assign support_intro = blank
  if is_support_page
    case page_key
      when 'faqs'
        assign support_intro = 'Find quick answers about the showroom, Snooze Sessions, support, shipping basics, and sleep trial guidance.'
      when 'shipping-policy'
        assign support_intro = 'Review order processing, delivery timing, large-item guidance, tracking communication, and how to reach support if something needs attention.'
      when '90-day-sleep-trial'
        assign support_intro = 'Understand how the sleep trial works, who it applies to, and how to request help if the fit is not right.'
      when 'privacy-policy'
        assign support_intro = 'Review how MySnoozePod handles personal information, site activity, and related privacy practices.'
      when 'terms-of-service'
        assign support_intro = 'Review the terms that govern use of MySnoozePod, purchases, and related services.'
      when 'contact-us'
        assign support_intro = 'Reach out for booking help, product questions, order updates, shipping support, or showroom guidance.'
      when 'about-us'
        assign support_intro = 'Learn how MySnoozePod combines a private showroom, Snoozer guidance, and a calmer way to shop for sleep.'
    endcase

    case page_key
      when 'privacy-policy', 'terms-of-service'
        assign page_eyebrow = 'Policies'
      when 'about-us'
        assign page_eyebrow = 'MySnoozePod'
      else
        assign page_eyebrow = 'Support'
    endcase
  endif

  assign cleaned_content = page.content
  assign cleaned_content = cleaned_content | replace: 'Last updated: [Insert Date]', ''
  assign cleaned_content = cleaned_content | replace: 'Last Updated: [Insert Date]', ''
  assign cleaned_content = cleaned_content | replace: 'Effective Date: [Insert Date]', ''
  assign cleaned_content = cleaned_content | replace: '[Insert Date]', ''
  assign cleaned_content = cleaned_content | strip
  assign cleaned_text = cleaned_content | strip_html | strip
-%}

<section class="support-page section-{{ section.id }}-padding{% if is_support_page %} support-page--policy{% endif %}">
  <div class="support-page__shell page-width">
    <div class="support-page__hero{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- if page_eyebrow != blank -%}
        <p class="support-page__eyebrow">{{ page_eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="main-page-title page-title support-page__title h0">
        {{ page.title | escape }}
      </h1>
      {%- if support_intro != blank -%}
        <div class="support-page__intro rte">
          <p>{{ support_intro | strip }}</p>
        </div>
      {%- endif -%}
      {%- if content_image_asset != blank -%}
        <figure class="support-page__editorial-media">
          <img
            class="support-page__editorial-image"
            src="{{ content_image_asset | asset_url }}"
            alt="{{ content_image_alt | escape }}"
            width="1672"
            height="941"
            loading="eager"
            fetchpriority="high"
          >
        </figure>
      {%- endif -%}
    </div>

    {%- if is_support_page or cleaned_text != blank -%}
      <div class="support-page__card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- case page_key -%}
          {%- when 'faqs' -%}
            <div class="support-page-faq" aria-label="Frequently asked questions">
              <details class="support-page-faq__item" open>
                <summary>What is MySnoozePod?</summary>
                <div class="support-page-faq__answer">
                  MySnoozePod is a guided way to shop for sleep. It combines a private showroom, Snoozer guidance, and a focus on the full sleep environment instead of only mattress browsing.
                </div>
              </details>
              <details class="support-page-faq__item">
                <summary>How do private showroom visits work?</summary>
                <div class="support-page-faq__answer">
                  The showroom is designed to feel calm and self-directed. You can move through the space with a clearer plan, and guided support is available when you need it.
                </div>
              </details>
              <details class="support-page-faq__item">
                <summary>What is a Snooze Session?</summary>
                <div class="support-page-faq__answer">
                  A Snooze Session is a private appointment that helps you test mattresses, bases, pillows, and bedding with more direction and less pressure.
                </div>
              </details>
              <details class="support-page-faq__item">
                <summary>Do I need an appointment?</summary>
                <div class="support-page-faq__answer">
                  A booking is recommended so your visit can stay private, guided, and focused on what matters most to your sleep needs.
                </div>
              </details>
              <details class="support-page-faq__item">
                <summary>Can I get virtual support?</summary>
                <div class="support-page-faq__answer">
                  Yes. Virtual support can help with booking questions, product direction, and next steps before or after a showroom visit.
                </div>
              </details>
              <details class="support-page-faq__item">
                <summary>What products can I try?</summary>
                <div class="support-page-faq__answer">
                  Depending on current availability, you may be able to explore mattresses, adjustable bases, pillows, bedding, and other products that help complete your SnoozePod.
                </div>
              </details>
              <details class="support-page-faq__item">
                <summary>How does the Snooze Assessment help?</summary>
                <div class="support-page-faq__answer">
                  The Snooze Assessment asks a few guided questions about comfort, support, sleep habits, and partner needs so Snoozer can narrow a stronger starting direction.
                </div>
              </details>
              <details class="support-page-faq__item">
                <summary>Where can I learn about shipping and delivery?</summary>
                <div class="support-page-faq__answer">
                  Our Shipping Policy covers order processing, delivery timing, tracking communication, and what to do if your order arrives with an issue.
                </div>
              </details>
              <details class="support-page-faq__item">
                <summary>Where can I learn about the sleep trial or support options?</summary>
                <div class="support-page-faq__answer">
                  The 90 Day Sleep Trial page explains trial basics, and the Contact Us page is the best place to reach out with booking, order, or support questions.
                </div>
              </details>
            </div>

          {%- when 'about-us' -%}
            <div class="support-page-richtext rte">
              <h2>A calmer way to shop for sleep.</h2>
              <p>
                MySnoozePod was built to make mattress shopping feel less pressured and more focused. Instead of pushing shoppers through a traditional showroom experience, we pair a private space with guided support so each visit can start with more clarity.
              </p>

              <h3>Built around the full sleep environment</h3>
              <p>
                We do not think in mattress-only terms. We think in sleep environment terms: mattresses, bases, pillows, bedding, and the details that shape how you rest, recover, and wake up.
              </p>

              <h3>How Snoozer fits in</h3>
              <p>
                Snoozer helps narrow a starting direction before and during the showroom journey. The goal is not to overwhelm you with choices. The goal is to help you understand what to test next and why it may fit.
              </p>

              <h3>Why the showroom feels different</h3>
              <ul>
                <li>Private visits that reduce pressure</li>
                <li>Guided direction without hovering sales tactics</li>
                <li>A clearer path from questions to real testing</li>
                <li>A focus on sleep health and comfort, not just product specs</li>
              </ul>
            </div>

          {%- else -%}
            {%- if cleaned_text != blank -%}
              <div class="support-page-richtext rte">
                {{ cleaned_content }}
              </div>
            {%- endif -%}
        {%- endcase -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
