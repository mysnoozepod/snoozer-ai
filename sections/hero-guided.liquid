{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .hero-guided__grid {
    display: grid;
    gap: 2.4rem;
    align-items: center;
  }

  .hero-guided__content {
    max-width: 58rem;
  }

  .hero-guided__heading {
    margin: 0 0 1.6rem;
    max-width: 10ch;
  }

  .hero-guided__subtext {
    margin: 0;
    color: rgb(var(--color-text-secondary));
  }

  .hero-guided__actions {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    margin-top: 2.4rem;
  }

  .hero-guided__actions .button {
    width: 100%;
  }

  .hero-guided__media {
    overflow: hidden;
    border-radius: 1.6rem;
    border: 0.1rem solid rgba(var(--color-text-primary), 0.08);
    background: rgb(var(--color-background));
    aspect-ratio: 4 / 3;
    min-height: 24rem;
  }

  .hero-guided__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .hero-guided__actions {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1.6rem;
    }

    .hero-guided__actions .button {
      width: auto;
      min-width: 22rem;
    }
  }

  @media screen and (min-width: 990px) {
    .hero-guided__grid {
      grid-template-columns: minmax(0, 1fr) minmax(36rem, 50rem);
      gap: 4.8rem;
    }

    .hero-guided__media {
      aspect-ratio: 6 / 5;
      min-height: 46rem;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="hero-guided__grid">
      <div class="hero-guided__content">
        {%- if section.settings.heading != blank -%}
          <h1 class="hero-guided__heading h1">
            {{ section.settings.heading | escape }}
          </h1>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <div class="hero-guided__subtext rte">
            <p>{{ section.settings.subtext | escape | newline_to_br }}</p>
          </div>
        {%- endif -%}
        {%- if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank -%}
          <div class="hero-guided__actions">
            {%- if section.settings.primary_button_label != blank -%}
              <a
                {% if section.settings.primary_button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.primary_button_link }}"
                {% endif %}
                class="button button--primary"
              >
                {{ section.settings.primary_button_label | escape }}
              </a>
            {%- endif -%}
            {%- if section.settings.secondary_button_label != blank -%}
              <a
                {% if section.settings.secondary_button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.secondary_button_link }}"
                {% endif %}
                class="button button--secondary"
              >
                {{ section.settings.secondary_button_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- if section.settings.image != blank -%}
        <div class="hero-guided__media">
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              widths: '480, 720, 960, 1200, 1600, 2000, 2400',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'hero-guided__image',
              loading: 'eager',
              alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero guided",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Better Sleep Starts With Personalized Guidance"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Take our quick sleep assessment and get recommendations built around your unique needs."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Start Your Sleep Assessment"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Shop Mattresses"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Hero guided"
    }
  ]
}
{% endschema %}
