{%- liquid
  assign hero_image = section.settings.hero_image
  assign hero_alt = section.settings.hero_image_alt | strip
  if hero_alt == blank
    assign hero_alt = section.settings.hero_headline
  endif
  assign assessment_page_url = '/pages/snooze-assessment'
  assign booking_page_url = '/pages/book-a-snooze-session'
  assign mattresses_collection_url = '/collections/mattresses'
  assign adjustable_base_url = '/products/premium-motion-adjustable-base'
  assign bases_collection_url = '/collections/bases'
  assign pillows_collection_url = '/collections/pillows'
  assign bedding_collection_url = '/collections/bedding'
  assign assessment_product_handles = '14-hybrid|12-dual-comfort-hybrid|12-all-foam-mattress|10-all-foam-mattress|premium-motion-adjustable-base|platform-base|storage-base' | split: '|'
  assign hide_footer_newsletter = false
  if request.page_type == 'page' and page.handle == 'snooze-assessment'
    assign hide_footer_newsletter = true
  endif
-%}

{{ 'snooze-assessment.css' | asset_url | stylesheet_tag }}
<script src="{{ 'snooze-assessment.js' | asset_url }}" defer></script>
{%- if hide_footer_newsletter -%}
  {%- style -%}
    body.template-page #shopify-section-newsletter {
      display: none !important;
    }
  {%- endstyle -%}
{%- endif -%}

<section class="section">
  <div
    class="snooze-assessment"
    data-assessment-root
    data-assessment-section-id="{{ section.id }}"
    data-assessment-url="{{ assessment_page_url }}"
    data-booking-url="{{ booking_page_url }}"
    data-mattresses-url="{{ mattresses_collection_url }}"
    data-adjustable-base-url="{{ adjustable_base_url }}"
    data-bases-collection-url="{{ bases_collection_url }}"
    data-pillows-url="{{ pillows_collection_url }}"
    data-bedding-url="{{ bedding_collection_url }}"
  >
    <script type="application/json" data-assessment-product-map>
      {%- assign emitted_products = 0 -%}
      {
        {%- for handle in assessment_product_handles -%}
          {%- assign assessment_product = all_products[handle] -%}
          {%- if assessment_product != blank -%}
            {%- if emitted_products > 0 -%},{%- endif -%}
            "{{ handle }}": {
              "handle": {{ handle | json }},
              "title": {{ assessment_product.title | json }},
              "url": {{ assessment_product.url | json }},
              "image": {{ assessment_product.featured_image | image_url: width: 960 | json }}
            }
            {%- assign emitted_products = emitted_products | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      }
    </script>

    <div class="snooze-assessment__stack">
      <div class="snooze-assessment__panel snooze-assessment__panel--soft">
        <div class="snooze-assessment__hero{% if hero_image == blank %} snooze-assessment__hero--single{% endif %}">
          <div>
            <p class="snooze-assessment__eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
            <h1 class="snooze-assessment__title">{{ section.settings.hero_headline | escape }}</h1>
            <p class="snooze-assessment__text">{{ section.settings.hero_text | escape }}</p>
          </div>

          {%- if hero_image != blank -%}
            <div class="snooze-assessment__visual">
              {{
                hero_image
                | image_url: width: 1600
                | image_tag:
                  widths: '480, 720, 960, 1400, 1600',
                  sizes: '(min-width: 990px) 42vw, 100vw',
                  loading: 'lazy',
                  alt: hero_alt | escape
              }}
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="snooze-assessment__panel" data-assessment-app-anchor>
        <div class="snooze-assessment__section">
          <div class="snooze-assessment__app">
            <div class="snooze-assessment__question-shell">
              <div class="snooze-assessment__progress-row">
                <div class="snooze-assessment__progress-track">
                  <span class="snooze-assessment__progress-bar" data-assessment-progress-bar></span>
                </div>
                <span class="snooze-assessment__progress-label" data-assessment-progress-label>Loading</span>
              </div>

                <div class="snooze-assessment__question-block">
                  <div class="snooze-assessment__question-meta">
                    <p class="snooze-assessment__micro" data-assessment-question-eyebrow>Start here</p>
                    <h3 class="snooze-assessment__question-title" data-assessment-question-title>
                      Loading your Snooze Assessment...
                    </h3>
                    <p class="snooze-assessment__question-note" data-assessment-question-note>
                      Loading the current assessment questions now.
                    </p>
                  </div>

                <div class="snooze-assessment__option-grid" data-assessment-options></div>

                <div class="snooze-assessment__nav">
                  <button type="button" class="snooze-assessment__nav-button snooze-assessment__nav-button--ghost" data-assessment-back>
                    Previous
                  </button>
                  <button type="button" class="snooze-assessment__nav-button snooze-assessment__nav-button--ghost" data-assessment-skip>
                    Skip for now
                  </button>
                  <button type="button" class="snooze-assessment__nav-button snooze-assessment__nav-button--primary" data-assessment-continue>
                    Next question
                  </button>
                </div>

                <div class="snooze-assessment__status" data-assessment-status hidden></div>
                <div class="snooze-assessment__error" data-assessment-error hidden></div>
              </div>
            </div>
          </div>

          <div class="snooze-assessment__result" data-assessment-result hidden>
            <div class="snooze-assessment__result-panel">
              <h2 class="snooze-assessment__result-title" data-assessment-result-title>Your sleep direction is ready.</h2>
              <p class="snooze-assessment__result-copy" data-assessment-result-copy></p>
              <p class="snooze-assessment__section-subtext" data-assessment-result-summary></p>
              <div class="snooze-assessment__result-tags" data-assessment-result-tags></div>
              <div class="snooze-assessment__code-card" data-assessment-snooze-card hidden>
                <div class="snooze-assessment__code-card-copy">
                  <p class="snooze-assessment__code-eyebrow">Your Snooze Code</p>
                  <p class="snooze-assessment__code-value" data-assessment-snooze-code-value></p>
                  <p class="snooze-assessment__code-note">
                    Use this code to unlock your recommendations, rewards, and Snooze Session prep.
                  </p>
                </div>
                <button
                  type="button"
                  class="snooze-assessment__button snooze-assessment__button--ghost snooze-assessment__code-copy-button"
                  data-assessment-snooze-code-copy
                >
                  Copy
                </button>
              </div>
              <div class="snooze-assessment__direction-grid" data-assessment-result-directions></div>
              <div class="snooze-assessment__result-actions" data-assessment-result-actions></div>
            </div>

            <div>
              <h3 class="snooze-assessment__side-title">{{ section.settings.preview_heading | escape }}</h3>
              {%- if section.settings.preview_text != blank -%}
                <p class="snooze-assessment__section-subtext">{{ section.settings.preview_text | escape }}</p>
              {%- endif -%}
              <div class="snooze-assessment__recommendations" data-assessment-result-products></div>
            </div>

            <div class="snooze-assessment__actions">
              <button type="button" class="snooze-assessment__button snooze-assessment__button--ghost" data-assessment-retake>
                Change answers
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing assessment",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "hero_eyebrow", "label": "Hero eyebrow", "default": "SNOOZE ASSESSMENT" },
    { "type": "text", "id": "hero_headline", "label": "Hero headline", "default": "Find your starting point." },
    { "type": "textarea", "id": "hero_text", "label": "Hero text", "default": "Answer the same guided questions used in the showroom flow so Snoozer can narrow your mattress, base, and sleep setup direction." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_image_alt", "label": "Hero image alt text" },
    { "type": "text", "id": "preview_heading", "label": "Results heading", "default": "Recommended next steps" },
    { "type": "textarea", "id": "preview_text", "label": "Results text", "default": "Start with the real mattress, base, and setup direction most aligned to your answers." }
  ],
  "presets": [
    {
      "name": "Landing assessment"
    }
  ]
}
{% endschema %}
