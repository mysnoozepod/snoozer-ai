{%- style -%}
  .snooze-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: var(--hero-height-mobile);
    overflow: hidden;
    isolation: isolate;
    background: #d7dbe2;
  }

  .snooze-hero-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(7, 26, 68, 0.68) 0%, rgba(7, 26, 68, 0.28) 48%, rgba(7, 26, 68, 0.12) 100%);
    z-index: 1;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__media-wrap,
  .snooze-hero-{{ section.id }} .snooze-hero__media {
    position: absolute;
    inset: 0;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__media {
    z-index: 0;
    background: linear-gradient(135deg, rgba(13, 27, 73, 0.2), rgba(17, 24, 39, 0.12));
  }

  .snooze-hero-{{ section.id }} .snooze-hero__media--empty {
    display: block;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    width: min(100%, var(--wide-content-max));
    min-height: var(--hero-height-mobile);
    margin: 0 auto;
    padding: var(--sp-7) var(--page-padding-mobile) var(--sp-5);
  }

  .snooze-hero-{{ section.id }} .snooze-hero__content {
    width: min(100%, 52rem);
    max-width: 52rem;
    min-width: 0;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__heading {
    margin: 0;
    max-width: 10ch;
    color: #ffffff;
    font-size: var(--h1-mobile);
    line-height: 0.98;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__subtext {
    margin: var(--sp-4) 0 0;
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--body-mobile);
    line-height: 1.45;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__subtext p {
    margin: 0;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }

  .snooze-hero-{{ section.id }} .snooze-hero__actions .button {
    width: min(100%, 28rem);
    min-width: 0;
    min-height: var(--button-height-mobile);
    padding: 0 var(--sp-5);
    border-radius: var(--button-radius);
    justify-content: center;
    font-size: var(--body-mobile);
    font-weight: 600;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__actions .button--secondary {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.7);
    color: #ffffff;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__actions .button--secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.92);
    color: #ffffff;
  }

  @media screen and (min-width: 750px) {
    .snooze-hero-{{ section.id }} {
      min-height: clamp(var(--hero-height-mobile), 52vw, var(--hero-height-desktop));
    }

    .snooze-hero-{{ section.id }} .snooze-hero__inner {
      min-height: clamp(var(--hero-height-mobile), 52vw, var(--hero-height-desktop));
      padding-top: var(--sp-8);
      padding-bottom: var(--sp-7);
      padding-left: var(--page-padding-tablet);
      padding-right: var(--page-padding-tablet);
    }

    .snooze-hero-{{ section.id }} .snooze-hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--sp-4);
    }

    .snooze-hero-{{ section.id }} .snooze-hero__actions .button {
      width: auto;
    }
  }

  @media screen and (min-width: 990px) {
    .snooze-hero-{{ section.id }} {
      min-height: var(--hero-height-desktop);
    }

    .snooze-hero-{{ section.id }} .snooze-hero__inner {
      min-height: var(--hero-height-desktop);
      align-items: center;
      padding-top: var(--sp-8);
      padding-bottom: var(--sp-8);
      padding-left: var(--page-padding-desktop);
      padding-right: var(--page-padding-desktop);
    }

    .snooze-hero-{{ section.id }} .snooze-hero__content {
      width: min(100%, 56rem);
      max-width: 56rem;
    }

    .snooze-hero-{{ section.id }} .snooze-hero__heading {
      font-size: var(--h1-desktop);
      line-height: 0.96;
    }

    .snooze-hero-{{ section.id }} .snooze-hero__subtext {
      max-width: 46rem;
      font-size: var(--body-desktop);
    }

    .snooze-hero-{{ section.id }} .snooze-hero__actions .button {
      min-height: var(--button-height-desktop);
      font-size: var(--body-desktop);
    }
  }
{%- endstyle -%}

<section class="snooze-hero snooze-hero-{{ section.id }}">
  <div class="snooze-hero__media-wrap">
    {%- if section.settings.hero_image != blank -%}
      <div class="snooze-hero__media">
        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag:
            widths: '480, 720, 960, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            class: 'snooze-hero__image',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.hero_image.alt | default: 'Single person testing a mattress in a calm guided sleep environment' | escape
        }}
      </div>
    {%- else -%}
      <div
        class="snooze-hero__media snooze-hero__media--empty"
        role="img"
        aria-label="Single person testing a mattress in a calm guided sleep environment"
      ></div>
    {%- endif -%}
  </div>

  <div class="snooze-hero__inner">
    <div class="snooze-hero__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="snooze-hero__heading h1">
          {{ section.settings.heading | escape }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <div class="snooze-hero__subtext rte">
          <p>{{ section.settings.subtext | escape | newline_to_br }}</p>
        </div>
      {%- endif -%}

      {%- if section.settings.primary_cta_label != blank or section.settings.secondary_cta_label != blank -%}
        <div class="snooze-hero__actions">
          {%- if section.settings.primary_cta_label != blank -%}
            <a
              {% if section.settings.primary_cta_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.primary_cta_link }}"
              {% endif %}
              class="button button--primary"
            >
              {{ section.settings.primary_cta_label | escape }}
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_cta_label != blank -%}
            <a
              {% if section.settings.secondary_cta_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.secondary_cta_link }}"
              {% endif %}
              class="button button--secondary"
            >
              {{ section.settings.secondary_cta_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Snooze hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Short supporting text."
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary CTA label",
      "default": "Primary action"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary CTA label",
      "default": "Secondary action"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Snooze hero"
    }
  ]
}
{% endschema %}
