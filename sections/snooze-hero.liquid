{%- style -%}
  .snooze-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 46rem;
    overflow: hidden;
    isolation: isolate;
    background: #d7dbe2;
  }

  .snooze-hero-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.42);
    z-index: 1;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__media-wrap,
  .snooze-hero-{{ section.id }} .snooze-hero__media {
    position: absolute;
    inset: 0;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__media {
    z-index: 0;
    background: linear-gradient(135deg, rgba(13, 27, 73, 0.2), rgba(17, 24, 39, 0.12));
  }

  .snooze-hero-{{ section.id }} .snooze-hero__media--empty {
    display: block;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    min-height: 46rem;
    padding: 6.4rem 2rem 5.6rem;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__content {
    width: min(100%, 60rem);
    max-width: 60rem;
    min-width: 0;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__heading {
    margin: 0;
    max-width: 13ch;
    color: #ffffff;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__subtext {
    margin: 1.6rem 0 0;
    max-width: 56rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .snooze-hero-{{ section.id }} .snooze-hero__subtext p {
    margin: 0;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 2.4rem;
  }

  .snooze-hero-{{ section.id }} .snooze-hero__actions .button {
    width: auto;
    min-width: 0;
  }

  .snooze-hero-{{ section.id }} + .snooze-hero__assistant-shell {
    position: relative;
    z-index: 3;
    margin-top: -2.4rem;
    margin-bottom: 1.6rem;
  }

  .snooze-hero-{{ section.id }} + .snooze-hero__assistant-shell .snooze-hero__assistant-card {
    display: grid;
    gap: 1.4rem;
    align-items: center;
    padding: 1.8rem 2rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.08);
    border-radius: 1.8rem;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 1.2rem 3rem rgba(7, 26, 68, 0.08);
  }

  .snooze-hero-{{ section.id }} + .snooze-hero__assistant-shell .snooze-hero__assistant-identity {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    min-width: 0;
  }

  .snooze-hero-{{ section.id }} + .snooze-hero__assistant-shell .snooze-hero__assistant-image {
    width: 5.6rem;
    height: 5.6rem;
    border-radius: 1.4rem;
    object-fit: cover;
    flex-shrink: 0;
    background: rgba(var(--color-foreground), 0.04);
  }

  .snooze-hero-{{ section.id }} + .snooze-hero__assistant-shell .snooze-hero__assistant-copy {
    min-width: 0;
  }

  .snooze-hero-{{ section.id }} + .snooze-hero__assistant-shell .snooze-hero__assistant-title {
    margin: 0;
    font-size: 1.8rem;
    line-height: 1.2;
    color: rgb(var(--color-primary-navy));
  }

  .snooze-hero-{{ section.id }} + .snooze-hero__assistant-shell .snooze-hero__assistant-text {
    margin: 0.4rem 0 0;
    font-size: 1.5rem;
    line-height: 1.5;
    color: rgba(var(--color-text-primary), 0.76);
  }

  .snooze-hero-{{ section.id }} + .snooze-hero__assistant-shell .snooze-hero__assistant-action {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.6rem;
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.2;
    color: rgb(var(--color-primary-navy));
    cursor: pointer;
  }

  .snooze-hero-{{ section.id }} + .snooze-hero__assistant-shell .snooze-hero__assistant-action:hover {
    color: rgb(var(--color-accent-blue));
  }

  .snooze-hero-{{ section.id }} + .snooze-hero__assistant-shell .snooze-hero__assistant-action:focus-visible {
    outline: 0.2rem solid rgba(30, 92, 196, 0.24);
    outline-offset: 0.3rem;
    border-radius: 0.6rem;
  }

  @media screen and (min-width: 750px) {
    .snooze-hero-{{ section.id }} {
      min-height: 54rem;
    }

    .snooze-hero-{{ section.id }} .snooze-hero__inner {
      min-height: 54rem;
      padding-top: 7.2rem;
      padding-bottom: 6.4rem;
      padding-left: clamp(3.2rem, 5vw, 8rem);
      padding-right: clamp(3.2rem, 5vw, 8rem);
    }

    .snooze-hero-{{ section.id }} .snooze-hero__actions {
      gap: 1.6rem;
    }

    .snooze-hero-{{ section.id }} + .snooze-hero__assistant-shell {
      margin-top: -3.2rem;
      margin-bottom: 2.4rem;
    }

    .snooze-hero-{{ section.id }} + .snooze-hero__assistant-shell .snooze-hero__assistant-card {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 1.6rem;
      padding: 2rem 2.4rem;
    }

    .snooze-hero-{{ section.id }} + .snooze-hero__assistant-shell .snooze-hero__assistant-image {
      width: 6.4rem;
      height: 6.4rem;
    }
  }

  @media screen and (min-width: 990px) {
    .snooze-hero-{{ section.id }} {
      min-height: 62rem;
    }

    .snooze-hero-{{ section.id }} .snooze-hero__inner {
      min-height: 62rem;
      padding-top: 8rem;
      padding-bottom: 7.2rem;
      padding-left: clamp(5vw, 6vw, 8rem);
      padding-right: clamp(4rem, 5vw, 7.2rem);
    }

    .snooze-hero-{{ section.id }} + .snooze-hero__assistant-shell {
      margin-top: -3.6rem;
      margin-bottom: 3.2rem;
    }
  }
{%- endstyle -%}

<section class="snooze-hero snooze-hero-{{ section.id }}">
  <div class="snooze-hero__media-wrap">
    {%- if section.settings.hero_image != blank -%}
      <div class="snooze-hero__media">
        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag:
            widths: '480, 720, 960, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            class: 'snooze-hero__image',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.hero_image.alt | default: 'Single person testing a mattress in a calm guided sleep environment' | escape
        }}
      </div>
    {%- else -%}
      <div
        class="snooze-hero__media snooze-hero__media--empty"
        role="img"
        aria-label="Single person testing a mattress in a calm guided sleep environment"
      ></div>
    {%- endif -%}
  </div>

  <div class="snooze-hero__inner">
    <div class="snooze-hero__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="snooze-hero__heading h1">
          {{ section.settings.heading | escape }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <div class="snooze-hero__subtext rte">
          <p>{{ section.settings.subtext | escape | newline_to_br }}</p>
        </div>
      {%- endif -%}

      {%- if section.settings.primary_cta_label != blank or section.settings.secondary_cta_label != blank -%}
        <div class="snooze-hero__actions">
          {%- if section.settings.primary_cta_label != blank -%}
            <a
              {% if section.settings.primary_cta_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.primary_cta_link }}"
              {% endif %}
              class="button button--primary"
            >
              {{ section.settings.primary_cta_label | escape }}
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_cta_label != blank -%}
            <a
              {% if section.settings.secondary_cta_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.secondary_cta_link }}"
              {% endif %}
              class="button button--secondary"
            >
              {{ section.settings.secondary_cta_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<div class="page-width snooze-hero__assistant-shell">
  <div class="snooze-hero__assistant-card">
    <div class="snooze-hero__assistant-identity">
      <img
        src="{{ 'snoozer-coach.png' | asset_url }}"
        alt="Snoozer coach portrait"
        class="snooze-hero__assistant-image"
        loading="lazy"
        width="64"
        height="64"
      >
      <div class="snooze-hero__assistant-copy">
        <h2 class="snooze-hero__assistant-title">Meet Snoozer</h2>
        <p class="snooze-hero__assistant-text">Not sure where to start? Snoozer can help guide you.</p>
      </div>
    </div>

    <button
      type="button"
      class="snooze-hero__assistant-action"
      data-snoozer-trigger
      data-snoozer-source="hero-strip"
      aria-label="Ask Snoozer"
    >
      <span>Ask Snoozer</span>
      <span aria-hidden="true">&rarr;</span>
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Snooze hero",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Short supporting text."
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary CTA label",
      "default": "Primary action"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary CTA label",
      "default": "Secondary action"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Snooze hero"
    }
  ]
}
{% endschema %}
