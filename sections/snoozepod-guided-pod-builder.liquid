{{ 'snoozepod-pod-builder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'snoozepod-pod-builder.js' | asset_url }}" defer></script>

{%- liquid
  assign size_option_index = 1
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'size'
      assign size_option_index = forloop.index
      break
    endif
  endfor
-%}

<section class="section">
  <div
    class="snoozepod-builder page-width"
    data-snoozepod-builder
    data-section-id="{{ section.id }}"
    data-product-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    data-book-url="{{ section.settings.booking_link | default: '/pages/book-a-snooze-session' }}"
    data-book-label="{{ section.settings.booking_label | default: 'Book a Snooze Session' | escape }}"
    data-add-label="{{ section.settings.primary_label | default: 'Add mattress to cart' | escape }}"
    data-size-option-index="{{ size_option_index }}"
  >
    <script type="application/json" data-builder-product>
      {
        "selectedVariantId": {{ product.selected_or_first_available_variant.id | json }},
        "variants": {{ product.variants | json }},
        "options": {{ product.options_with_values | json }}
      }
    </script>

    <div class="snoozepod-builder__shell">
      <div class="snoozepod-builder__header">
        <div>
          <p class="snoozepod-builder__eyebrow">Build My Pod</p>
          <h2 class="snoozepod-builder__heading">{{ section.settings.heading | escape }}</h2>
          <p class="snoozepod-builder__intro">
            Move through the same guided build flow used in the showroom, one decision at a time.
          </p>
        </div>
        <div class="snoozepod-builder__step-chip" data-builder-step-count></div>
      </div>

      <div class="snoozepod-builder__progress" aria-hidden="true">
        <span data-builder-progress></span>
      </div>

      <div class="snoozepod-builder__layout">
        <div class="snoozepod-builder__question-card">
          <div class="snoozepod-builder__step-pills" data-builder-steps></div>

          <div class="snoozepod-builder__question-head">
            <p class="snoozepod-builder__step-label" data-builder-step-label></p>
            <h3 class="snoozepod-builder__step-title" data-builder-step-title></h3>
            <p class="snoozepod-builder__step-copy" data-builder-step-copy></p>
          </div>

          <div class="snoozepod-builder__options" data-builder-options></div>

          <div class="snoozepod-builder__review" data-builder-review hidden>
            <div class="snoozepod-builder__review-card">
              <h4 class="snoozepod-builder__review-title">Review your SnoozePod</h4>
              <dl class="snoozepod-builder__review-list" data-builder-review-list></dl>
            </div>
            <p class="snoozepod-builder__review-note">
              Only the mattress is added to cart right now. The rest stays attached as SnoozePod direction.
            </p>
          </div>

          <form method="post" action="{{ routes.cart_add_url }}" class="snoozepod-builder__cart-form" data-builder-form hidden>
            <input type="hidden" name="id" value="">
            <input type="hidden" name="quantity" value="1">
            <input type="hidden" name="properties[SnoozePod Size]" value="">
            <input type="hidden" name="properties[SnoozePod Base Direction]" value="">
            <input type="hidden" name="properties[SnoozePod Motion Direction]" value="">
            <input type="hidden" name="properties[SnoozePod Protection Direction]" value="">
            <input type="hidden" name="properties[SnoozePod Pillow Direction]" value="">
            <input type="hidden" name="properties[SnoozePod Bedding Direction]" value="">
            <button type="submit" class="button button--primary snoozepod-builder__submit" data-builder-submit>
              {{ section.settings.primary_label | escape }}
            </button>
          </form>

          <div class="snoozepod-builder__nav">
            <button type="button" class="button button--secondary snoozepod-builder__back" data-builder-back>
              Back
            </button>
            <button type="button" class="button button--primary snoozepod-builder__next" data-builder-next>
              Next
            </button>
          </div>

          <div class="snoozepod-builder__final-actions" data-builder-final-actions hidden>
            <a class="button button--secondary snoozepod-builder__book" href="{{ section.settings.booking_link | default: '/pages/book-a-snooze-session' }}" data-builder-book>
              {{ section.settings.booking_label | escape }}
            </a>
            <button type="button" class="snoozepod-builder__reset" data-builder-reset>
              Change Answers
            </button>
          </div>
        </div>

        <aside class="snoozepod-builder__summary-card">
          <p class="snoozepod-builder__summary-eyebrow">Live summary</p>
          <h3 class="snoozepod-builder__summary-title">Your SnoozePod</h3>
          <p class="snoozepod-builder__summary-copy">
            Keep the core decisions visible while you build.
          </p>

          <div class="snoozepod-builder__summary-price">
            <span class="snoozepod-builder__summary-price-label">Mattress price</span>
            <strong data-builder-price>{{ product.selected_or_first_available_variant.price | money }}</strong>
          </div>

          <dl class="snoozepod-builder__summary-list" data-builder-summary></dl>
        </aside>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pod builder flow",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your SnoozePod."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Add mattress to cart"
    },
    {
      "type": "text",
      "id": "booking_label",
      "label": "Booking label",
      "default": "Book a Snooze Session"
    },
    {
      "type": "url",
      "id": "booking_link",
      "label": "Booking link"
    }
  ],
  "presets": [
    {
      "name": "Pod builder flow"
    }
  ]
}
{% endschema %}
