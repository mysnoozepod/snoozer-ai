{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .snoozepod-environment-{{ section.id }} {
    width: min(100%, var(--content-max));
    margin: 0 auto;
    padding-left: var(--page-padding-mobile);
    padding-right: var(--page-padding-mobile);
  }

  .snoozepod-environment-{{ section.id }} .snoozepod-environment__header {
    display: grid;
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
  }

  .snoozepod-environment-{{ section.id }} .snoozepod-environment__heading {
    margin: 0;
    color: rgb(var(--color-primary-navy));
    font-size: var(--h2-mobile);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .snoozepod-environment-{{ section.id }} .snoozepod-environment__subheading {
    margin: 0;
    max-width: 72rem;
    color: rgba(var(--color-text-primary), 0.78);
    font-size: var(--body-mobile);
    line-height: 1.4;
  }

  .snoozepod-environment-{{ section.id }} .snoozepod-environment__subheading p {
    margin: 0;
  }

  .snoozepod-environment-{{ section.id }} .snoozepod-environment__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .snoozepod-environment-{{ section.id }} .snoozepod-environment__card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    height: 100%;
    min-height: 100%;
    padding: var(--card-padding-mobile);
    border: var(--card-border);
    border-radius: var(--radius-lg);
    background: #ffffff;
    box-shadow: var(--card-shadow-soft);
    color: inherit;
    text-decoration: none;
  }

  .snoozepod-environment-{{ section.id }} .snoozepod-environment__media {
    height: calc(var(--category-image-height-mobile) + var(--sp-2));
    border-radius: var(--radius-md);
    background: linear-gradient(180deg, #faf7f2 0%, #ffffff 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .snoozepod-environment-{{ section.id }} .snoozepod-environment__media img,
  .snoozepod-environment-{{ section.id }} .snoozepod-environment__media svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .snoozepod-environment-{{ section.id }} .snoozepod-environment__placeholder {
    width: 100%;
    height: 100%;
  }

  .snoozepod-environment-{{ section.id }} .placeholder-svg {
    width: 100%;
    height: 100%;
    fill: rgba(8, 25, 55, 0.12);
    background: transparent;
  }

  .snoozepod-environment-{{ section.id }} .snoozepod-environment__title {
    margin: 0 0 var(--sp-1);
    color: rgb(var(--color-primary-navy));
    font-size: 16px;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .snoozepod-environment-{{ section.id }} .snoozepod-environment__description {
    margin: 0;
    color: rgba(var(--color-text-primary), 0.74);
    font-size: 13px;
    line-height: 1.35;
  }

  .snoozepod-environment-{{ section.id }} .snoozepod-environment__link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    margin-top: auto;
    padding-top: var(--sp-2);
    color: rgb(var(--color-primary-navy));
    font-size: var(--small-text);
    font-weight: 600;
    text-decoration: none;
  }

  .snoozepod-environment-{{ section.id }} .snoozepod-environment__footer {
    display: flex;
    justify-content: center;
    margin-top: var(--sp-5);
  }

  .snoozepod-environment-{{ section.id }} .snoozepod-environment__cta {
    width: min(100%, 32rem);
    min-height: var(--button-height-mobile);
    border-radius: var(--button-radius);
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .snoozepod-environment-{{ section.id }} {
      padding-left: var(--page-padding-tablet);
      padding-right: var(--page-padding-tablet);
    }

    .snoozepod-environment-{{ section.id }} .snoozepod-environment__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .snoozepod-environment-{{ section.id }} {
      padding-left: var(--page-padding-desktop);
      padding-right: var(--page-padding-desktop);
    }

    .snoozepod-environment-{{ section.id }} .snoozepod-environment__header {
      margin-bottom: var(--sp-6);
    }

    .snoozepod-environment-{{ section.id }} .snoozepod-environment__heading {
      font-size: var(--h2-desktop);
    }

    .snoozepod-environment-{{ section.id }} .snoozepod-environment__subheading {
      font-size: var(--body-desktop);
    }

    .snoozepod-environment-{{ section.id }} .snoozepod-environment__card {
      padding: var(--card-padding-desktop);
    }

    .snoozepod-environment-{{ section.id }} .snoozepod-environment__media {
      height: calc(var(--category-image-height-mobile) + var(--sp-6));
    }

    .snoozepod-environment-{{ section.id }} .snoozepod-environment__title {
      font-size: var(--h3-desktop);
    }

    .snoozepod-environment-{{ section.id }} .snoozepod-environment__description {
      font-size: var(--body-mobile);
    }

    .snoozepod-environment-{{ section.id }} .snoozepod-environment__cta {
      min-height: var(--button-height-desktop);
    }
  }
{%- endstyle -%}

<section class="section color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">
    <div class="snoozepod-environment-{{ section.id }}">
      <div class="snoozepod-environment__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="snoozepod-environment__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="snoozepod-environment__subheading rte">
            <p>{{ section.settings.subheading | escape }}</p>
          </div>
        {%- endif -%}
      </div>

      <ul class="snoozepod-environment__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign linked_collection = block.settings.collection
            assign card_url = block.settings.link
            assign card_image = block.settings.image_override
            assign card_title = block.settings.title_override

            if linked_collection != blank
              if card_url == blank
                assign card_url = linked_collection.url
              endif
              if card_image == blank and linked_collection.featured_image != blank
                assign card_image = linked_collection.featured_image
              endif
              if card_title == blank
                assign card_title = linked_collection.title
              endif
            endif

            if card_title == blank
              assign card_title = 'Collection'
            endif
          -%}
          <li {{ block.shopify_attributes }}>
            {%- if card_url != blank -%}
              <a class="snoozepod-environment__card" href="{{ card_url }}">
            {%- else -%}
              <div class="snoozepod-environment__card">
            {%- endif -%}
                <div class="snoozepod-environment__media">
                  {%- if card_image != blank -%}
                    {{
                      card_image
                      | image_url: width: 320
                      | image_tag:
                        widths: '144, 200, 240, 320, 400',
                        sizes: '(min-width: 750px) calc((100vw - 128px) / 3), calc((100vw - 52px) / 2)',
                        loading: 'lazy',
                        alt: card_title | escape
                    }}
                  {%- else -%}
                    <span class="snoozepod-environment__placeholder">
                      {{ 'collection-1' | placeholder_svg_tag }}
                    </span>
                  {%- endif -%}
                </div>
                <div class="snoozepod-environment__copy">
                  <h3 class="snoozepod-environment__title">{{ card_title | escape }}</h3>
                  {%- if block.settings.description != blank -%}
                    <p class="snoozepod-environment__description">{{ block.settings.description | escape }}</p>
                  {%- endif -%}
                </div>
                {%- if block.settings.cta_label != blank and card_url != blank -%}
                  <span class="snoozepod-environment__link">{{ block.settings.cta_label | escape }}</span>
                {%- endif -%}
            {%- if card_url != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.cta_label != blank -%}
        <div class="snoozepod-environment__footer">
          <a
            class="button button--secondary snoozepod-environment__cta"
            href="{% if section.settings.cta_link != blank %}{{ section.settings.cta_link }}{% else %}{{ routes.collections_url }}{% endif %}"
          >
            {{ section.settings.cta_label | escape }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SnoozePod collections",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More Than A Mattress"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A SnoozePod is your full sleep setup - mattress, base, pillows, sheets, protection, and the pieces that complete your room."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Explore Our Collections"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image_override",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Title override"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Short supporting description."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "Explore ->"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Fallback link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SnoozePod collections",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" }
      ]
    }
  ]
}
{% endschema %}
