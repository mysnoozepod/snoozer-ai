</style>

{%- style -%}
  .header {
    padding: 0;
  }

  .section-header {
    margin-bottom: 0;
  }
{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

<div class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}">
  {%- liquid
    assign social_links = false
    assign localization_forms = false

    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
      assign social_links = true
    endif

    if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
      assign localization_forms = true
    endif

    assign show_desktop_menu = false
    if section.settings.menu != blank and section.settings.menu_type_desktop != 'drawer'
      assign show_desktop_menu = true
    endif
  -%}

  {%- capture header_logo -%}
    {%- if request.page_type == 'index' -%}
      <h1 class="header__heading">
    {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
        {%- if settings.logo != blank -%}
          <div class="header__heading-logo-wrapper">
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
            {% capture sizes %}(min-width: 990px) {{ settings.logo_width }}px, 140px{% endcapture %}
            {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
            {{
              settings.logo
              | image_url: width: 600
              | image_tag:
                class: 'header__heading-logo motion-reduce',
                widths: widths,
                height: logo_height,
                width: settings.logo_width,
                alt: logo_alt,
                sizes: sizes,
                preload: true
            }}
          </div>
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    {%- if request.page_type == 'index' -%}
      </h1>
    {%- endif -%}
  {%- endcapture -%}

  {%- capture ask_snoozer_pill -%}
    <button
      type="button"
      class="header__snoozer-pill"
      data-snoozer-trigger
      data-snoozer-source="header"
      aria-label="Ask Snoozer anything about your sleep"
    >
      <img
        src="{{ 'snoozer-avatar.png' | asset_url }}"
        alt="Snoozer avatar"
        class="header__snoozer-avatar"
        loading="eager"
        width="36"
        height="36"
      >
      <span class="header__snoozer-text">Ask Snoozer</span>
      <span class="header__snoozer-arrow" aria-hidden="true">
        <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
      </span>
    </button>
  {%- endcapture -%}

  <header class="header page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}{% if social_links %} header--has-social{% endif %}{% if shop.customer_accounts_enabled %} header--has-account{% endif %}{% if localization_forms %} header--has-localizations{% endif %} header--mobile-{{ section.settings.mobile_logo_position }}">
    <div class="header__main">
      <div class="header__main-toggle">
        {%- if section.settings.menu != blank -%}
          {%- render 'header-drawer' -%}
        {%- endif -%}
      </div>

      <div class="header__branding">
        {{ header_logo }}
      </div>

      <div class="header__snoozer-entry small-hide medium-hide">
        {{ ask_snoozer_pill }}
      </div>

      <div class="header__icons{% if localization_forms %} header__icons--localization header-localization{% endif %}">
        <div class="desktop-localization-wrapper small-hide medium-hide">
          {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
            <localization-form data-prevent-hide>
              {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'localization.country_label' | t }}</h2>
                  {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {% endif %}

          {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            <localization-form data-prevent-hide>
              {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                  {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
        </div>

        <div class="header__store-meta small-hide medium-hide" aria-label="Store hours and showroom support">
          <span class="header__store-icon" aria-hidden="true">
            <span class="svg-wrapper">{{ 'icon-map-pin.svg' | inline_asset_content }}</span>
          </span>
          <div class="header__store-copy">
            <span class="header__store-title">Open By Appointment</span>
            <span class="header__store-text">Showroom + Virtual Support</span>
          </div>
        </div>

        <div class="header__action-group">
          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="header__icon header__icon--account header__utility-link link focus-inset"
            aria-label="Customer log in"
          >
            <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
            <span class="visually-hidden">Customer log in</span>
          </a>

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="header__app-slot small-hide medium-hide">
                {% render block %}
              </div>
          {%- endcase -%}
        {%- endfor -%}

          <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
            {% if cart == empty %}
              <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
            {% else %}
              <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
            {% endif %}
            <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
            {%- if cart != empty -%}
              <div class="cart-count-bubble">
                {%- if cart.item_count < 100 -%}
                  <span aria-hidden="true">{{ cart.item_count }}</span>
                {%- endif -%}
                <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
              </div>
            {%- endif -%}
          </a>
        </div>
      </div>
    </div>
    <div class="header__snoozer-row large-up-hide">
      {{ ask_snoozer_pill }}
    </div>
    {%- if section.settings.menu != blank -%}
      <nav class="header__mobile-nav large-up-hide" aria-label="Category navigation">
        <ul class="header__mobile-nav-list list-menu" role="list">
          {%- for link in section.settings.menu.links -%}
            <li class="header__mobile-nav-item">
              <a
                href="{{ link.url }}"
                class="header__mobile-nav-link{% if link.current %} header__mobile-nav-link--active{% endif %}"
              >
                {{ link.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
    {%- if show_desktop_menu -%}
      <div class="header__nav-row small-hide medium-hide">
        {%- if section.settings.menu_type_desktop == 'mega' -%}
          {%- render 'header-mega-menu' -%}
        {%- else -%}
          {%- render 'header-dropdown-menu' -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </header>
</div>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: section.settings.menu_type_desktop -%}
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

<script>
  (() => {
    if (window.__mysnoozepodSnoozerTriggerBound) return;
    window.__mysnoozepodSnoozerTriggerBound = true;

    function openSnoozer(source) {
      const detail = { source: source || 'unknown' };

      if (typeof window.openSnoozer === 'function') {
        window.openSnoozer(detail);
        return;
      }

      if (window.SnoozerHUD && typeof window.SnoozerHUD.open === 'function') {
        window.SnoozerHUD.open(detail);
        return;
      }

      if (window.Snoozer && typeof window.Snoozer.open === 'function') {
        window.Snoozer.open(detail);
        return;
      }

      window.dispatchEvent(new CustomEvent('mysnoozepod:snoozer:open', { detail }));
      window.dispatchEvent(new CustomEvent('snoozer:open', { detail }));
      console.log('Ask Snoozer clicked');
    }

    window.MySnoozePod = window.MySnoozePod || {};
    window.MySnoozePod.openSnoozer = openSnoozer;

    document.addEventListener('click', (event) => {
      const trigger = event.target.closest('[data-snoozer-trigger]');
      if (!trigger) return;

      event.preventDefault();
      openSnoozer(trigger.getAttribute('data-snoozer-source'));
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "max_blocks": 3,
  "settings": [
    {
      "type": "select",
      "id": "logo_position",
      "options": [
        {
          "value": "top-left",
          "label": "t:sections.header.settings.logo_position.options__2.label"
        },
