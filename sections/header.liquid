<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}" media="print" onload="this.media='all'">

{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<style>
  header-drawer {
    justify-self: start;
    margin-left: -0.8rem;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != 'drawer' -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.4rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: 1.4;
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 0.8rem;
    padding-top: 0.8rem;
    line-height: 1.4;
  }

  .header__main {
    display: grid;
    grid-template-columns: 4.4rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    min-height: 6.8rem;
    padding: 0.8rem 0 0.4rem;
  }

  .header__main-toggle {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .header__branding {
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  .header__heading-logo-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 16rem;
  }

  .header__heading-link {
    display: inline-flex;
    align-items: center;
    padding: 0;
  }

  .header__heading-link .h2 {
    margin: 0;
    font-size: clamp(2.2rem, 7vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .header__heading-logo {
    display: block;
    width: 100%;
    max-width: 16rem;
    height: auto;
    max-height: none;
  }

  .header__icons {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.4rem;
  }

  .header__action-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .header__store-meta {
    display: none;
  }

  .header__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 999px;
    color: #071a44;
  }

  .header__icon--account {
    width: 4.4rem;
    min-width: 4.4rem;
    padding: 0.8rem;
    border: 0.1rem solid rgba(7, 26, 68, 0.08);
    background: #ffffff;
  }

  .header__icon .svg-wrapper {
    width: 2.3rem;
    height: 2.3rem;
  }

  .header__icon--cart {
    width: 4.8rem;
    height: 4.8rem;
    border: 0.1rem solid #cbd5e1;
    border-radius: 999px;
    background: #ffffff;
    box-shadow: 0 0.6rem 1.6rem rgba(7, 26, 68, 0.06);
  }

  .header__icon--cart .svg-wrapper {
    width: 2.6rem;
    height: 2.6rem;
  }

  .header__icon--cart .cart-count-bubble {
    min-width: 1.8rem;
    min-height: 1.8rem;
    padding: 0 0.4rem;
    right: 0.1rem;
    top: 0.1rem;
  }

  .header__utility-link {
    gap: 0.8rem;
    text-decoration: none;
  }

  .header__utility-label {
    display: none;
  }

  .header__snoozer-entry {
    display: none;
  }

  .header__snoozer-row {
    padding: 0.4rem 0 0.2rem;
  }

  .header__mobile-nav {
    padding: 0.2rem 0 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    border-top: 0.1rem solid rgba(var(--color-text-primary), 0.08);
  }

  .header__mobile-nav::-webkit-scrollbar {
    display: none;
  }

  .header__mobile-nav-list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 1.8rem;
    overflow-x: auto;
    padding: 0.2rem 0 0.1rem;
  }

  .header__mobile-nav-item {
    flex: 0 0 auto;
  }

  .header__mobile-nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 4.2rem;
    padding: 0.3rem 0;
    white-space: nowrap;
    text-decoration: none;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.55rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
    color: #071a44;
  }

  .header__mobile-nav-link:hover,
  .header__mobile-nav-link--active {
    color: rgb(var(--color-text-primary));
  }

  .header__snoozer-pill {
    display: inline-flex;
    width: 100%;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.4rem;
    border: 0.1rem solid #cbd5e1;
    border-radius: 999px;
    min-height: 5rem;
    background: #ffffff;
    box-shadow: 0 0.5rem 1.4rem rgba(7, 26, 68, 0.05);
    color: #071a44;
    cursor: pointer;
    text-align: left;
  }

  .header__snoozer-pill:hover {
    border-color: rgba(7, 26, 68, 0.2);
    box-shadow: 0 1.2rem 2.8rem rgba(7, 26, 68, 0.08);
  }

  .header__snoozer-pill:focus-visible {
    outline: 0.2rem solid rgba(30, 92, 196, 0.24);
    outline-offset: 0.2rem;
  }

  .header__snoozer-avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    object-fit: contain;
    flex-shrink: 0;
    background: #ffffff;
  }

  .header__snoozer-text {
    flex: 1;
    min-width: 0;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.25;
    color: #243247;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header__snoozer-arrow {
    width: 1.9rem;
    height: 1.9rem;
    flex-shrink: 0;
    color: #071a44;
  }

  .header__snoozer-arrow .svg-wrapper,
  .header__snoozer-arrow svg {
    width: 100%;
    height: 100%;
  }

  .header__snoozer-arrow .svg-wrapper {
    display: block;
  }

  .header__nav-row {
    border-top: 0.1rem solid rgba(var(--color-text-primary), 0.08);
  }

  .header__nav-row .header__menu-item {
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
    color: #071a44;
    text-decoration: none;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .header__nav-row .header__menu-item .icon-caret,
  .header__nav-row .header__menu-item svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .header__snoozer-row .header__snoozer-pill {
    min-height: 5.2rem;
  }

  @media screen and (min-width: 990px) {
    .header__main {
      grid-template-columns: minmax(22rem, 1fr) 50.8rem minmax(30rem, 1fr);
      gap: 2rem;
      min-height: 8rem;
      padding: 0;
    }

    .header__main-toggle {
      display: none;
    }

    .header__branding {
      justify-content: flex-start;
      grid-column: 1;
    }

    .header__heading-logo-wrapper {
      max-width: 20rem;
      justify-content: flex-start;
    }

    .header__heading-logo {
      max-width: 20rem;
    }

    .header__snoozer-entry {
      display: flex;
      grid-column: 2 / 3;
      align-items: center;
      justify-content: center;
      justify-self: center;
      width: 50.8rem;
      min-width: 50.8rem;
      margin-top: 0;
      margin-bottom: 0;
      transform: translate(1.8rem, 2.4rem);
    }

    .header__snoozer-entry .header__snoozer-pill {
      width: 100%;
      max-width: 50.8rem;
      height: 6rem;
      min-height: 6rem;
      padding: 0 2.2rem;
      box-shadow: none;
    }

    .header__snoozer-entry .header__snoozer-avatar {
      width: 3.8rem;
      height: 3.8rem;
    }

    .header__snoozer-entry .header__snoozer-text {
      font-size: 1.9rem;
    }

    .header__icons {
      grid-column: 3;
      align-self: center;
      justify-self: end;
      gap: 0;
      align-items: center;
    }

    .header__action-group {
      gap: 1.2rem;
      transform: translate(-0.4rem, -0.4rem);
    }

    .header__icon--account {
      padding: 0.8rem;
    }

    .header__store-meta {
      display: grid;
      grid-template-columns: 2.2rem auto;
      align-items: center;
      gap: 1rem;
      margin-right: 2.2rem;
      padding-right: 1.6rem;
      border-right: 0.1rem solid rgba(7, 26, 68, 0.12);
      color: #071a44;
      transform: translate(-2.6rem, -0.6rem);
    }

    .header__store-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.2rem;
      height: 2.2rem;
      color: #071a44;
    }

    .header__store-icon .svg-wrapper,
    .header__store-icon svg {
      width: 100%;
      height: 100%;
    }

    .header__store-copy {
      display: grid;
      gap: 0.15rem;
      min-width: 0;
    }

    .header__store-title,
    .header__store-text {
      display: block;
      white-space: nowrap;
      font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
      color: #243247;
    }

    .header__store-title {
      font-size: 1.35rem;
      font-weight: 600;
      line-height: 1.1;
    }

    .header__store-text {
      font-size: 1.25rem;
      font-weight: 500;
      line-height: 1.1;
    }

    .header__icon--cart {
      width: 5rem;
      height: 5rem;
    }

    .header__icon--cart .svg-wrapper {
      width: 2.7rem;
      height: 2.7rem;
    }

    .header__nav-row {
      padding-top: 0;
    }

    .header__nav-row .header__inline-menu {
      width: 100%;
    }

    .header__nav-row .list-menu--inline {
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: center;
      gap: clamp(2.4rem, 2.8vw, 4.2rem);
      flex-wrap: nowrap;
    }

    .header__snoozer-row {
