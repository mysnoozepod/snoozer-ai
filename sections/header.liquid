<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}" media="print" onload="this.media='all'">

{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<style>
  header-drawer {
    justify-self: start;
    margin-left: -0.8rem;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != 'drawer' -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .header-wrapper {
    position: relative;
    z-index: 60;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.4rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: 1.4;
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 0.8rem;
    padding-top: 0.8rem;
    line-height: 1.4;
  }

  .header__main {
    display: grid;
    grid-template-columns: 4.4rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    min-height: 5.6rem;
    padding: 0.2rem 0 0;
  }

  .header__main-toggle {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .header__branding {
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  .header__heading-logo-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 16rem;
  }

  .header__heading-link {
    display: inline-flex;
    align-items: center;
    padding: 0;
  }

  .header__heading-link .h2 {
    margin: 0;
    font-size: clamp(2.2rem, 7vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .header__heading-logo {
    display: block;
    width: 100%;
    max-width: 16rem;
    height: auto;
    max-height: none;
  }

  .header__icons {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.4rem;
  }

  .header__action-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .header__store-meta {
    display: none;
  }

  .header__utility-separator {
    display: none;
  }

  .header__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 999px;
    color: #071a44;
  }

  .header__icon--account {
    width: 4.4rem;
    min-width: 4.4rem;
    padding: 0.8rem;
    border: 0.1rem solid rgba(7, 26, 68, 0.08);
    background: #ffffff;
  }

  .header__icon .svg-wrapper {
    width: 2.3rem;
    height: 2.3rem;
  }

  .header__icon--cart {
    width: 4.8rem;
    height: 4.8rem;
    border: 0.1rem solid #cbd5e1;
    border-radius: 999px;
    background: #ffffff;
    box-shadow: 0 0.6rem 1.6rem rgba(7, 26, 68, 0.06);
  }

  .header__icon--cart .svg-wrapper {
    width: 2.6rem;
    height: 2.6rem;
  }

  .header__icon--cart .cart-count-bubble {
    min-width: 1.8rem;
    min-height: 1.8rem;
    padding: 0 0.4rem;
    right: 0.1rem;
    top: 0.1rem;
  }

  .header__utility-link {
    gap: 0.8rem;
    text-decoration: none;
  }

  .header__utility-label {
    display: none;
  }

  .header__snooze-code-entry {
    display: none;
  }

  .header__snooze-code-form {
    display: none;
  }

  .header__snooze-code-label {
    margin: 0;
    color: #071a44;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .header__snooze-code-controls {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: nowrap;
  }

  .header__snooze-code-input {
    width: 16rem;
    min-height: 4.6rem;
    padding: 0 1.6rem;
    border: 0.1rem solid #cbd5e1;
    border-radius: 999px;
    background: #ffffff;
    color: #071a44;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .header__snooze-code-input::placeholder {
    color: rgba(7, 26, 68, 0.46);
  }

  .header__snooze-code-input:focus-visible {
    outline: 0.2rem solid rgba(30, 92, 196, 0.24);
    outline-offset: 0.2rem;
  }

  .header__snooze-code-button {
    min-width: 11rem;
    min-height: 4.6rem;
    padding: 0 1.6rem;
    border: 0.1rem solid #071a44;
    border-radius: 999px;
    background: #071a44;
    color: #ffffff;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.24rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 180ms ease, box-shadow 180ms ease, opacity 180ms ease;
  }

  .header__snooze-code-button:hover {
    transform: translateY(-0.1rem);
    box-shadow: 0 0.8rem 1.8rem rgba(7, 26, 68, 0.14);
  }

  .header__snooze-code-button:disabled {
    opacity: 0.65;
    cursor: wait;
    box-shadow: none;
    transform: none;
  }

  .header__snooze-code-status {
    min-height: 1.5rem;
    margin: 0;
    color: rgba(7, 26, 68, 0.66);
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.1rem;
    line-height: 1.35;
  }

  .header__snooze-code-status:empty {
    display: none;
  }

  .header__snooze-code-status.is-success {
    color: #124394;
  }

  .header__snooze-code-status.is-error {
    color: #991b1b;
  }

  .header__snoozer-entry {
    display: none;
  }

  .header__snoozer-row {
    padding: 0.4rem 0 0.2rem;
    position: relative;
    z-index: 22;
  }

  .header__snoozer-shell {
    position: relative;
    width: 100%;
  }

  .header__mobile-nav {
    padding: 0.2rem 0 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    border-top: 0.1rem solid rgba(var(--color-text-primary), 0.08);
  }

  .header__mobile-nav::-webkit-scrollbar {
    display: none;
  }

  .header__mobile-nav-list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 1.8rem;
    overflow-x: auto;
    padding: 0.2rem 0 0.1rem;
  }

  .header__mobile-nav-item {
    flex: 0 0 auto;
  }

  .header__mobile-nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 4.2rem;
    padding: 0.3rem 0;
    white-space: nowrap;
    text-decoration: none;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.55rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
    color: #071a44;
  }

  .header__mobile-nav-link:hover,
  .header__mobile-nav-link--active {
    color: rgb(var(--color-text-primary));
  }

  .header__snoozer-pill {
    display: inline-flex;
    width: 100%;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.4rem;
    border: 0.1rem solid #cbd5e1;
    border-radius: 999px;
    min-height: 5rem;
    background: #ffffff;
    box-shadow: 0 0.5rem 1.4rem rgba(7, 26, 68, 0.05);
    color: #071a44;
    cursor: pointer;
    text-align: left;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .header__snoozer-pill:hover {
    border-color: rgba(7, 26, 68, 0.2);
    box-shadow: 0 1.2rem 2.8rem rgba(7, 26, 68, 0.08);
  }

  .header__snoozer-pill:focus-visible {
    outline: 0.2rem solid rgba(30, 92, 196, 0.24);
    outline-offset: 0.2rem;
  }

  .header__snoozer-avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    object-fit: contain;
    flex-shrink: 0;
    background: #ffffff;
  }

  .header__snoozer-copy {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    gap: 0.1rem;
  }

  .header__snoozer-text {
    min-width: 0;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.25;
    color: #243247;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header__snoozer-hint {
    display: none;
    margin: 0;
    color: rgba(36, 50, 71, 0.68);
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.14rem;
    font-weight: 500;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header__snoozer-arrow {
    width: 1.9rem;
    height: 1.9rem;
    flex-shrink: 0;
    color: #071a44;
  }

  .header__snoozer-arrow .svg-wrapper,
  .header__snoozer-arrow svg {
    width: 100%;
    height: 100%;
  }

  .header__snoozer-arrow .svg-wrapper {
    display: block;
  }

  .header__nav-row {
    border-top: 0.1rem solid rgba(var(--color-text-primary), 0.08);
    position: relative;
    z-index: 95;
  }

  .header__nav-row .header__menu-item {
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: 0;
    color: #071a44;
    text-decoration: none;
    padding-top: 0.7rem;
    padding-bottom: 0.7rem;
  }

  .header__nav-row .header__menu-item .icon-caret,
  .header__nav-row .header__menu-item svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .header__nav-row header-menu,
  .header__nav-row .mega-menu,
  .header__nav-row details {
    position: relative;
  }

  .header__nav-row details[open] {
    z-index: 140;
  }

  .header__nav-row .header__submenu,
  .header__nav-row .mega-menu__content {
    background: #ffffff !important;
    background-image: none !important;
    border: 0.1rem solid rgba(7, 26, 68, 0.12);
    border-radius: 1.6rem;
    box-shadow: 0 1.8rem 3.6rem rgba(7, 26, 68, 0.14);
    color: #071a44;
    overflow: hidden;
    z-index: 140;
  }

  .header__nav-row .header__submenu {
    min-width: 26rem;
    padding: 0.8rem 0;
  }

  .header__nav-row .header__submenu .header__menu-item,
  .header__nav-row .mega-menu__link {
    display: flex;
    align-items: center;
    min-height: auto;
    color: #071a44;
    text-decoration: none;
  }

  .header__nav-row .header__submenu .header__menu-item {
    padding: 1rem 1.6rem;
  }

  .header__nav-row .header__submenu .header__menu-item:hover,
  .header__nav-row .header__submenu .header__menu-item:focus-visible,
  .header__nav-row .mega-menu__link:hover,
  .header__nav-row .mega-menu__link:focus-visible {
    background: #f6f8fc;
    color: #071942;
    outline: none;
  }

  .header__nav-row .mega-menu__content {
    padding: 1.8rem 2rem;
  }

  .header__nav-row .mega-menu__list {
    gap: 1.6rem 2.4rem;
    padding: 0;
  }

  .header__snoozer-row .header__snoozer-pill {
    min-height: 5.2rem;
  }

  .header__snoozer-shell.is-open .header__snoozer-pill {
    border-color: rgba(7, 26, 68, 0.16);
    box-shadow: 0 1rem 2.4rem rgba(7, 26, 68, 0.12);
  }

  .header__snoozer-shell.is-open .header__snoozer-arrow {
    transform: rotate(90deg);
  }

  .header__snoozer-panel {
    position: absolute;
    top: calc(100% + 1rem);
    left: 0;
    width: 100%;
    max-width: 100%;
    max-height: min(78vh, calc(100vh - 11rem));
    padding: 1.8rem;
    border: 0.1rem solid rgba(7, 26, 68, 0.1);
    border-radius: 2.4rem;
    background: #ffffff;
    box-shadow: 0 2.4rem 5.4rem rgba(7, 26, 68, 0.14);
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-0.8rem);
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
    z-index: 30;
  }

  .header__snoozer-shell.is-open .header__snoozer-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .header__snoozer-panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.2rem;
    margin-bottom: 1.4rem;
  }

  .header__snoozer-kicker {
    margin: 0 0 0.4rem;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(7, 26, 68, 0.66);
  }

  .header__snoozer-support {
    margin: 0;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1.45;
    color: #243247;
  }

  .header__snoozer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #eef3f9;
    color: #071a44;
    cursor: pointer;
    flex: 0 0 auto;
  }

  .header__snoozer-close span {
    display: block;
    font-size: 2rem;
    line-height: 1;
  }

  .header__snoozer-input-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.8rem;
    margin-bottom: 1.2rem;
  }

  .header__snoozer-input {
    width: 100%;
    min-width: 0;
    min-height: 4.6rem;
    padding: 0 1.4rem;
    border: 0.1rem solid rgba(7, 26, 68, 0.12);
    border-radius: 1.6rem;
    background: #f6f8fb;
    color: #071a44;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.45rem;
    line-height: 1.2;
  }

  .header__snoozer-input::placeholder {
    color: rgba(36, 50, 71, 0.72);
  }

  .header__snoozer-input:focus-visible {
    outline: 0.2rem solid rgba(30, 92, 196, 0.2);
    outline-offset: 0.2rem;
  }

  .header__snoozer-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.6rem;
    padding: 0 1.6rem;
    border: 0;
    border-radius: 1.6rem;
    background: #071a44;
    color: #ffffff;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    white-space: nowrap;
  }

  .header__snoozer-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 0;
  }

  .header__snoozer-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.6rem;
    padding: 0 1.2rem;
    border: 0.1rem solid rgba(7, 26, 68, 0.12);
    border-radius: 999px;
    background: #f8fafc;
    color: #243247;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .header__snoozer-chip[aria-pressed='true'],
  .header__snoozer-chip:hover,
  .header__snoozer-chip:focus-visible {
    border-color: rgba(7, 26, 68, 0.22);
    background: #edf4ff;
    color: #071a44;
    transform: translateY(-0.1rem);
  }

  .header__snoozer-chip-zone,
  .header__snoozer-results {
    display: grid;
    gap: 0.85rem;
  }

  .header__snoozer-chip-zone {
    margin-bottom: 1.4rem;
  }

  .header__snoozer-section-label {
    margin: 0;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(7, 26, 68, 0.62);
  }

  .header__snoozer-response-card {
    margin-bottom: 1.5rem;
    padding: 1.45rem 1.45rem 1.5rem;
    border: 0.1rem solid rgba(18, 67, 148, 0.14);
    border-radius: 2rem;
    background: linear-gradient(180deg, #eef4ff 0%, #f7faff 100%);
    box-shadow: 0 1.2rem 2.8rem rgba(7, 26, 68, 0.08);
  }

  .header__snoozer-response-kicker {
    margin: 0 0 0.55rem;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(7, 26, 68, 0.62);
  }

  .header__snoozer-last-query {
    margin: 0 0 0.7rem;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.18rem;
    font-weight: 600;
    line-height: 1.4;
    color: rgba(36, 50, 71, 0.82);
  }

  .header__snoozer-last-query[hidden],
  .header__snoozer-results[hidden] {
    display: none !important;
  }

  .header__snoozer-response {
    margin: 0;
    color: #243247;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.46rem;
    font-weight: 600;
    line-height: 1.58;
  }

  .header__snoozer-actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .header__snoozer-action {
    display: grid;
    gap: 0.35rem;
    padding: 1.2rem 1.3rem;
    border: 0.1rem solid rgba(7, 26, 68, 0.1);
    border-radius: 1.8rem;
    background: #ffffff;
    text-decoration: none;
    color: #071a44;
    box-shadow: 0 0.8rem 1.8rem rgba(7, 26, 68, 0.05);
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .header__snoozer-action:hover,
  .header__snoozer-action:focus-visible {
    transform: translateY(-0.15rem);
    border-color: rgba(18, 67, 148, 0.18);
    box-shadow: 0 1.2rem 2.2rem rgba(7, 26, 68, 0.08);
  }

  .header__snoozer-action--product {
    background: #fcfdff;
    border-color: rgba(18, 67, 148, 0.14);
  }

  .header__snoozer-action-label {
    display: block;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .header__snoozer-action-copy {
    display: block;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.35;
    color: rgba(36, 50, 71, 0.76);
  }

  .header__snoozer-action-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.15rem;
  }

  .header__snoozer-action-tag {
    display: inline-flex;
    align-items: center;
    min-height: 2.1rem;
    padding: 0 0.7rem;
    border-radius: 999px;
    background: #edf4ff;
    color: #124394;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  @media screen and (min-width: 990px) {
    .header__main {
      grid-template-columns: minmax(24rem, 26rem) minmax(0, 1fr) auto;
      gap: 0.6rem 1.4rem;
      min-height: auto;
      padding: 0.7rem 0 0.35rem;
      align-items: center;
    }

    .header__main-toggle {
      display: none;
    }

    .header__branding {
      justify-content: flex-start;
      grid-column: 1;
      grid-row: 1;
    }

    .header__heading-logo-wrapper {
      max-width: 22rem;
      justify-content: flex-start;
    }

    .header__heading-logo {
      max-width: 22rem;
    }

    .header__snoozer-entry {
      display: flex;
      grid-column: 1 / -1;
      grid-row: 2;
      align-items: center;
      align-self: center;
      justify-content: center;
      justify-self: center;
      position: relative;
      overflow: visible;
      width: min(100%, 58rem);
      min-width: 0;
      max-width: 58rem;
      margin-top: 0;
      margin-bottom: 0;
      transform: none;
      z-index: 40;
    }

    .header__snoozer-entry .header__snoozer-pill {
      width: 100%;
      max-width: 58rem;
      height: 5.8rem;
      min-height: 5.8rem;
      padding: 0 2rem;
      box-shadow: none;
    }

    .header__snoozer-entry .header__snoozer-avatar {
      width: 3.5rem;
      height: 3.5rem;
    }

    .header__snoozer-entry .header__snoozer-text {
      font-size: 1.74rem;
      font-weight: 700;
      line-height: 1.1;
    }

    .header__snoozer-entry .header__snoozer-hint {
      display: block;
    }

    .header__snoozer-entry .header__snoozer-panel {
      padding: 2rem;
      background: #ffffff;
      border-color: rgba(7, 26, 68, 0.14);
      box-shadow: 0 3.2rem 7.2rem rgba(7, 26, 68, 0.18), 0 0.8rem 2rem rgba(7, 26, 68, 0.08);
      z-index: 145;
    }

    .header__icons {
      grid-column: 3;
      grid-row: 1;
      align-self: center;
      justify-self: end;
      gap: 0.9rem;
      align-items: center;
      min-width: 0;
      transform: none;
    }

    .header__action-group {
      gap: 0.9rem;
      transform: none;
      align-items: center;
    }

    .header__snooze-code-entry {
      display: flex;
      align-items: center;
      margin-right: 1.2rem;
    }

    .header__snooze-code-form {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      width: auto;
      align-items: flex-start;
    }

    .header__icon--account {
      width: 4.8rem;
      height: 4.8rem;
      padding: 0.8rem;
    }

    .header__store-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      color: #071a44;
    }

    .header__store-icon .svg-wrapper,
    .header__store-icon svg {
      width: 100%;
      height: 100%;
    }

    .header__store-copy {
      display: grid;
      gap: 0.15rem;
      min-width: 0;
      overflow: hidden;
    }

    .header__store-title,
    .header__store-text {
      display: block;
      white-space: nowrap;
      font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
      color: #243247;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .header__store-title {
      font-size: 1.24rem;
      font-weight: 600;
      line-height: 1.1;
    }

    .header__store-text {
      font-size: 1.16rem;
      font-weight: 500;
      line-height: 1.1;
    }

    .header__icon--cart {
      width: 4.8rem;
      height: 4.8rem;
    }

    .header__icon--cart .svg-wrapper {
      width: 2.5rem;
      height: 2.5rem;
    }

    .header__nav-row {
      padding-top: 0;
      min-height: 5rem;
    }

    .header__nav-row .header__inline-menu {
      width: 100%;
      min-height: 5rem;
      display: flex;
      align-items: center;
    }

    .header__nav-row .list-menu--inline {
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: center;
      gap: clamp(2rem, 2.2vw, 3.4rem);
      flex-wrap: nowrap;
    }

    .header__nav-row .header__submenu {
      top: calc(100% + 0.8rem);
      left: 0;
    }

    .header__nav-row .mega-menu__content {
      top: calc(100% + 0.8rem);
    }

    .header__snoozer-row {
      display: none;
    }

    .header__mobile-nav {
      display: none;
    }
  }

  @media screen and (min-width: 990px) and (max-width: 1240px) {
    .header__main {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1rem 1.2rem;
      min-height: auto;
      padding: 1rem 0 1.1rem;
    }

    .header__branding {
      grid-column: 1;
      grid-row: 1;
    }

    .header__icons {
      grid-column: 2;
      grid-row: 1;
      transform: none;
    }

    .header__snoozer-entry {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: center;
      width: min(88%, 64rem);
      max-width: 64rem;
      margin-top: 0.2rem;
    }

    .header__snooze-code-form {
      width: auto;
    }

    .header__snooze-code-entry {
      margin-right: 0.8rem;
    }
  }

  @media screen and (max-width: 989px) {
    .header--snoozer-open .header__mobile-nav {
      display: none;
    }

    .header__snoozer-panel {
      width: 100%;
      max-width: 100%;
      max-height: calc(100vh - 9rem);
      padding: 1.6rem;
      border-radius: 2rem;
    }

    .header__snoozer-input-wrap,
    .header__snoozer-actions {
      grid-template-columns: 1fr;
    }

    .header__snoozer-action {
      padding: 1.15rem 1.3rem;
    }
  }
</style>

{%- style -%}
  .header {
    padding: 0;
  }

  .section-header {
    margin-bottom: 0;
  }
{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

{%- assign snoozer_assessment_url = '/pages/snooze-assessment' -%}
{%- assign snoozer_mattresses_url = '/collections/mattresses' -%}
{%- assign snoozer_bases_url = '/products/premium-motion-adjustable-base' -%}
{%- assign snoozer_booking_url = '/pages/book-a-snooze-session' -%}
{%- assign snoozer_expectations_url = '/pages/book-a-snooze-session' -%}

<div class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}">
  {%- liquid
    assign social_links = false
    assign localization_forms = false

    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
      assign social_links = true
    endif

    if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
      assign localization_forms = true
    endif

    assign show_desktop_menu = false
    if section.settings.menu != blank and section.settings.menu_type_desktop != 'drawer'
      assign show_desktop_menu = true
    endif
  -%}

  {%- capture header_logo -%}
    {%- if request.page_type == 'index' -%}
      <h1 class="header__heading">
    {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
        {%- if settings.logo != blank -%}
          <div class="header__heading-logo-wrapper">
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
            {% capture sizes %}(min-width: 990px) {{ settings.logo_width }}px, 140px{% endcapture %}
            {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
            {{
              settings.logo
              | image_url: width: 600
              | image_tag:
                class: 'header__heading-logo motion-reduce',
                widths: widths,
                height: logo_height,
                width: settings.logo_width,
                alt: logo_alt,
                sizes: sizes,
                preload: true
            }}
          </div>
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    {%- if request.page_type == 'index' -%}
      </h1>
    {%- endif -%}
  {%- endcapture -%}

  {%- capture ask_snoozer_panel_inner -%}
    <div class="header__snoozer-panel-head">
      <div>
        <p class="header__snoozer-kicker">Snoozer</p>
        <p class="header__snoozer-support">Tell me how you sleep and what feels off.</p>
      </div>
      <button type="button" class="header__snoozer-close large-up-hide" data-snoozer-close aria-label="Close Ask Snoozer panel">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
    <form class="header__snoozer-input-wrap" data-snoozer-form>
      <input
        type="text"
        class="header__snoozer-input"
        data-snoozer-input
        autocomplete="off"
        placeholder="Ask about comfort, cooling, support, or your visit"
        aria-label="Tell Snoozer what you need help with"
      >
      <button type="submit" class="header__snoozer-submit">Get Guidance</button>
    </form>
    <div class="header__snoozer-chip-zone">
      <p class="header__snoozer-section-label">Good places to start</p>
      <div class="header__snoozer-chip-list" data-snoozer-chip-list aria-label="Suggested Snoozer prompts">
        <button type="button" class="header__snoozer-chip" data-snoozer-chip data-snoozer-response-text="Cooling and airflow matter most here. I can help narrow the right feel and setup.">I sleep hot</button>
        <button type="button" class="header__snoozer-chip" data-snoozer-chip data-snoozer-response-text="Better support should help alignment without making comfort feel rigid.">I need better support</button>
        <button type="button" class="header__snoozer-chip" data-snoozer-chip data-snoozer-response-text="Sleep position and gentle elevation can both help when snoring is part of the picture.">I snore</button>
        <button type="button" class="header__snoozer-chip" data-snoozer-chip data-snoozer-response-text="Compare feel, support, cooling, and adjustability before you compare price.">Help me compare mattresses</button>
      </div>
    </div>
    <div class="header__snoozer-response-card">
      <p class="header__snoozer-response-kicker">Snoozer says</p>
      <p class="header__snoozer-last-query" data-snoozer-last-query hidden></p>
      <p class="header__snoozer-response" data-snoozer-response aria-live="polite">Start with how you sleep now. I'll help narrow the best next step.</p>
    </div>
    <div class="header__snoozer-results" data-snoozer-results>
      <p class="header__snoozer-section-label" data-snoozer-results-label>Good starting points</p>
      <div class="header__snoozer-actions" data-snoozer-actions>
        <a href="{{ snoozer_assessment_url }}" class="header__snoozer-action" data-snoozer-placeholder-link>
          <span class="header__snoozer-action-label">Take Snooze Assessment</span>
          <span class="header__snoozer-action-copy">Start with your sleep profile.</span>
        </a>
        <a href="{{ snoozer_mattresses_url }}" class="header__snoozer-action">
          <span class="header__snoozer-action-label">View Mattresses</span>
          <span class="header__snoozer-action-copy">Compare feel, support, and cooling.</span>
        </a>
        <a href="{{ snoozer_booking_url }}" class="header__snoozer-action">
          <span class="header__snoozer-action-label">Book a Snooze Session</span>
          <span class="header__snoozer-action-copy">Visit with a clearer starting point.</span>
        </a>
      </div>
    </div>
  {%- endcapture -%}

  {%- capture ask_snoozer_desktop -%}
    <div class="header__snoozer-shell" data-snoozer-shell>
      <button
        type="button"
        class="header__snoozer-pill"
        data-snoozer-trigger
        data-snoozer-anchor-trigger
        data-snoozer-source="header-desktop"
        aria-label="Ask Snoozer anything about your sleep"
        aria-expanded="false"
        aria-controls="HeaderSnoozerPanelDesktop-{{ section.id }}"
        >
        <img
          src="{{ 'snoozer-avatar.png' | asset_url }}"
          alt="Snoozer avatar"
          class="header__snoozer-avatar"
          loading="eager"
          width="36"
          height="36"
        >
        <span class="header__snoozer-copy">
          <span class="header__snoozer-text">Ask Snoozer</span>
          <span class="header__snoozer-hint">Comfort, cooling, support, or visit help</span>
        </span>
        <span class="header__snoozer-arrow" aria-hidden="true">
          <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        </span>
      </button>
      <div
        id="HeaderSnoozerPanelDesktop-{{ section.id }}"
        class="header__snoozer-panel"
        data-snoozer-panel
        role="region"
        aria-label="Ask Snoozer guided search"
        aria-hidden="true"
      >
        {{ ask_snoozer_panel_inner }}
      </div>
    </div>
  {%- endcapture -%}

  {%- capture ask_snoozer_mobile -%}
    <div class="header__snoozer-shell" data-snoozer-shell>
      <button
        type="button"
        class="header__snoozer-pill"
        data-snoozer-trigger
        data-snoozer-anchor-trigger
        data-snoozer-source="header-mobile"
        aria-label="Ask Snoozer anything about your sleep"
        aria-expanded="false"
        aria-controls="HeaderSnoozerPanelMobile-{{ section.id }}"
      >
        <img
          src="{{ 'snoozer-avatar.png' | asset_url }}"
          alt="Snoozer avatar"
          class="header__snoozer-avatar"
          loading="eager"
          width="36"
          height="36"
        >
        <span class="header__snoozer-copy">
          <span class="header__snoozer-text">Ask Snoozer</span>
          <span class="header__snoozer-hint">Comfort, cooling, support, or visit help</span>
        </span>
        <span class="header__snoozer-arrow" aria-hidden="true">
          <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        </span>
      </button>
      <div
        id="HeaderSnoozerPanelMobile-{{ section.id }}"
        class="header__snoozer-panel"
        data-snoozer-panel
        role="region"
        aria-label="Ask Snoozer guided search"
        aria-hidden="true"
      >
        {{ ask_snoozer_panel_inner }}
      </div>
    </div>
  {%- endcapture -%}

  <header class="header page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}{% if social_links %} header--has-social{% endif %}{% if shop.customer_accounts_enabled %} header--has-account{% endif %}{% if localization_forms %} header--has-localizations{% endif %} header--mobile-{{ section.settings.mobile_logo_position }}">
    <div class="header__main">
      <div class="header__main-toggle">
        {%- if section.settings.menu != blank -%}
          {%- render 'header-drawer' -%}
        {%- endif -%}
      </div>

      <div class="header__branding">
        {{ header_logo }}
      </div>

      <div class="header__snoozer-entry small-hide medium-hide">
        {{ ask_snoozer_desktop }}
      </div>

      <div class="header__icons{% if localization_forms %} header__icons--localization header-localization{% endif %}">
        <div class="desktop-localization-wrapper small-hide medium-hide">
          {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
            <localization-form data-prevent-hide>
              {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'localization.country_label' | t }}</h2>
                  {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {% endif %}

          {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            <localization-form data-prevent-hide>
              {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                  {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
        </div>

        <div class="header__action-group">
          <div class="header__snooze-code-entry small-hide medium-hide">
            <form class="header__snooze-code-form" data-snooze-checkin-form>
              <label class="header__snooze-code-label" for="HeaderSnoozeCode-{{ section.id }}">SNOOZE CODE</label>
              <div class="header__snooze-code-controls">
                <input
                  id="HeaderSnoozeCode-{{ section.id }}"
                  class="header__snooze-code-input"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  placeholder="Enter code"
                  aria-label="Enter Snooze Code"
                  data-snooze-checkin-input
                >
                <button
                  type="submit"
                  class="header__snooze-code-button"
                  data-snooze-checkin-submit
                >
                  Check In
                </button>
              </div>
              <p class="header__snooze-code-status" data-snooze-checkin-status aria-live="polite"></p>
            </form>
          </div>

          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="header__icon header__icon--account header__utility-link link focus-inset"
            aria-label="Customer log in"
          >
            <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
            <span class="visually-hidden">Customer log in</span>
          </a>

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="header__app-slot small-hide medium-hide">
                {% render block %}
              </div>
          {%- endcase -%}
        {%- endfor -%}

          <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
            {% if cart == empty %}
              <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
            {% else %}
              <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
            {% endif %}
            <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
            {%- if cart != empty -%}
              <div class="cart-count-bubble">
                {%- if cart.item_count < 100 -%}
                  <span aria-hidden="true">{{ cart.item_count }}</span>
                {%- endif -%}
                <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
              </div>
            {%- endif -%}
          </a>
        </div>
      </div>
    </div>
    <div class="header__snoozer-row large-up-hide">
      {{ ask_snoozer_mobile }}
    </div>
    {%- if section.settings.menu != blank -%}
      <nav class="header__mobile-nav large-up-hide" aria-label="Category navigation">
        <ul class="header__mobile-nav-list list-menu" role="list">
          {%- for link in section.settings.menu.links -%}
            <li class="header__mobile-nav-item">
              <a
                href="{{ link.url }}"
                class="header__mobile-nav-link{% if link.current %} header__mobile-nav-link--active{% endif %}"
              >
                {{ link.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
    {%- if show_desktop_menu -%}
      <div class="header__nav-row small-hide medium-hide">
        {%- if section.settings.menu_type_desktop == 'mega' -%}
          {%- render 'header-mega-menu' -%}
        {%- else -%}
          {%- render 'header-dropdown-menu' -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </header>
</div>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: section.settings.menu_type_desktop -%}
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

<script>
  (() => {
    if (window.__mysnoozepodSnoozerTriggerBound) return;
    window.__mysnoozepodSnoozerTriggerBound = true;

    const defaultResponse = "Start with how you sleep now. I'll help narrow the best next step.";
    const fallbackResponse = "I can still help. Try one of these guided starting points.";
    const loadingResponse = "Snoozer is checking that for you...";
    const defaultInputPlaceholder = "Ask about comfort, cooling, support, or your visit";
    const followUpInputPlaceholder = "Ask another sleep question...";
    const shells = Array.from(document.querySelectorAll('[data-snoozer-shell]'));
    const header = document.querySelector('.header');
    const requestPageType = {{ request.page_type | json }};
    const HUD_ASK_TIMEOUT_MS = 3000;
    const SNOOZER_SESSION_STORAGE_KEY = 'mysnoozepod_snoozer_session_id';
    let lastPointerOpen = 0;
    const routes = {
      assessment: {{ snoozer_assessment_url | json }},
      mattresses: {{ snoozer_mattresses_url | json }},
      bases: {{ snoozer_bases_url | json }},
      booking: {{ snoozer_booking_url | json }},
      expectations: {{ snoozer_expectations_url | json }}
    };
    const routeAliases = {
      '/pages/book-your-snooze-session': routes.booking,
      '/pages/booking-a-snooze-session': routes.booking
    };
    const knownDeadHrefs = ['#'];
    const knownStaticHrefs = [
      routes.assessment,
      routes.mattresses,
      routes.bases,
      routes.booking,
      routes.expectations
    ].filter(Boolean);
    const liveFallbackChips = [
