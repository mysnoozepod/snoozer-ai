<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}" media="print" onload="this.media='all'">

{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<style>
  header-drawer {
    justify-self: start;
    margin-left: -0.8rem;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != 'drawer' -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.4rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: 1.4;
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 0.8rem;
    padding-top: 0.8rem;
    line-height: 1.4;
  }

  .header__main {
    display: grid;
    grid-template-columns: 4.4rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    min-height: 5.6rem;
    padding: 0.2rem 0 0;
  }

  .header__main-toggle {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .header__branding {
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  .header__heading-logo-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 16rem;
  }

  .header__heading-link {
    display: inline-flex;
    align-items: center;
    padding: 0;
  }

  .header__heading-link .h2 {
    margin: 0;
    font-size: clamp(2.2rem, 7vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .header__heading-logo {
    display: block;
    width: 100%;
    max-width: 16rem;
    height: auto;
    max-height: none;
  }

  .header__icons {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.4rem;
  }

  .header__action-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .header__store-meta {
    display: none;
  }

  .header__utility-separator {
    display: none;
  }

  .header__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 999px;
    color: #071a44;
  }

  .header__icon--account {
    width: 4.4rem;
    min-width: 4.4rem;
    padding: 0.8rem;
    border: 0.1rem solid rgba(7, 26, 68, 0.08);
    background: #ffffff;
  }

  .header__icon .svg-wrapper {
    width: 2.3rem;
    height: 2.3rem;
  }

  .header__icon--cart {
    width: 4.8rem;
    height: 4.8rem;
    border: 0.1rem solid #cbd5e1;
    border-radius: 999px;
    background: #ffffff;
    box-shadow: 0 0.6rem 1.6rem rgba(7, 26, 68, 0.06);
  }

  .header__icon--cart .svg-wrapper {
    width: 2.6rem;
    height: 2.6rem;
  }

  .header__icon--cart .cart-count-bubble {
    min-width: 1.8rem;
    min-height: 1.8rem;
    padding: 0 0.4rem;
    right: 0.1rem;
    top: 0.1rem;
  }

  .header__utility-link {
    gap: 0.8rem;
    text-decoration: none;
  }

  .header__utility-label {
    display: none;
  }

  .header__snoozer-entry {
    display: none;
  }

  .header__snoozer-row {
    padding: 0.4rem 0 0.2rem;
    position: relative;
    z-index: 22;
  }

  .header__snoozer-shell {
    position: relative;
    width: 100%;
  }

  .header__mobile-nav {
    padding: 0.2rem 0 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    border-top: 0.1rem solid rgba(var(--color-text-primary), 0.08);
  }

  .header__mobile-nav::-webkit-scrollbar {
    display: none;
  }

  .header__mobile-nav-list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 1.8rem;
    overflow-x: auto;
    padding: 0.2rem 0 0.1rem;
  }

  .header__mobile-nav-item {
    flex: 0 0 auto;
  }

  .header__mobile-nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 4.2rem;
    padding: 0.3rem 0;
    white-space: nowrap;
    text-decoration: none;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.55rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
    color: #071a44;
  }

  .header__mobile-nav-link:hover,
  .header__mobile-nav-link--active {
    color: rgb(var(--color-text-primary));
  }

  .header__snoozer-pill {
    display: inline-flex;
    width: 100%;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.4rem;
    border: 0.1rem solid #cbd5e1;
    border-radius: 999px;
    min-height: 5rem;
    background: #ffffff;
    box-shadow: 0 0.5rem 1.4rem rgba(7, 26, 68, 0.05);
    color: #071a44;
    cursor: pointer;
    text-align: left;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .header__snoozer-pill:hover {
    border-color: rgba(7, 26, 68, 0.2);
    box-shadow: 0 1.2rem 2.8rem rgba(7, 26, 68, 0.08);
  }

  .header__snoozer-pill:focus-visible {
    outline: 0.2rem solid rgba(30, 92, 196, 0.24);
    outline-offset: 0.2rem;
  }

  .header__snoozer-avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    object-fit: contain;
    flex-shrink: 0;
    background: #ffffff;
  }

  .header__snoozer-text {
    flex: 1;
    min-width: 0;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.25;
    color: #243247;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header__snoozer-arrow {
    width: 1.9rem;
    height: 1.9rem;
    flex-shrink: 0;
    color: #071a44;
  }

  .header__snoozer-arrow .svg-wrapper,
  .header__snoozer-arrow svg {
    width: 100%;
    height: 100%;
  }

  .header__snoozer-arrow .svg-wrapper {
    display: block;
  }

  .header__nav-row {
    border-top: 0.1rem solid rgba(var(--color-text-primary), 0.08);
  }

  .header__nav-row .header__menu-item {
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0;
    color: #071a44;
    text-decoration: none;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .header__nav-row .header__menu-item .icon-caret,
  .header__nav-row .header__menu-item svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .header__snoozer-row .header__snoozer-pill {
    min-height: 5.2rem;
  }

  .header__snoozer-shell.is-open .header__snoozer-pill {
    border-color: rgba(7, 26, 68, 0.16);
    box-shadow: 0 1rem 2.4rem rgba(7, 26, 68, 0.12);
  }

  .header__snoozer-shell.is-open .header__snoozer-arrow {
    transform: rotate(90deg);
  }

  .header__snoozer-panel {
    position: absolute;
    top: calc(100% + 1rem);
    left: 0;
    width: 100%;
    max-width: 100%;
    padding: 1.8rem;
    border: 0.1rem solid rgba(7, 26, 68, 0.1);
    border-radius: 2.4rem;
    background: #ffffff;
    box-shadow: 0 2.4rem 5.4rem rgba(7, 26, 68, 0.14);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-0.8rem);
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
    z-index: 30;
  }

  .header__snoozer-shell.is-open .header__snoozer-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .header__snoozer-panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.2rem;
    margin-bottom: 1.4rem;
  }

  .header__snoozer-kicker {
    margin: 0 0 0.4rem;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(7, 26, 68, 0.66);
  }

  .header__snoozer-support {
    margin: 0;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1.45;
    color: #243247;
  }

  .header__snoozer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #eef3f9;
    color: #071a44;
    cursor: pointer;
    flex: 0 0 auto;
  }

  .header__snoozer-close span {
    display: block;
    font-size: 2rem;
    line-height: 1;
  }

  .header__snoozer-input-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.8rem;
    margin-bottom: 1.4rem;
  }

  .header__snoozer-input {
    width: 100%;
    min-width: 0;
    min-height: 4.6rem;
    padding: 0 1.4rem;
    border: 0.1rem solid rgba(7, 26, 68, 0.12);
    border-radius: 1.6rem;
    background: #f6f8fb;
    color: #071a44;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.45rem;
    line-height: 1.2;
  }

  .header__snoozer-input::placeholder {
    color: rgba(36, 50, 71, 0.72);
  }

  .header__snoozer-input:focus-visible {
    outline: 0.2rem solid rgba(30, 92, 196, 0.2);
    outline-offset: 0.2rem;
  }

  .header__snoozer-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.6rem;
    padding: 0 1.6rem;
    border: 0;
    border-radius: 1.6rem;
    background: #071a44;
    color: #ffffff;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    white-space: nowrap;
  }

  .header__snoozer-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 1.4rem;
  }

  .header__snoozer-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.6rem;
    padding: 0 1.2rem;
    border: 0.1rem solid rgba(7, 26, 68, 0.1);
    border-radius: 999px;
    background: #f6f8fb;
    color: #243247;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease;
  }

  .header__snoozer-chip[aria-pressed='true'],
  .header__snoozer-chip:hover,
  .header__snoozer-chip:focus-visible {
    border-color: rgba(7, 26, 68, 0.22);
    background: #eef4fb;
    color: #071a44;
  }

  .header__snoozer-response {
    margin: 0 0 1.4rem;
    padding: 1.3rem 1.4rem;
    border-radius: 1.8rem;
    background: #f8fafc;
    color: #243247;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.4rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .header__snoozer-actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .header__snoozer-action {
    display: grid;
    gap: 0.35rem;
    padding: 1.2rem 1.3rem;
    border: 0.1rem solid rgba(7, 26, 68, 0.1);
    border-radius: 1.8rem;
    background: #ffffff;
    text-decoration: none;
    color: #071a44;
    box-shadow: 0 0.8rem 1.8rem rgba(7, 26, 68, 0.05);
  }

  .header__snoozer-action-label {
    display: block;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .header__snoozer-action-copy {
    display: block;
    font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.35;
    color: rgba(36, 50, 71, 0.76);
  }

  @media screen and (min-width: 990px) {
    .header__main {
      grid-template-columns: minmax(22rem, 1fr) 50.8rem minmax(30rem, 1fr);
      gap: 2rem;
      min-height: 8rem;
      padding: 0;
    }

    .header__main-toggle {
      display: none;
    }

    .header__branding {
      justify-content: flex-start;
      grid-column: 1;
    }

    .header__heading-logo-wrapper {
      max-width: 20rem;
      justify-content: flex-start;
    }

    .header__heading-logo {
      max-width: 20rem;
    }

    .header__snoozer-entry {
      display: flex;
      grid-column: 2 / 3;
      align-items: center;
      justify-content: center;
      justify-self: center;
      position: relative;
      overflow: visible;
      width: 50.8rem;
      min-width: 50.8rem;
      margin-top: 0;
      margin-bottom: 0;
      transform: translate(0, 6.4rem);
    }

    .header__snoozer-entry .header__snoozer-pill {
      width: 100%;
      max-width: 50.8rem;
      height: 6rem;
      min-height: 6rem;
      padding: 0 2.2rem;
      box-shadow: none;
    }

    .header__snoozer-entry .header__snoozer-avatar {
      width: 3.8rem;
      height: 3.8rem;
    }

    .header__snoozer-entry .header__snoozer-text {
      font-size: 1.9rem;
    }

    .header__snoozer-entry .header__snoozer-panel {
      padding: 2rem;
    }

    .header__icons {
      grid-column: 3;
      align-self: center;
      justify-self: end;
      gap: 0;
      align-items: center;
    }

    .header__action-group {
      gap: 1.2rem;
      transform: translate(0.4rem, -5.8rem);
    }

    .header__icon--account {
      padding: 0.8rem;
    }

    .header__store-meta {
      display: grid;
      grid-template-columns: 2.2rem auto;
      align-items: center;
      gap: 1rem;
      margin-right: 0;
      padding-right: 0;
      border-right: none;
      color: #071a44;
      transform: translate(-5.8rem, -6.2rem);
    }

    .header__utility-separator {
      display: block;
      width: 0.1rem;
      height: 3.2rem;
      flex: 0 0 auto;
      margin: 0 1.2rem;
      background: #d8dee8;
      transform: translateY(-3.4rem);
    }

    .header__store-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.2rem;
      height: 2.2rem;
      color: #071a44;
    }

    .header__store-icon .svg-wrapper,
    .header__store-icon svg {
      width: 100%;
      height: 100%;
    }

    .header__store-copy {
      display: grid;
      gap: 0.15rem;
      min-width: 0;
    }

    .header__store-title,
    .header__store-text {
      display: block;
      white-space: nowrap;
      font-family: Inter, 'Helvetica Neue', Arial, sans-serif;
      color: #243247;
    }

    .header__store-title {
      font-size: 1.35rem;
      font-weight: 600;
      line-height: 1.1;
    }

    .header__store-text {
      font-size: 1.25rem;
      font-weight: 500;
      line-height: 1.1;
    }

    .header__icon--cart {
      width: 5rem;
      height: 5rem;
    }

    .header__icon--cart .svg-wrapper {
      width: 2.7rem;
      height: 2.7rem;
    }

    .header__nav-row {
      padding-top: 0;
    }

    .header__nav-row .header__inline-menu {
      width: 100%;
    }

    .header__nav-row .list-menu--inline {
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: center;
      gap: clamp(2.4rem, 2.8vw, 4.2rem);
      flex-wrap: nowrap;
    }

    .header__snoozer-row {
      display: none;
    }

    .header__mobile-nav {
      display: none;
    }
  }

  @media screen and (max-width: 989px) {
    .header--snoozer-open .header__mobile-nav {
      display: none;
    }

    .header__snoozer-panel {
      width: 100%;
      max-width: 100%;
      padding: 1.6rem;
      border-radius: 2rem;
    }

    .header__snoozer-input-wrap,
    .header__snoozer-actions {
      grid-template-columns: 1fr;
    }

    .header__snoozer-action {
      padding: 1.15rem 1.3rem;
    }
  }
</style>

{%- style -%}
  .header {
    padding: 0;
  }

  .section-header {
    margin-bottom: 0;
  }
{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

{%- assign snoozer_assessment_url = '#' -%}
{%- assign snoozer_mattresses_url = '/collections/mattresses' -%}
{%- assign snoozer_bases_url = '/collections/bases' -%}
{%- assign snoozer_booking_url = '/pages/book-a-snooze-session' -%}
{%- assign snoozer_expectations_url = '/pages/book-a-snooze-session' -%}

<div class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}">
  {%- liquid
    assign social_links = false
    assign localization_forms = false

    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
      assign social_links = true
    endif

    if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
      assign localization_forms = true
    endif

    assign show_desktop_menu = false
    if section.settings.menu != blank and section.settings.menu_type_desktop != 'drawer'
      assign show_desktop_menu = true
    endif
  -%}

  {%- capture header_logo -%}
    {%- if request.page_type == 'index' -%}
      <h1 class="header__heading">
    {%- endif -%}
      <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
        {%- if settings.logo != blank -%}
          <div class="header__heading-logo-wrapper">
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
            {% capture sizes %}(min-width: 990px) {{ settings.logo_width }}px, 140px{% endcapture %}
            {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
            {{
              settings.logo
              | image_url: width: 600
              | image_tag:
                class: 'header__heading-logo motion-reduce',
                widths: widths,
                height: logo_height,
                width: settings.logo_width,
                alt: logo_alt,
                sizes: sizes,
                preload: true
            }}
          </div>
        {%- else -%}
          <span class="h2">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    {%- if request.page_type == 'index' -%}
      </h1>
    {%- endif -%}
  {%- endcapture -%}

  {%- capture ask_snoozer_panel_inner -%}
    <div class="header__snoozer-panel-head">
      <div>
        <p class="header__snoozer-kicker">Snoozer</p>
        <p class="header__snoozer-support">Tell me what you need help with.</p>
      </div>
      <button type="button" class="header__snoozer-close large-up-hide" data-snoozer-close aria-label="Close Ask Snoozer panel">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
    <form class="header__snoozer-input-wrap" data-snoozer-form>
      <input
        type="text"
        class="header__snoozer-input"
        data-snoozer-input
        autocomplete="off"
        placeholder="Ask about comfort, cooling, or support"
        aria-label="Tell Snoozer what you need help with"
      >
      <button type="submit" class="header__snoozer-submit">Guide Me</button>
    </form>
    <div class="header__snoozer-chip-list" data-snoozer-chip-list aria-label="Suggested Snoozer prompts">
