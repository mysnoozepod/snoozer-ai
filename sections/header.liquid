      const hasCards = Array.isArray(cards) && cards.length > 0;

      if (!results) return;

      results.hidden = !hasCards;

      if (!label) return;

      const hasProductCard = hasCards && cards.some((card) => normalizeText(card && card.type).toLowerCase() === 'product');
      label.textContent = hasProductCard ? 'Good starting points' : 'Recommended next';
    }

    function renderState(shell, stateName, selectedLabel = '') {
      if (!shell) return;

      const state = getStateDefinition(stateName);
      const chipList = shell.querySelector('[data-snoozer-chip-list]');
      const actions = shell.querySelector('[data-snoozer-actions]');

      shell.dataset.snoozerState = stateName;
      setResponse(shell, state.response);
      setLastQuery(shell, '');
      setInputPlaceholder(shell, defaultInputPlaceholder);

      clearNode(chipList);
      state.chips.forEach((chip) => {
        const chipButton = createChip(chip, selectedLabel);
        if (chipButton) {
          chipList.appendChild(chipButton);
        }
      });

      clearNode(actions);
      state.cards.forEach((card) => {
        const actionCard = createAction(card);
        if (actionCard) {
          actions.appendChild(actionCard);
        }
      });
      syncResultsZone(shell, state.cards);
    }

    function renderLivePayload(shell, payload, selectedLabel = '') {
      if (!shell) return;

      const normalizedPayload = normalizeLivePayload(payload);

      const chipList = shell.querySelector('[data-snoozer-chip-list]');
      const actions = shell.querySelector('[data-snoozer-actions]');
      const cards = buildCardsFromLivePayload(normalizedPayload);

      shell.dataset.snoozerState = normalizeText(normalizedPayload.intent) || 'live';
      setResponse(shell, normalizedPayload.reply || fallbackResponse);
      setLastQuery(shell, selectedLabel);
      setInputPlaceholder(shell, followUpInputPlaceholder);

      clearNode(chipList);
      normalizedPayload.chips.forEach((chip) => {
        const chipButton = createChip(chip, selectedLabel);
        if (chipButton) {
          chipList.appendChild(chipButton);
        }
      });

      clearNode(actions);
      cards.forEach((card) => {
        const actionCard = createAction(card);
        if (actionCard) {
          actions.appendChild(actionCard);
        }
      });
      syncResultsZone(shell, cards);
    }

    function resolveStateFromQuery(query) {
      const normalized = (query || '').trim().toLowerCase();
      if (!normalized) return 'default';

      const match = keywordMatchers.find((matcher) => {
        return matcher.keywords.some((keyword) => normalized.includes(keyword));
      });

      return match ? match.state : 'fallback';
    }

    async function submitLiveQuery(shell, query) {
      if (!shell || shell.dataset.snoozerBusy === 'true') return;

      const input = shell.querySelector('[data-snoozer-input]');
      const normalizedQuery = normalizeText(query || (input && input.value));
      if (!normalizedQuery) return;

      if (input) {
        input.value = normalizedQuery;
      }

      setShellBusy(shell, true);
      setResponse(shell, loadingResponse);
      setLastQuery(shell, normalizedQuery);

      const controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
      const timeoutId = window.setTimeout(() => {
        if (controller) controller.abort();
      }, HUD_ASK_TIMEOUT_MS);

      try {
        const storedIdentity = getStoredSnoozeIdentity();
        const response = await fetch(buildApiUrl('/hud/ask'), {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            query: normalizedQuery,
            path: window.location && window.location.pathname ? window.location.pathname : '/',
            page_type: getPageType(),
            surface: 'shopify_header',
            session_id: getSessionId(),
            shopperId: storedIdentity.shopperId || undefined,
            snoozeCode: storedIdentity.snoozeCode || undefined,
            accessCode: storedIdentity.accessCode || undefined,
            sourceShopperId: storedIdentity.sourceShopperId || undefined
          }),
          signal: controller ? controller.signal : undefined
        });

        const rawPayload = await response.json().catch(() => null);
        const payload = normalizeLivePayload(rawPayload);

        if (!response.ok) {
          throw new Error('HUD_ASK_INVALID_RESPONSE');
        }

        renderLivePayload(shell, payload, normalizedQuery);
        if (input) {
          input.value = '';
        }
      } catch (error) {
        renderLivePayload(shell, buildLiveFallbackPayload(), normalizedQuery);
        if (input) {
          input.value = '';
        }
      } finally {
        window.clearTimeout(timeoutId);
        setShellBusy(shell, false);
      }
    }

    function closeShell(shell) {
      if (!shell) return;

      shell.classList.remove('is-open');

      const trigger = shell.querySelector('[data-snoozer-anchor-trigger]');
      const panel = shell.querySelector('[data-snoozer-panel]');

      if (trigger) trigger.setAttribute('aria-expanded', 'false');
      if (panel) panel.setAttribute('aria-hidden', 'true');
    }

    function closeAllShells() {
      shells.forEach((shell) => closeShell(shell));

      if (header) header.classList.remove('header--snoozer-open');
    }

    function openShell(shell) {
      if (!shell) return;

      shells.forEach((currentShell) => {
        if (currentShell !== shell) closeShell(currentShell);
      });

      shell.classList.add('is-open');

      const trigger = shell.querySelector('[data-snoozer-anchor-trigger]');
      const panel = shell.querySelector('[data-snoozer-panel]');
      if (trigger) trigger.setAttribute('aria-expanded', 'true');

      if (panel) panel.setAttribute('aria-hidden', 'false');
      if (header) header.classList.add('header--snoozer-open');
    }

    function toggleShell(shell) {
      if (!shell) return;

      if (shell.classList.contains('is-open')) {
        closeAllShells();
        return;
      }

      openShell(shell);
    }

    function getVisibleShell() {
      return shells.find((shell) => shell.offsetParent !== null) || shells[0] || null;
    }

    function openVisibleShell(source) {
      const visibleShell = getVisibleShell();
      if (!visibleShell) return;

      openShell(visibleShell);
    }

    async function submitSnoozeCodeCheckIn(form) {
      if (!form || form.dataset.busy === 'true') return;

      const input = form.querySelector('[data-snooze-checkin-input]');
      const submit = form.querySelector('[data-snooze-checkin-submit]');
      const rawCode = normalizeText(input && input.value);

      if (!rawCode) {
        setCheckInStatus(form, 'Enter your Snooze Code', true);
        if (input) input.focus();
        return;
      }

      const storedIdentity = getStoredSnoozeIdentity();
      const sessionId = getSessionId();
      form.dataset.busy = 'true';
      setCheckInStatus(form, 'Checking in to your Snooze Profile...', false);

      if (input) input.disabled = true;
      if (submit) submit.disabled = true;

      try {
        const response = await fetch(buildApiUrl('/identity/check-in'), {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            snoozeCode: rawCode,
            accessCode: rawCode,
            shopperId: storedIdentity.shopperId || undefined,
            sourceSurface: 'shopify_header_checkin',
            sessionId: sessionId,
            threadId: sessionId
          })
        });

        const normalizedPayload = normalizeCheckInPayload(
          await response.json().catch(() => null)
        );

        if (!response.ok || !normalizedPayload.ok || !normalizedPayload.snoozeCode) {
          setCheckInStatus(
            form,
            normalizedPayload.code === 'SNOOZE_CODE_NOT_FOUND'
              ? 'Code not found'
              : 'Code not found',
            true
          );
          return;
        }

        persistStoredSnoozeIdentity(normalizedPayload);
        syncCheckInForms(normalizedPayload);
        setCheckInStatus(form, 'Snooze Profile unlocked', false);
      } catch (error) {
        setCheckInStatus(form, 'Code not found', true);
      } finally {
        form.dataset.busy = 'false';
        if (input) input.disabled = false;
        if (submit) submit.disabled = false;
      }
    }

    window.MySnoozePod = window.MySnoozePod || {};
    window.MySnoozePod.openSnoozer = openVisibleShell;

    document.addEventListener('pointerdown', () => {
      lastPointerOpen = Date.now();
    });

    document.addEventListener('click', (event) => {
      const trigger = event.target.closest('[data-snoozer-trigger]');
      const closeButton = event.target.closest('[data-snoozer-close]');
      const placeholderLink = event.target.closest('[data-snoozer-placeholder-link]');
      const chipValueTrigger = event.target.closest('[data-snoozer-chip-value]');

      if (placeholderLink) {
        event.preventDefault();
      }

      if (closeButton) {
        event.preventDefault();
        closeAllShells();
        return;
      }

      if (chipValueTrigger) {
        const stateShell = chipValueTrigger.closest('[data-snoozer-shell]');
        if (!stateShell) return;

        event.preventDefault();
        submitLiveQuery(
          stateShell,
          chipValueTrigger.getAttribute('data-snoozer-chip-value')
        );
        return;
      }

      if (trigger) {
        const triggerShell = trigger.closest('[data-snoozer-shell]');
        event.preventDefault();

        if (trigger.hasAttribute('data-snoozer-anchor-trigger') && triggerShell) {
          toggleShell(triggerShell);
          return;
        }

        openVisibleShell(trigger.getAttribute('data-snoozer-source'));
        return;
      }

      if (!event.target.closest('[data-snoozer-shell]')) {
        closeAllShells();
      }
    });

    document.addEventListener('focusin', (event) => {
      const trigger = event.target.closest('[data-snoozer-anchor-trigger]');
      if (!trigger) return;
      if (Date.now() - lastPointerOpen < 250) return;

      const triggerShell = trigger.closest('[data-snoozer-shell]');
      openShell(triggerShell);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      closeAllShells();
    });

    shells.forEach((shell) => {
      const form = shell.querySelector('[data-snoozer-form]');
      const input = shell.querySelector('[data-snoozer-input]');
      renderState(shell, 'default');

      if (!form || !input) return;

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        submitLiveQuery(shell, input.value);
      });
    });

    document.querySelectorAll('[data-snooze-checkin-form]').forEach((form) => {
      syncCheckInForms(getStoredSnoozeIdentity());
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        submitSnoozeCodeCheckIn(form);
      });
    });
  })();
</script>

