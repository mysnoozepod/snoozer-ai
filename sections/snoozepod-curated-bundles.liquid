{{ 'snoozepod-curated-bundles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'snoozepod-pod-builder.js' | asset_url }}" defer></script>
<script src="{{ 'snoozepod-curated-bundle-catalog.js' | asset_url }}" defer></script>
<script src="{{ 'snoozepod-curated-bundles.js' | asset_url }}" defer></script>

<section class="snoozepod-bundles" data-curated-bundles>
  <div class="snoozepod-bundles__shell">
    <header class="snoozepod-bundles__hero">
      <div>
        <h1>{{ page.title | default: 'Sleep Systems' | escape }}</h1>
        <p class="snoozepod-bundles__lede">Choose how you want your bed to move, then explore only the mattresses, sizes, and adjustable bases that belong together.</p>
      </div>
    </header>

    <div class="snoozepod-bundles__group" id="sleep-systems">
      <div class="snoozepod-bundles__group-heading">
        <p class="snoozepod-bundles__eyebrow">Mattress + adjustable base</p>
        <h2>How should your bed work?</h2>
        <p>Start with the system geometry. We will keep the remaining choices compatible.</p>
      </div>

      <div class="snoozepod-system-paths" aria-label="Choose a sleep-system type">
        <button class="snoozepod-system-path" type="button" data-system-path="standard" aria-pressed="false">
          <span class="snoozepod-system-path__kicker">Standard</span>
          <strong>One mattress. One base.</strong>
          <span>A familiar sleep surface with adjustable positioning.</span>
        </button>
        <button class="snoozepod-system-path snoozepod-system-path--featured" type="button" data-system-path="split_head" aria-pressed="true">
          <span class="snoozepod-system-path__kicker">Featured in Pods 2 &amp; 3</span>
          <strong>Split-Head Sleep System</strong>
          <span>A shared mattress with independent head positioning on Flex SH.</span>
        </button>
        <button class="snoozepod-system-path" type="button" data-system-path="full_split" aria-pressed="false">
          <span class="snoozepod-system-path__kicker">Fully independent</span>
          <strong>Split King Sleep System</strong>
          <span>Two Twin XL mattresses and two Twin XL adjustable bases.</span>
        </button>
      </div>

      <div class="snoozepod-bundles__selection-heading" aria-live="polite">
        <p class="snoozepod-bundles__eyebrow" data-system-path-kicker>Signature system</p>
        <h2 data-system-path-heading tabindex="-1">Split-Head Sleep Systems</h2>
        <p data-system-path-copy>Choose a split-head mattress size. The compatible Flex SH base is selected with it.</p>
      </div>
      <div class="snoozepod-bundles__grid" data-bundle-grid="SLEEP_SYSTEM"></div>
    </div>

    <div class="snoozepod-bundles__status" data-bundle-cart-status role="status" aria-live="assertive" aria-atomic="true" tabindex="-1" hidden></div>
  </div>
</section>

{% schema %}
{
  "name": "Curated sleep systems",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [{ "name": "Curated sleep systems" }]
}
{% endschema %}
