{{ 'snoozepod-curated-bundles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'snoozepod-pod-builder.js' | asset_url }}" defer></script>
<script src="{{ 'snoozepod-curated-bundle-catalog.js' | asset_url }}" defer></script>
<script src="{{ 'snoozepod-curated-bundles.js' | asset_url }}" defer></script>

<section class="snoozepod-bundles" data-curated-bundles>
  <div class="snoozepod-bundles__shell">
    <header class="snoozepod-bundles__hero">
      <div>
        <p class="snoozepod-bundles__eyebrow">Curated shopping</p>
        <h1>{{ page.title | default: 'Sleep Systems' | escape }}</h1>
        <p class="snoozepod-bundles__lede">Start with real products that work together by size and purpose. Every purchasable set keeps its individual Shopify variants, prices, and cart lines.</p>
      </div>
      <aside class="snoozepod-bundles__assurance">
        <strong>Compatibility stays fail-closed.</strong>
        <p>Mattress and adjustable-base combinations remain review-only until their exact mechanical compatibility is verified.</p>
      </aside>
    </header>

    <div class="snoozepod-bundles__filter">
      <label for="CuratedBundleSize-{{ section.id }}">Shop these sets by size</label>
      <select id="CuratedBundleSize-{{ section.id }}" data-bundle-size-filter>
        <option value="">All available sizes</option>
      </select>
      <p data-bundle-filter-count aria-live="polite"></p>
    </div>

    <nav class="snoozepod-bundles__jump" aria-label="Sleep system categories">
      <a href="#sleep-systems">Sleep Systems</a>
      <a href="#bedding-sets">Bedding Sets</a>
      <a href="#complete-sleep-packages">Complete Sleep Packages</a>
    </nav>

    <div class="snoozepod-bundles__group" id="sleep-systems">
      <div class="snoozepod-bundles__group-heading">
        <p class="snoozepod-bundles__eyebrow">Mattress + adjustable base</p>
        <h2>Sleep Systems</h2>
        <p>These exact-size candidates are organized for review. Purchasing remains unavailable until the mattress-to-base relationship is verified.</p>
      </div>
      <div class="snoozepod-bundles__grid" data-bundle-grid="SLEEP_SYSTEM"></div>
    </div>

    <div class="snoozepod-bundles__group" id="bedding-sets">
      <div class="snoozepod-bundles__group-heading">
        <p class="snoozepod-bundles__eyebrow">Exact component variants</p>
        <h2>Bedding Sets</h2>
        <p>Choose the size and available product options. Each component is checked against live Shopify product data before it is added.</p>
      </div>
      <div class="snoozepod-bundles__grid" data-bundle-grid="BEDDING_SET"></div>
    </div>

    <div class="snoozepod-bundles__group" id="complete-sleep-packages">
      <div class="snoozepod-bundles__group-heading">
        <p class="snoozepod-bundles__eyebrow">Whole-room starting points</p>
        <h2>Complete Sleep Packages</h2>
        <p>Complete packages are staged for assortment review and remain unavailable until their mattress and base pairings are confirmed.</p>
      </div>
      <div class="snoozepod-bundles__grid" data-bundle-grid="COMPLETE_SLEEP_PACKAGE"></div>
    </div>

    <div class="snoozepod-bundles__empty" data-bundle-empty hidden>No curated sets are available for that size. Try another size or view all sets.</div>
    <div class="snoozepod-bundles__status" data-bundle-cart-status role="status" aria-live="assertive" aria-atomic="true" tabindex="-1" hidden></div>

    <div class="snoozepod-bundles__secondary">
      <div><p class="snoozepod-bundles__eyebrow">Need a hand?</p><h2>Talk through the complete setup.</h2></div>
      <div class="snoozepod-bundles__actions">
        <button class="button button--secondary" type="button" data-snoozer-trigger>Ask Snoozer</button>
        <a class="button button--secondary" href="/pages/book-a-snooze-session">Book a Snooze Session</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Curated sleep systems",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [{ "name": "Curated sleep systems" }]
}
{% endschema %}
