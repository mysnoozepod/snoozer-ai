{%- style -%}
  .snooze-showroom-{{ section.id }} {
    padding-top: 3.2rem;
    padding-bottom: 3.2rem;
  }

  .snooze-showroom-{{ section.id }} .snooze-showroom__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .snooze-showroom-{{ section.id }} .snooze-showroom__content,
  .snooze-showroom-{{ section.id }} .snooze-showroom__media-wrap {
    min-width: 0;
  }

  .snooze-showroom-{{ section.id }} .snooze-showroom__content {
    max-width: 52rem;
  }

  .snooze-showroom-{{ section.id }} .snooze-showroom__heading {
    margin: 0;
  }

  .snooze-showroom-{{ section.id }} .snooze-showroom__body {
    margin: 1.4rem 0 0;
    color: rgba(var(--color-foreground), 0.75);
  }

  .snooze-showroom-{{ section.id }} .snooze-showroom__cta {
    margin-top: 2rem;
  }

  .snooze-showroom-{{ section.id }} .snooze-showroom__media {
    overflow: hidden;
    border-radius: 1.6rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.08);
    background: rgba(var(--color-foreground), 0.03);
    aspect-ratio: 1 / 1;
  }

  .snooze-showroom-{{ section.id }} .snooze-showroom__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media screen and (min-width: 750px) {
    .snooze-showroom-{{ section.id }} {
      padding-top: 4.8rem;
      padding-bottom: 4.8rem;
    }
  }

  @media screen and (min-width: 990px) {
    .snooze-showroom-{{ section.id }} .snooze-showroom__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }

    .snooze-showroom-{{ section.id }} .snooze-showroom__grid--image-left .snooze-showroom__media-wrap {
      order: -1;
    }
  }
{%- endstyle -%}

<section class="snooze-showroom snooze-showroom-{{ section.id }}">
  <div class="page-width">
    <div class="snooze-showroom__grid snooze-showroom__grid--image-{{ section.settings.image_position }}">
      <div class="snooze-showroom__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="snooze-showroom__heading h2">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="snooze-showroom__body rte">
            <p>{{ section.settings.body | escape | newline_to_br }}</p>
          </div>
        {%- endif -%}

        {%- if section.settings.cta_label != blank -%}
          <div class="snooze-showroom__cta">
            <a
              {% if section.settings.cta_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.cta_link }}"
              {% endif %}
              class="button button--primary"
            >
              {{ section.settings.cta_label | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank -%}
        <div class="snooze-showroom__media-wrap">
          <div class="snooze-showroom__media">
            {{
              section.settings.image
              | image_url: width: 2400
              | image_tag:
                widths: '480, 720, 960, 1200, 1600, 2000, 2400',
                sizes: '(min-width: 990px) 50vw, 100vw',
                class: 'snooze-showroom__image',
                loading: 'lazy',
                alt: section.settings.image.alt | default: 'Online sleep assessment connected to in-store mattress testing' | escape
            }}
          </div>
        </div>
      {%- else -%}
        <div class="snooze-showroom__media-wrap">
          <div
            class="snooze-showroom__media"
            role="img"
            aria-label="Online sleep assessment connected to in-store mattress testing"
          ></div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Snooze showroom",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Section heading"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Short supporting text."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Snooze showroom"
    }
  ]
}
{% endschema %}
