{{ 'component-snoozepod-commerce-v1.css' | asset_url | stylesheet_tag }}

{%- if product.tags contains 'feature:dual-comfort' -%}
  <script src="{{ 'snoozepod-dual-comfort.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign is_dual_comfort = false
  if product.tags contains 'feature:dual-comfort'
    assign is_dual_comfort = true
  endif
  assign parent_collection_handle = ''
  case product.type
    when 'Mattress'
      assign parent_collection_handle = 'mattresses'
    when 'Adjustable Base'
      assign parent_collection_handle = 'adjustable-bases'
    when 'Pillow'
      assign parent_collection_handle = 'pillows'
    when 'Sheet Set'
      assign parent_collection_handle = 'sheets'
    when 'Mattress Protector'
      assign parent_collection_handle = 'mattress-protectors'
    when 'Comforter'
      assign parent_collection_handle = 'comforters'
    when 'Duvet Set', 'Throw'
      assign parent_collection_handle = 'cooling-bedding'
    when 'Mattress Topper'
      assign parent_collection_handle = 'mattress-toppers'
    when 'Headboard', 'Platform Base'
      assign parent_collection_handle = 'bedroom-furniture'
  endcase
  assign parent_collection = collections[parent_collection_handle]
  assign standalone_variant = product.selected_or_first_available_variant
  if product.type == 'Mattress' and standalone_variant.title contains 'Split'
    for candidate_variant in product.variants
      unless candidate_variant.title contains 'Split'
        if candidate_variant.available
          assign standalone_variant = candidate_variant
          break
        endif
      endunless
    endfor
  endif
-%}

<product-info
  id="MainProduct-{{ section.id }}"
  class="snoozepod-product-hero-section color-{{ section.settings.color_scheme }} gradient{% if is_dual_comfort %} snoozepod-product--dual-comfort{% endif %}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle | escape }}"
  data-product-type="{{ product.type | escape }}"
  data-product-type-handle="{{ product.type | handleize }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-{{ section.id }}" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle-{{ section.id }}"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride-{{ section.id }}"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {%- assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' -%}
  {%- assign product_form_id = 'product-form-' | append: section.id -%}

  {%- style -%}
    .snoozepod-product-hero-{{ section.id }} {
      max-width: 1480px;
      margin: 20px 16px;
    }

    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
      align-items: start;
    }

    .snoozepod-product-hero-{{ section.id }} .snoozepod-breadcrumbs {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      grid-column: 1 / -1;
      margin: 0;
      color: rgba(7, 25, 66, 0.66);
      font-size: 12px;
      line-height: 1.4;
    }

    .snoozepod-product-hero-{{ section.id }} .snoozepod-breadcrumbs a {
      color: inherit;
      text-underline-offset: 2px;
    }

    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__grid > *,
    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__media-wrapper,
    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__info-wrapper {
      min-width: 0;
    }

    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__media-card,
    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__fallback,
    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__info-card {
      border-radius: 24px;
      overflow: hidden;
    }

    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__media-card,
    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__info-card {
      border: 1px solid rgba(7, 25, 66, 0.10);
      background: #ffffff;
      box-shadow: 0 20px 50px rgba(7, 25, 66, 0.06);
    }

    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__fallback {
      display: flex;
      align-items: flex-end;
      min-height: 260px;
      padding: 24px;
      background:
        radial-gradient(circle at top right, rgba(44, 66, 120, 0.16), transparent 36%),
        linear-gradient(180deg, #f5f7fb 0%, #edf2f9 100%);
      color: rgba(7, 25, 66, 0.76);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.04em;
    }

    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__info-card {
      padding: 24px;
    }

    .snoozepod-product-hero-{{ section.id }} .product__title {
      margin: 0;
    }

    .snoozepod-product-hero-{{ section.id }} .product__title h1 {
      margin: 0;
      overflow-wrap: anywhere;
      color: #071942;
      font-size: 32px;
      line-height: 1.05;
      letter-spacing: -0.04em;
    }

    .snoozepod-product-hero-{{ section.id }} .product__text {
      margin: 0 0 12px;
      color: rgba(7, 25, 66, 0.68);
      font-size: 13px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .snoozepod-product-hero-{{ section.id }} [id^='price-'] {
      margin-top: 16px;
    }

    .snoozepod-product-hero-{{ section.id }} .price {
      color: #071942;
    }

    @media screen and (max-width: 749px) {
      .snoozepod-product-hero-{{ section.id }} {
        margin: 12px 12px 18px;
      }

      .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__grid {
        gap: 16px;
      }

      .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__media-card,
      .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__info-card {
        border-radius: 18px;
      }

      .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__info-card {
        padding: 20px 16px;
      }

      .snoozepod-product-hero-{{ section.id }} .product__title h1 {
        font-size: clamp(28px, 8vw, 34px);
      }

      .snoozepod-product-hero-{{ section.id }} .product__media-list {
        margin: 0;
        width: 100%;
        scroll-snap-type: inline mandatory;
      }

      .snoozepod-product-hero-{{ section.id }} .product__media-list .product__media-item {
        width: 100%;
        min-width: 100%;
        padding-left: 0;
        scroll-snap-align: start;
      }

      .snoozepod-product-hero-{{ section.id }} .product__media-wrapper slider-component:not(.thumbnail-slider--no-slide) {
        margin-right: 0;
        margin-left: 0;
      }

      .snoozepod-product-hero-{{ section.id }} .thumbnail-slider {
        padding: 0 8px 8px;
      }
    }

    .snoozepod-product-hero-{{ section.id }} .price--large .price-item,
    .snoozepod-product-hero-{{ section.id }} .price__regular .price-item--regular,
    .snoozepod-product-hero-{{ section.id }} .price__sale .price-item--sale {
      font-size: 22px;
      line-height: 1.2;
    }

    .snoozepod-product-hero-{{ section.id }} variant-selects,
    .snoozepod-product-hero-{{ section.id }} .product-form__input {
      display: block;
      margin-top: 20px;
    }

    .snoozepod-product-hero-{{ section.id }} .product-form__input--pill input[type='radio'] + label,
    .snoozepod-product-hero-{{ section.id }} .product-form__input--swatch input[type='radio'] + label {
      border-color: rgba(7, 25, 66, 0.24);
      border-radius: 999px;
      background: #e9eff8;
      color: #071942;
      font-weight: 700;
    }

    .snoozepod-product-hero-{{ section.id }} .product-form__input--pill input[type='radio']:checked + label {
      border-color: #071942;
      background: #071942;
      color: #ffffff;
      box-shadow: 0 0 0 3px rgba(44, 66, 120, 0.14);
    }

    .snoozepod-product-hero-{{ section.id }} .product-form__buttons {
      margin-top: 12px;
    }

    .snoozepod-product-hero-{{ section.id }} .product-form__submit,
    .snoozepod-product-hero-{{ section.id }} .shopify-payment-button__button,
    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__action {
      min-height: 56px;
      border-radius: 999px;
    }

    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      margin-top: 12px;
      padding: 0 24px;
      border: 1px solid #071942;
      font-size: 16px;
      font-weight: 700;
      line-height: 1.2;
      text-align: center;
      text-decoration: none;
      cursor: pointer;
    }

    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__action--primary {
      background: #071942;
      color: #ffffff;
    }

    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__action--secondary {
      background: #ffffff;
      color: #071942;
    }

    .snoozepod-product-hero-{{ section.id }} .product-form__submit {
      border: 1px solid #071942;
      background: #071942;
      color: #ffffff;
      font-size: 17px;
      font-weight: 800;
    }

    .snoozepod-product-hero-{{ section.id }} .product-form__submit:after {
      box-shadow: none;
    }

    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__action:hover,
    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__action:focus-visible,
    .snoozepod-product-hero-{{ section.id }} .product-form__submit:hover,
    .snoozepod-product-hero-{{ section.id }} .product-form__submit:focus-visible {
      background: #2c4278;
      color: #ffffff;
    }

    .snoozepod-product-hero-{{ section.id }} .product-form__submit[disabled],
    .snoozepod-product-hero-{{ section.id }} .product-form__submit[aria-disabled='true'] {
      border-color: rgba(7, 25, 66, 0.14);
      background: #dce3ed;
      color: rgba(7, 25, 66, 0.66);
      opacity: 1;
      cursor: not-allowed;
    }

    .snoozepod-product-hero-{{ section.id }} .product__description {
      margin-top: 24px;
      color: rgba(7, 25, 66, 0.8);
      font-size: 16px;
      line-height: 1.55;
    }

    .snoozepod-product-hero-{{ section.id }} .product__description > *:first-child {
      margin-top: 0;
    }

    .snoozepod-product-hero-{{ section.id }} .product__description > *:last-child {
      margin-bottom: 0;
    }

    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__system-note {
      margin: 1rem 0 0;
      color: rgba(7, 25, 66, 0.72);
      font-size: 1.3rem;
      line-height: 1.45;
    }

    .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__system-note a {
      color: #071942;
      font-weight: 750;
      text-underline-offset: 0.25rem;
    }

    @media screen and (min-width: 750px) {
      .snoozepod-product-hero-{{ section.id }} {
        margin-left: 24px;
        margin-right: 24px;
      }

      .snoozepod-product-hero-{{ section.id }} .product__title h1 {
        font-size: 40px;
      }
    }

    @media screen and (min-width: 990px) {
      .snoozepod-product-hero-{{ section.id }} {
        margin: 32px auto 40px;
        padding: 0 32px;
      }

      .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__grid {
        grid-template-columns: minmax(0, 58fr) minmax(0, 42fr);
        gap: 48px;
      }

      .snoozepod-product--dual-comfort .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__grid {
        grid-template-columns: minmax(0, 52fr) minmax(0, 48fr);
        gap: 36px;
      }

      .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__media-card,
      .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__info-card {
        border-radius: 32px;
      }

      .snoozepod-product-hero-{{ section.id }} .snoozepod-product-hero__info-card {
        padding: 40px;
      }

      .snoozepod-product-hero-{{ section.id }} .product__title h1 {
        max-width: 12ch;
        font-size: 48px;
        line-height: 1.02;
      }

      .snoozepod-product-hero-{{ section.id }} .product__description {
        font-size: 17px;
      }
    }
  {%- endstyle -%}

  <section class="section">
    <div class="snoozepod-product-hero-{{ section.id }}">
      <div class="snoozepod-product-hero__grid">
        <nav class="snoozepod-breadcrumbs" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          {%- if parent_collection != blank -%}
            <span aria-hidden="true">/</span>
            <a href="{{ parent_collection.url }}">{{ parent_collection.title | escape }}</a>
          {%- endif -%}
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ product.title | escape }}</span>
        </nav>
        <div class="snoozepod-product-hero__media-wrapper">
          {%- if product.media.size > 0 -%}
            <div class="snoozepod-product-hero__media-card product product--{{ section.settings.media_size }} product--{{ section.settings.gallery_layout }} product__media-wrapper">
              {% render 'product-media-gallery', variant_images: variant_images %}
            </div>
          {%- else -%}
            <div class="snoozepod-product-hero__fallback">
              <span>{{ product.title | escape }}</span>
            </div>
          {%- endif -%}
        </div>

        <div class="snoozepod-product-hero__info-wrapper">
          <section
            id="ProductInfo-{{ section.id }}"
            class="snoozepod-product-hero__info-card{% if section.settings.enable_sticky_info and is_dual_comfort == false %} product__column-sticky{% endif %}"
          >
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  {% render block %}
                {%- when 'text' -%}
                  {%- liquid
                    assign hide_mattress_vendor = false
                    if product.tags contains 'type:mattress'
                      assign hide_mattress_vendor = true
                    endif
                  -%}
                  {%- if block.settings.text != blank and hide_mattress_vendor == false -%}
                    <p
                      class="product__text inline-richtext{% if block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if block.settings.text_style == 'body' %} text-body{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.text }}
                    </p>
                  {%- endif -%}
                {%- when 'title' -%}
                  <div class="product__title" {{ block.shopify_attributes }}>
                    <h1>{{ product.title | escape }}</h1>
                  </div>
                {%- when 'price' -%}
                  <div id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                    {%- render 'price',
                      product: product,
                      use_variant: true,
                      show_badges: true,
                      price_class: 'price--large'
                    -%}
                  </div>
                {%- when 'variant_picker' -%}
                  {% render 'product-variant-picker',
                    product: product,
                    block: block,
                    product_form_id: product_form_id,
                    exclude_system_mattress_sizes: true,
                    selected_variant_override: standalone_variant
                  %}
                  {%- if product.type == 'Mattress' -%}
                    <p class="snoozepod-product-hero__system-note">
                      Split-head and Split King configurations are available through
                      <a href="/pages/sleep-systems">Sleep Systems</a> so the mattress and adjustable base stay compatible.
                    </p>
                  {%- endif -%}
                {%- when 'product_feel' -%}
                  <div {{ block.shopify_attributes }}>
                    {% render 'snoozepod-product-feel',
                      feel_product: product,
                      show_editor_placeholder: block.settings.show_editor_placeholder
                    %}
                  </div>
                {%- when 'session_cta' -%}
                  <a
                    class="snoozepod-product-hero__action snoozepod-product-hero__action--secondary"
                    href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}/pages/book-a-snooze-session{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.label | escape }}
                  </a>
                {%- when 'buy_buttons' -%}
                  {%- if product.tags contains 'feature:dual-comfort' -%}
                    <div
                      class="snoozepod-dual-comfort"
                      data-dual-comfort
                      data-product-form="{{ product_form_id }}"
                      data-comfort-policy="all-pairs"
                      data-orderable="false"
                    >
                      <div class="snoozepod-dual-comfort__intro">
                        <h2>Dual Comfort</h2>
                        <p>Choose each sleeper's preferred comfort independently. Every left and right pairing is available for each orderable size.</p>
                      </div>
                      <div class="snoozepod-dual-comfort__groups">
                        {%- for side in (1..2) -%}
                          {%- if side == 1 -%}
                            {%- assign side_key = 'left' -%}
                            {%- assign side_label = 'Left Side Comfort' -%}
                          {%- else -%}
                            {%- assign side_key = 'right' -%}
                            {%- assign side_label = 'Right Side Comfort' -%}
                          {%- endif -%}
                          <fieldset class="snoozepod-dual-comfort__group">
                            <legend>{{ side_label }}</legend>
                            <div class="snoozepod-dual-comfort__choices">
                              {%- assign comfort_options = 'Soft|Medium Soft|Medium Firm|Firm' | split: '|' -%}
                              {%- for comfort_value in comfort_options -%}
                                <input
                                  type="radio"
                                  id="DualComfort-{{ section.id }}-{{ side_key }}-{{ forloop.index0 }}"
                                  name="dual-comfort-{{ section.id }}-{{ side_key }}"
                                  value="{{ comfort_value }}"
                                >
                                <label for="DualComfort-{{ section.id }}-{{ side_key }}-{{ forloop.index0 }}">{{ comfort_value }}</label>
                              {%- endfor -%}
                            </div>
                          </fieldset>
                        {%- endfor -%}
                      </div>
                      <input
                        type="hidden"
                        name="properties[Left Side Comfort]"
                        value=""
                        form="{{ product_form_id }}"
                        data-dual-comfort-property="left"
                      >
                      <input
                        type="hidden"
                        name="properties[Right Side Comfort]"
                        value=""
                        form="{{ product_form_id }}"
                        data-dual-comfort-property="right"
                      >
                      <p class="snoozepod-dual-comfort__summary" data-dual-comfort-summary>
                        Select a comfort level for both sides to continue.
                      </p>
                      <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-dual-comfort-status></p>
                      <script type="application/json" data-dual-comfort-mappings>
                        [
                          {%- assign rendered_mapping_count = 0 -%}
                          {%- for variant in product.variants -%}
                            {%- unless variant.title contains 'Split' -%}
                            {%- if rendered_mapping_count > 0 -%},{%- endif -%}
                            {
                              "variantId": {{ variant.id | json }},
                              "size": {{ variant.option1 | json }},
                              "acceptsAnyComfortPair": true,
                              "available": {{ variant.available | json }}
                            }
                            {%- assign rendered_mapping_count = rendered_mapping_count | plus: 1 -%}
                            {%- endunless -%}
                          {%- endfor -%}
                        ]
                      </script>
                    </div>
                  {%- endif -%}
                  {%- render 'buy-buttons',
                    block: block,
                    product: product,
                    product_form_id: product_form_id,
                    section_id: section.id,
                    show_pickup_availability: false,
                    selected_variant_override: standalone_variant
                  -%}
                {%- when 'snoozer_cta' -%}
                  <button
                    type="button"
                    class="snoozepod-product-hero__action snoozepod-product-hero__action--secondary"
                    data-snoozer-trigger
                    data-snoozer-source="product-v1"
                    data-snoozer-product-id="{{ product.id }}"
                    data-snoozer-product-handle="{{ product.handle | escape }}"
                    data-snoozer-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    data-snoozer-product-type="{{ product.type | escape }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.label | escape }}
                  </button>
                {%- when 'showroom_location' -%}
                  <div {{ block.shopify_attributes }}>
                    {% render 'snoozepod-showroom-location',
                      showroom_product: product,
                      show_editor_placeholder: block.settings.show_editor_placeholder
                    %}
                  </div>
                {%- when 'description' -%}
                  {%- if product.description != blank -%}
                    <div class="product__description rte" {{ block.shopify_attributes }}>
                      {{ product.description }}
                    </div>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </section>
        </div>
      </div>

      {%- if product.media.size > 0 -%}
        {% render 'product-media-modal', variant_images: variant_images %}
        <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
        <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
      {%- endif -%}

      {%- if first_3d_model -%}
        <script type="application/json" id="ProductJSON-{{ product.id }}">
          {{ product.media | where: 'media_type', 'model' | json }}
        </script>
        <script src="{{ 'product-model.js' | asset_url }}" defer="defer"></script>
      {%- endif -%}

      <script type="application/ld+json">
        {{ product | structured_data }}
      </script>
    </div>
  </section>
</product-info>

