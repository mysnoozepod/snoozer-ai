{%- liquid
  assign tags_downcase = product.tags | join: ',' | downcase
  assign title_downcase = product.title | downcase
  assign type_downcase = product.type | downcase
  assign comfort_feel = 'Balanced comfort feel'
  assign support = 'Best confirmed in showroom'
  assign best_for = 'Sleepers narrowing a full-room setup'
  assign pressure_relief = 'Balanced pressure relief'
  assign motion_setup = 'Compatible with selected base setup'
  assign partner_fit = 'Best confirmed by selected size and motion choice'
  assign showroom_test = 'Compare feel and support in person'

  if tags_downcase contains 'type:hybrid' or type_downcase contains 'hybrid' or title_downcase contains 'hybrid'
    assign comfort_feel = 'Hybrid feel with more lift'
    assign support = 'Coil-backed support with more pushback'
    assign best_for = 'Sleepers wanting more lift and recovery'
    assign pressure_relief = 'Balanced cushioning with stronger support'
    assign showroom_test = 'Best confirmed against the all-foam options'
  elsif tags_downcase contains 'type:foam' or type_downcase contains 'foam' or title_downcase contains 'foam'
    assign comfort_feel = 'Foam contour feel'
    assign support = 'Contour-first support'
    assign best_for = 'Sleepers wanting a simpler contouring setup'
    assign pressure_relief = 'Foam cushioning with quieter surface feel'
    assign showroom_test = 'Best confirmed against the hybrid lineup'
  endif

  case product.handle
    when '12-dual-comfort-hybrid'
      assign comfort_feel = 'Hybrid comfort with split-feel flexibility'
      assign support = 'Lift plus partner-specific comfort direction'
      assign best_for = 'Couples, split-feel needs, and adjustable-base setups'
      assign pressure_relief = 'Balanced cushioning with stronger support than all-foam'
      assign motion_setup = 'Pairs well with Standard, Half Split, or Full Split by size'
      assign partner_fit = 'Best match when partners want different comfort direction'
      assign showroom_test = 'Best confirmed side by side with your partner'
    when '14-hybrid'
      assign comfort_feel = 'Most supportive hybrid feel'
      assign support = 'Strongest lift and alignment direction in the lineup'
      assign best_for = 'Back sleepers, larger builds, and shoppers wanting more pushback'
      assign pressure_relief = 'Balanced relief with a firmer support curve'
      assign motion_setup = 'Compatible with selected base setup'
      assign partner_fit = 'Best confirmed by selected size and motion choice'
      assign showroom_test = 'Compare against the 12" hybrid if you want less lift'
    when '12-all-foam-mattress'
      assign comfort_feel = 'Deeper foam contour'
      assign support = 'Contour support with more comfort depth than 10"'
      assign best_for = 'Pressure-relief focused setups and side-sleeper comfort'
      assign pressure_relief = 'Higher foam cushioning than lower-profile builds'
      assign motion_setup = 'Compatible with selected base setup'
      assign partner_fit = 'Stronger when motion control matters'
      assign showroom_test = 'Compare against the 10" foam and 12" dual comfort hybrid'
    when '10-all-foam-mattress'
      assign comfort_feel = 'Simpler foam feel'
      assign support = 'Basic contour support'
      assign best_for = 'Value setups, guest rooms, kids, lighter builds'
      assign pressure_relief = 'Moderate foam cushioning'
      assign motion_setup = 'Compatible with selected base setup'
      assign partner_fit = 'Best confirmed by selected size and motion choice'
      assign showroom_test = 'Compare against hybrid if you need more lift/support'
  endcase

  assign compare_handle_1 = blank
  assign compare_copy_1 = blank
  assign compare_handle_2 = blank
  assign compare_copy_2 = blank
  assign compare_handle_3 = blank
  assign compare_copy_3 = blank

  case product.handle
    when '10-all-foam-mattress'
      assign compare_handle_1 = '12-all-foam-mattress'
      assign compare_copy_1 = 'A softer comparison.'
      assign compare_handle_2 = '14-hybrid'
      assign compare_copy_2 = 'A stronger support comparison.'
      assign compare_handle_3 = '12-dual-comfort-hybrid'
      assign compare_copy_3 = 'A more premium comparison.'
    when '12-all-foam-mattress'
      assign compare_handle_1 = '10-all-foam-mattress'
      assign compare_copy_1 = 'A lower-profile option.'
      assign compare_handle_2 = '14-hybrid'
      assign compare_copy_2 = 'A stronger support comparison.'
      assign compare_handle_3 = '12-dual-comfort-hybrid'
      assign compare_copy_3 = 'A more premium comparison.'
    when '12-dual-comfort-hybrid'
      assign compare_handle_1 = '14-hybrid'
      assign compare_copy_1 = 'A stronger support comparison.'
      assign compare_handle_2 = '12-all-foam-mattress'
      assign compare_copy_2 = 'Another SnoozePod option to compare.'
      assign compare_handle_3 = '10-all-foam-mattress'
      assign compare_copy_3 = 'A lower-profile option.'
    when '14-hybrid'
      assign compare_handle_1 = '12-dual-comfort-hybrid'
      assign compare_copy_1 = 'Another SnoozePod option to compare.'
      assign compare_handle_2 = '12-all-foam-mattress'
      assign compare_copy_2 = 'A softer comparison.'
      assign compare_handle_3 = '10-all-foam-mattress'
      assign compare_copy_3 = 'A lower-profile option.'
  endcase

  assign compare_product_1 = all_products[compare_handle_1]
  assign compare_product_2 = all_products[compare_handle_2]
  assign compare_product_3 = all_products[compare_handle_3]
-%}

{%- style -%}
  .snoozepod-sleep-facts-{{ section.id }} {
    max-width: 1380px;
    margin: 20px 16px 32px;
    display: grid;
    gap: 18px;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__card {
    max-width: 840px;
    border-radius: 22px;
    border: 1px solid rgba(7, 25, 66, 0.10);
    background: #ffffff;
    box-shadow: 0 18px 44px rgba(7, 25, 66, 0.06);
    overflow: hidden;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__label-head {
    padding: 18px 22px 14px;
    background: #071942;
    color: #ffffff;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__eyebrow {
    margin: 0 0 0.8rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__label-head h2 {
    margin: 0;
    font-size: 24px;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__lead {
    margin: 0.9rem 0 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: 14px;
    line-height: 1.4;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__body {
    padding: 0 22px 16px;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__rule {
    border-top: 2px solid #071942;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__meta,
  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 14px;
    align-items: start;
    padding: 9px 0;
    border-top: 1px solid rgba(7, 25, 66, 0.12);
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__meta:first-of-type {
    border-top: 0;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__name,
  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__value {
    color: #071942;
    font-size: 14px;
    line-height: 1.4;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__name strong,
  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__value strong {
    font-weight: 800;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__value {
    text-align: right;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison {
    max-width: 960px;
    padding: 20px 22px 22px;
    border: 1px solid rgba(7, 25, 66, 0.10);
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 18px 44px rgba(7, 25, 66, 0.06);
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-head {
    display: grid;
    gap: 8px;
    margin-bottom: 16px;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-title {
    margin: 0;
    color: #071942;
    font-size: 24px;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-copy {
    margin: 0;
    color: rgba(7, 25, 66, 0.72);
    font-size: 14px;
    line-height: 1.45;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-grid {
    display: grid;
    gap: 14px;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-card {
    display: grid;
    gap: 14px;
    padding: 16px;
    border: 1px solid rgba(7, 25, 66, 0.08);
    border-radius: 18px;
    background: #f8fafd;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-media {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 160px;
    border-radius: 16px;
    overflow: hidden;
    background: linear-gradient(180deg, #ffffff 0%, #f2f6fb 100%);
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-body {
    display: grid;
    gap: 8px;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-card h3 {
    margin: 0;
    color: #071942;
    font-size: 18px;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-note,
  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-price {
    margin: 0;
    color: rgba(7, 25, 66, 0.72);
    font-size: 14px;
    line-height: 1.4;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-price {
    color: #071942;
    font-weight: 700;
  }

  .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 46px;
    padding: 0 20px;
    border-radius: 999px;
    background: #071942;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  @media screen and (min-width: 750px) {
    .snoozepod-sleep-facts-{{ section.id }} {
      margin-left: 24px;
      margin-right: 24px;
    }
  }

  @media screen and (min-width: 990px) {
    .snoozepod-sleep-facts-{{ section.id }} {
      margin: 36px auto 40px;
      padding: 0 32px;
      gap: 20px;
    }

    .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__card {
      border-radius: 24px;
    }

    .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__label-head {
      padding: 20px 24px 16px;
    }

    .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__label-head h2 {
      font-size: 26px;
    }

    .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__body {
      padding: 0 24px 18px;
    }

    .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__name,
    .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__value {
      font-size: 14px;
    }

    .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison {
      padding: 24px;
    }

    .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-title {
      font-size: 28px;
    }

    .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-card {
      padding: 18px;
    }

    .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__comparison-media {
      height: 180px;
    }
  }

  @media screen and (max-width: 749px) {
    .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__meta,
    .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__row {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .snoozepod-sleep-facts-{{ section.id }} .snoozepod-sleep-facts__value {
      text-align: left;
    }
  }
{%- endstyle -%}

<section class="section">
  <div class="snoozepod-sleep-facts-{{ section.id }}">
    <div class="snoozepod-sleep-facts__card">
      <div class="snoozepod-sleep-facts__label-head">
        <p class="snoozepod-sleep-facts__eyebrow">Mattress at a glance</p>
        <h2>Benefit table</h2>
        <p class="snoozepod-sleep-facts__lead">Simple comparison points for this mattress before you build the rest of the setup around it.</p>
      </div>

      <div class="snoozepod-sleep-facts__body">
        <div class="snoozepod-sleep-facts__rule"></div>
        <div class="snoozepod-sleep-facts__meta">
          <div class="snoozepod-sleep-facts__name"><strong>Mattress</strong></div>
          <div class="snoozepod-sleep-facts__value">{{ product.title | escape }}</div>
        </div>
        <div class="snoozepod-sleep-facts__rule"></div>

        <div class="snoozepod-sleep-facts__row">
          <div class="snoozepod-sleep-facts__name"><strong>Feel</strong></div>
          <div class="snoozepod-sleep-facts__value">{{ comfort_feel }}</div>
        </div>
        <div class="snoozepod-sleep-facts__row">
          <div class="snoozepod-sleep-facts__name"><strong>Support direction</strong></div>
          <div class="snoozepod-sleep-facts__value">{{ support }}</div>
        </div>
        <div class="snoozepod-sleep-facts__row">
          <div class="snoozepod-sleep-facts__name"><strong>Best match</strong></div>
          <div class="snoozepod-sleep-facts__value">{{ best_for }}</div>
        </div>
        <div class="snoozepod-sleep-facts__row">
          <div class="snoozepod-sleep-facts__name"><strong>Pressure Relief</strong></div>
          <div class="snoozepod-sleep-facts__value">{{ pressure_relief }}</div>
        </div>
        <div class="snoozepod-sleep-facts__row">
          <div class="snoozepod-sleep-facts__name"><strong>Base + motion fit</strong></div>
          <div class="snoozepod-sleep-facts__value" data-sleep-fact-motion>{{ motion_setup }}</div>
        </div>
        <div class="snoozepod-sleep-facts__row">
          <div class="snoozepod-sleep-facts__name"><strong>Partner setup</strong></div>
          <div class="snoozepod-sleep-facts__value">{{ partner_fit }}</div>
        </div>
        <div class="snoozepod-sleep-facts__row">
          <div class="snoozepod-sleep-facts__name"><strong>Showroom compare</strong></div>
          <div class="snoozepod-sleep-facts__value">{{ showroom_test }}</div>
        </div>
      </div>
    </div>

    {%- if compare_product_1 != blank or compare_product_2 != blank or compare_product_3 != blank -%}
      <div class="snoozepod-sleep-facts__comparison">
        <div class="snoozepod-sleep-facts__comparison-head">
          <h2 class="snoozepod-sleep-facts__comparison-title">Compare this with</h2>
          <p class="snoozepod-sleep-facts__comparison-copy">A few nearby mattress options worth checking beside this one.</p>
        </div>

        <div class="snoozepod-sleep-facts__comparison-grid">
          {%- if compare_product_1 != blank -%}
            <article class="snoozepod-sleep-facts__comparison-card">
              <a class="snoozepod-sleep-facts__comparison-media" href="{{ compare_product_1.url }}">
                {%- if compare_product_1.featured_image -%}
                  {{
                    compare_product_1.featured_image
                    | image_url: width: 720
                    | image_tag:
                      widths: '220, 320, 480, 640, 720',
                      sizes: '(min-width: 990px) 280px, 100vw',
                      loading: 'lazy',
                      alt: compare_product_1.featured_image.alt | default: compare_product_1.title
                  }}
                {%- endif -%}
              </a>
              <div class="snoozepod-sleep-facts__comparison-body">
                <h3>{{ compare_product_1.title | escape }}</h3>
                <p class="snoozepod-sleep-facts__comparison-note">{{ compare_copy_1 }}</p>
                <p class="snoozepod-sleep-facts__comparison-price">{{ compare_product_1.selected_or_first_available_variant.price | money }}</p>
                <a class="snoozepod-sleep-facts__comparison-link" href="{{ compare_product_1.url }}">View product</a>
              </div>
            </article>
          {%- endif -%}

          {%- if compare_product_2 != blank -%}
            <article class="snoozepod-sleep-facts__comparison-card">
              <a class="snoozepod-sleep-facts__comparison-media" href="{{ compare_product_2.url }}">
                {%- if compare_product_2.featured_image -%}
                  {{
                    compare_product_2.featured_image
                    | image_url: width: 720
                    | image_tag:
                      widths: '220, 320, 480, 640, 720',
                      sizes: '(min-width: 990px) 280px, 100vw',
                      loading: 'lazy',
                      alt: compare_product_2.featured_image.alt | default: compare_product_2.title
                  }}
                {%- endif -%}
              </a>
              <div class="snoozepod-sleep-facts__comparison-body">
                <h3>{{ compare_product_2.title | escape }}</h3>
                <p class="snoozepod-sleep-facts__comparison-note">{{ compare_copy_2 }}</p>
                <p class="snoozepod-sleep-facts__comparison-price">{{ compare_product_2.selected_or_first_available_variant.price | money }}</p>
                <a class="snoozepod-sleep-facts__comparison-link" href="{{ compare_product_2.url }}">View product</a>
              </div>
            </article>
          {%- endif -%}

          {%- if compare_product_3 != blank -%}
            <article class="snoozepod-sleep-facts__comparison-card">
              <a class="snoozepod-sleep-facts__comparison-media" href="{{ compare_product_3.url }}">
                {%- if compare_product_3.featured_image -%}
                  {{
                    compare_product_3.featured_image
                    | image_url: width: 720
                    | image_tag:
                      widths: '220, 320, 480, 640, 720',
                      sizes: '(min-width: 990px) 280px, 100vw',
                      loading: 'lazy',
                      alt: compare_product_3.featured_image.alt | default: compare_product_3.title
                  }}
                {%- endif -%}
              </a>
              <div class="snoozepod-sleep-facts__comparison-body">
                <h3>{{ compare_product_3.title | escape }}</h3>
                <p class="snoozepod-sleep-facts__comparison-note">{{ compare_copy_3 }}</p>
                <p class="snoozepod-sleep-facts__comparison-price">{{ compare_product_3.selected_or_first_available_variant.price | money }}</p>
                <a class="snoozepod-sleep-facts__comparison-link" href="{{ compare_product_3.url }}">View product</a>
              </div>
            </article>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sleep facts",
  "class": "section",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "Sleep facts"
    }
  ]
}
{% endschema %}
