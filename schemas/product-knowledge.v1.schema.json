{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mysnoozepod.com/schemas/product-knowledge.v1.schema.json",
  "title": "MySnoozePod Product Knowledge Feed",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "source", "products", "bundles"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["system", "store", "rule"],
      "properties": {
        "system": { "const": "Shopify" },
        "store": { "const": "mysnoozepodtest.myshopify.com" },
        "rule": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "products": {
      "type": "array",
      "minItems": 43,
      "items": { "$ref": "#/$defs/product" }
    },
    "bundles": {
      "type": "array",
      "items": { "$ref": "#/$defs/bundle" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "bundle": {
      "type": "object",
      "required": ["id", "name", "category", "contentStatus", "purchaseStatus", "compatibilityStatus", "curationBasis", "showroomRelationship", "components", "sizes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "category": { "enum": ["SLEEP_SYSTEM", "BEDDING_SET", "COMPLETE_SLEEP_PACKAGE"] },
        "contentStatus": { "enum": ["READY_FOR_REVIEW", "APPROVED"] },
        "purchaseStatus": { "enum": ["STAGED_PURCHASABLE", "BLOCKED_COMPATIBILITY"] },
        "compatibilityStatus": { "enum": ["COMPONENT_SIZE_GEOMETRY_VERIFIED", "PENDING_VERIFICATION"] },
        "curationBasis": { "type": "string", "minLength": 1 },
        "showroomRelationship": { "enum": ["PENDING_VERIFICATION", "VERIFIED"] },
        "components": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["shopifyProductId", "handle", "title", "quantity"],
            "properties": {
              "shopifyProductId": { "type": "string", "pattern": "^gid://shopify/Product/[0-9]+$" },
              "handle": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "quantity": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "sizes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "geometry", "minCombinedPrice", "maxCombinedPrice", "componentVariants"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "geometry": { "type": "string", "minLength": 1 },
              "minCombinedPrice": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
              "maxCombinedPrice": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
              "componentVariants": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["shopifyVariantId", "sku", "price"],
                    "properties": {
                      "shopifyVariantId": { "type": "string", "pattern": "^gid://shopify/ProductVariant/[0-9]+$" },
                      "sku": { "type": "string" },
                      "price": { "type": "string" }
                    },
                    "additionalProperties": false
                  }
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "required": ["shopifyProductId", "handle", "title", "categoryContract", "productType", "content", "technical", "commerce", "compatibility", "schemaVersion", "lastUpdated"],
      "properties": {
        "shopifyProductId": { "type": "string", "pattern": "^gid://shopify/Product/[0-9]+$" },
        "handle": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"] },
        "feelLabel": { "enum": ["Plush", "Medium Plush", "Medium Firm", "Firm", null] },
        "categoryContract": { "enum": ["mattress", "adjustable_base", "pillow", "sheets_bedding", "mattress_protection", "comforter_duvet_accessory", "mattress_topper", "bedroom_furniture"] },
        "productType": { "type": "string" },
        "vendor": { "type": "string" },
        "content": {
          "type": "object",
          "required": ["status", "approved", "fields"],
          "properties": {
            "status": { "enum": ["NOT_STARTED", "DRAFT", "READY_FOR_REVIEW", "APPROVED"] },
            "approved": { "type": "boolean" },
            "fields": { "type": "object" }
          },
          "additionalProperties": false
        },
        "technical": {
          "type": "object",
          "required": ["status", "provenance", "fields"],
          "properties": {
            "status": { "enum": ["PENDING", "PARTIAL", "VERIFIED"] },
            "provenance": { "type": ["object", "null"] },
            "fields": { "type": "object" }
          },
          "additionalProperties": false
        },
        "commerce": {
          "type": "object",
          "required": ["authority", "status", "variants"],
          "properties": {
            "authority": { "const": "Shopify live query required" },
            "status": { "enum": ["ACTIVE", "DRAFT", "ARCHIVED"] },
            "variants": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["shopifyVariantId", "sku", "price", "options", "standardizedSize", "shopSizeKeys", "contract"],
                "properties": {
                  "shopifyVariantId": { "type": "string", "pattern": "^gid://shopify/ProductVariant/[0-9]+$" },
                  "sku": { "type": "string" },
                  "price": { "type": "string" },
                  "options": { "type": "object" },
                  "standardizedSize": { "type": ["string", "null"] },
                  "shopSizeKeys": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                  "contract": { "type": "object" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "compatibility": {
          "type": "object",
          "required": ["source", "rule"],
          "properties": {
            "source": { "type": "string" },
            "rule": { "const": "Unknown or missing relationships remain unverified and must not be represented as compatible." }
          },
          "additionalProperties": false
        },
        "schemaVersion": { "const": "1.0.0" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
