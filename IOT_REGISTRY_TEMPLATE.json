    "eventHistoryStore": "DynamoDB Event History",
    "realtime": "API Gateway WebSockets",
    "observability": "CloudWatch"
  },
  "rules": [
    "Template only. Do not create AWS resources from this file without a separate IoT implementation task.",
    "Sensor and edge events must never own Shopify cart truth.",
    "Sensor and edge events must never own checkout truth.",
    "Sensor and edge events must never override Snooze Code or Customer Profile OS identity.",
    "No pressure mapping, wearables, biometrics, environmental controls, or multi-zone audio in MVP."
  ],
  "topicConventions": {
    "telemetry": "mysnoozepod/{storeId}/{zoneId}/{thingName}/telemetry",
    "state": "mysnoozepod/{storeId}/{zoneId}/{thingName}/state",
    "command": "mysnoozepod/{storeId}/{zoneId}/{thingName}/command",
    "health": "mysnoozepod/{storeId}/{zoneId}/{thingName}/health"
  },
