  "dynamoDbTables": {
    "latestState": {
      "tableName": "mysnoozepod-showroom-latest-state",
      "partitionKey": "thingName",
      "sortKey": "stateType",
      "purpose": "Latest known sensor/controller state"
    },
    "eventHistory": {
      "tableName": "mysnoozepod-showroom-event-history",
      "partitionKey": "storeId",
      "sortKey": "timestampThingEvent",
      "purpose": "Append-only event history for diagnostics and analytics"
    }
  },
  "websocket": {
    "apiName": "mysnoozepod-showroom-events",
    "purpose": "Future realtime fanout to approved customer devices",
    "routes": [
      "$connect",
      "$disconnect",
      "subscribeZone",
      "unsubscribeZone"
    ]
  },
  "acceptanceCriteria": [
    "All thing names map to a physical label.",
    "All thing names map to a zone.",
    "All pod sensor things map to the correct pod edge controller.",
    "No IoT thing owns checkout or cart truth.",
    "No deferred capability is represented as MVP-ready."
  ]
